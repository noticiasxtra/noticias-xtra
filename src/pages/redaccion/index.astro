      },

      comentarios() {
        const all: Array<{ t: string; at: number; story: string }> = [];
        try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i)!; if (k.startsWith('nx-comments-')) get<Array<{ text: string; at: number }>>(k, []).forEach((c) => all.push({ t: c.text, at: c.at, story: k.slice(12) })); } } catch { /* storage blocked */ }
        const base = root.dataset.base!.replace(/\/$/, '');
        $('[data-cmts]').innerHTML = all.sort((a, b) => b.at - a.at).slice(0, 15).map((c) => `<li><span>${esc(c.t) || '(sticker o GIF)'}</span><small>${ago(c.at)} · <a href="${c.story.startsWith('juego-') ? `${base}/juegos/${c.story.slice(6)}/` : `${base}/noticia/${c.story}/`}#comentarios">ver</a></small></li>`).join('')
          || '<li class="pnl-muted">Todavía no hay comentarios en este dispositivo. Con las cuentas, aquí verás los de todos los lectores.</li>';
      },

      ingresos() {
        const m = revenue[revenue.length - 2]; const cur = revenue[revenue.length - 1];
        const tot = (r: (typeof revenue)[number]) => r.direct + r.google + r.design;
        const prev = revenue[revenue.length - 3]; const growth = Math.round(((tot(m) - tot(prev)) / tot(prev)) * 100);
        const dayOfMonth = new Date().getDate(); const proj = (tot(cur) / Math.max(1, dayOfMonth)) * 31;
        const fees = Math.round(m.direct * 0.029 + 9 * 0.3);
        $('[data-rev-kpis]').innerHTML = [
          kpi('Septiembre', money(tot(m)), `${growth >= 0 ? '▲' : '▼'} ${Math.abs(growth)}% vs. agosto`),
          kpi('Octubre hasta hoy', money(tot(cur)), `proyección del mes: ${money(proj)}`),
          kpi('Anuncios directos', money(m.direct), `${Math.round((m.direct / tot(m)) * 100)}% de septiembre`),
          kpi('Google (AdSense)', money(m.google), 'llena los espacios sin cliente'),
        ].join('');
        barChart($('[data-rev-chart]'), revenue.map((r, i) => ({ label: r.m, value: tot(r),
          tip: `${r.m}${i === revenue.length - 1 ? ' (en curso)' : ''}: ${money(tot(r))} · directos ${money(r.direct)} · Google ${money(r.google)} · diseño ${money(r.design)}` })), money);
        $('[data-rev-mix]').innerHTML = rows([['Campañas directas', m.direct], ['Google AdSense', m.google], ['Diseño de anuncios', m.design]], money)
          + `<p class="pnl-muted pnl-small">Los anuncios directos siempre salen primero; Google solo llena los espacios vacíos.</p>`;
        const clients: Array<[string, number]> = [['Gomera El Pana', 336], ['Repostería Mari', 244], ['Ferretería Vega Alta', 198], ['Clínica Dental Sonrisa', 172], ['Colmado La Placita', 129]];
        $('[data-rev-clients]').innerHTML = rows(clients, money) + `<p class="pnl-muted pnl-small">Septiembre. <span class="sp-demo">EJEMPLO</span></p>`;
        $('[data-rev-due]').innerHTML = [
          `<li><span>💳 <b>Colmado La Placita</b>: factura de ${money(129)} vence en 3 días (ATH Móvil).</span></li>`,
