            </div>
            <div class="apr-acts">
              <button type="button" class="adp-btn" data-act="approve">Aprobar y publicar</button>
              <button type="button" class="adp-btn ghost-dark" data-act="edit">Editar</button>
              <button type="button" class="apr-reject" data-act="reject">Rechazar</button>
            </div></article>`).join('') || '<p class="apr-empty">🎉 No hay noticias esperando aprobación.</p>';
        } else if (nf === 'check') {
          box.innerHTML = checkList().map((r) => `<article class="pnl-row" data-id="c-${r.id}">
            <div><p class="pnl-muted">${esc(r.section)} · publicada ${ago(Date.parse(r.date))}</p><h2><a href="${r.url}" target="_blank" rel="noopener">${esc(r.title)}</a></h2></div>
            <div class="pnl-row-acts"><button type="button" class="adp-btn ghost-dark" data-act="ok">Se ve bien</button><button type="button" class="apr-reject" data-act="remove">Quitar del sitio</button></div></article>`).join('')
            || '<p class="apr-empty">🎉 Ya le diste un vistazo a todo.</p>';
        } else {
          const label = { approved: 'Aprobada y publicada', rejected: 'Rechazada', ok: 'Revisada: se ve bien', removed: 'Quitada del sitio' };
          const title = (id: string) => DRAFTS.find((d) => d.id === id)?.title ?? RECENT.find((r) => `c-${r.id}` === id)?.title ?? id;
          box.innerHTML = Object.entries(st).sort((a, b) => b[1].at - a[1].at).map(([id, v]) => `<article class="pnl-row"><div><p class="pnl-muted">${label[v.status]} · ${ago(v.at)}</p><h2>${esc(title(id))}</h2></div><div class="pnl-row-acts"><button type="button" class="pnl-link" data-undo="${id}">Deshacer</button></div></article>`).join('')
            || '<p class="apr-empty">Todavía no hay decisiones.</p>';
