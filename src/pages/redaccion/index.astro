---
// Staff panel ("Panel de la redacción"): one login for everything waiting on the newsroom.
// Tabs: Inicio, Noticias (approve, quick look, every published story), Escribir, Fotos (photo library), Ventas, Comentarios,
// Anuncios, Salud del sitio, Equipo. What each person sees depends on their role. Analítica and Ingresos come back when
// Google Analytics and Stripe/ATH are connected.
// Login: Supabase email + password, role from the `staff` table. "Por aprobar" lists the stories reporters sent for
// review (table `articles`) and the automatic news waiting as pull requests in GitHub; Salud reads the real GitHub status.
import Base from '../../layouts/Base.astro';
import AdQueue from '../../components/AdQueue.astro';
import CommentQueue from '../../components/CommentQueue.astro';
import SalesDesk from '../../components/panel/SalesDesk.astro';
import Writer from '../../components/panel/Writer.astro';
import Tasks from '../../components/panel/Tasks.astro';
import PhotoLibrary from '../../components/panel/PhotoLibrary.astro';
import { getStories, url, SECTIONS, SITE } from '../../lib/site';
import { hasBackend } from '../../lib/backend';
import sources from '../../../scripts/sources.json';

const stories = await getStories();
const hasBackendBuild = hasBackend(); // Supabase connected: real accounts and team
// Everything on the site, for Escribir → Publicadas (with views once analytics is connected)
const published = stories.map((s) => ({ id: s.id, title: s.data.title, section: SECTIONS.find((x) => x.id === s.data.section)?.name ?? '', author: s.data.author, date: s.data.date.toISOString(), url: url(`noticia/${s.id}/`), ai: s.data.aiAssisted }));
// The story pinned (📌) in the home page's main spot, for the reminder on Inicio
const pinnedStory = stories.filter((s) => s.data.pinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const pin = pinnedStory ? { title: pinnedStory.data.title, date: pinnedStory.data.date.toISOString(), url: url(`noticia/${pinnedStory.id}`) } : null;
// Stories pinned at the top of each section (newest pin per section), for the same reminder
const sectionPins = SECTIONS.map((sec) => {
  const p = stories.filter((s) => s.data.section === sec.id && s.data.sectionPinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
  return p ? { section: sec.name, title: p.data.title, url: url(`noticia/${p.id}`) } : null;
}).filter(Boolean);
const recent = stories.filter((s) => s.data.section !== 'opinion').slice(0, 12)
  .map((s) => ({ id: s.id, title: s.data.title, section: SECTIONS.find((x) => x.id === s.data.section)?.name ?? '', url: url(`noticia/${s.id}/`), date: s.data.date.toISOString(), author: s.data.author }));
const srcs = (sources as Array<{ name: string; section: string; review?: string; enabled?: boolean }>).filter((s) => s.enabled !== false)
  .map((s) => ({ name: s.name, section: s.section, review: s.review ?? 'always' }));
const TABS = [
  ['inicio', 'Inicio', '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>'],
  ['noticias', 'Noticias', '<path d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5"/>'],
  ['escribir', 'Escribir', '<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>'],
  ['fotos', 'Fotos', '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 8"/>'],
  ['comentarios', 'Comentarios', '<path d="M4 5h16v11H9l-5 4z"/>'],
  ['ventas', 'Ventas', '<path d="M3 7h18l-2 12H5z"/><path d="M8 7a4 4 0 0 1 8 0"/>'],
  ['anuncios', 'Anuncios', '<path d="M3 11v2l13 5V6L3 11z"/><path d="M16 9a3 3 0 0 1 0 6"/>'],
  ['salud', 'Salud del sitio', '<path d="M3 12h4l2-5 4 10 2-5h6"/>'],
  ['equipo', 'Equipo', '<circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4a3.5 3.5 0 0 1 0 7M22 20a7 7 0 0 0-4-6.3"/>'],
];
---
<Base title="Panel de la redacción" description="Panel interno de Noticias Xtra (uso del personal)." noindex staff>
  <main class="wrap pnl" id="main" data-pnl data-secs={JSON.stringify(Object.fromEntries(SECTIONS.map((x) => [x.id, x.name])))} data-pin={JSON.stringify(pin)} data-section-pins={JSON.stringify(sectionPins)} data-recent={JSON.stringify(recent)} data-published={JSON.stringify(published.map(({ id, title, section, author, date, url }) => ({ id, title, section, author, date, url })))} data-sources={JSON.stringify(srcs)} data-base={url()} data-aikey={String(SITE.aiKeyConnected)}>
    <form class="pnl-login" data-login hidden>
      <p class="pnl-kicker">Noticias Xtra</p>
      <h1>Panel de la redacción</h1>
      <p class="pnl-muted">Todo lo que te espera en un solo lugar: noticias por aprobar, comentarios, anuncios, ingresos y analítica.</p>
      {/* With the database: email and password; the role comes from the staff list. Preview: name and role. */}
      <div class="pnl-real" data-real hidden>
        <label for="pnl-mail">Correo</label>
        <input id="pnl-mail" type="email" autocomplete="username" />
        <label for="pnl-pass">Contraseña</label>
        <input id="pnl-pass" type="password" autocomplete="current-password" />
      </div>
      <div class="pnl-prev" data-prevlogin>
      <label for="pnl-name">Tu nombre</label>
      <input id="pnl-name" maxlength="30" autocomplete="name" placeholder="ej. Alfredo" />
      <label for="pnl-role">Rol</label>
      <select id="pnl-role">
        <option value="admin">Administrador: todo</option>
        <option value="editor">Editor: noticias, comentarios y analítica</option>
        <option value="ads">Ventas: clientes, anuncios e ingresos</option>
        <option value="reporter">Periodista: escribir sus noticias</option>
      </select>
      </div>
      <p class="cm-err" data-err hidden></p>
      <button type="submit" class="adp-btn">Entrar</button>
      <p class="pnl-note" data-prevlogin><span class="sp-demo">VISTA PREVIA</span> Sin contraseña por ahora. Con las cuentas, cada persona entra con su correo y su contraseña, y su rol lo asigna el administrador.</p>
    </form>

    <div class="pnl-app" data-pnl-app hidden>
      <aside class="pnl-side">
        <div class="pnl-me"><span class="pnl-av" data-av></span><span><b data-me></b><small data-role></small></span></div>
        <nav class="pnl-nav" aria-label="Secciones del panel">
          {TABS.map(([id, name, d]) => (
            <button type="button" data-tab={id} aria-current="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={d} /></svg>
              <span>{name}</span><b class="pnl-n" data-count={id}></b>
            </button>
          ))}
        </nav>
        <button type="button" class="pnl-out" data-logout>Salir</button>
      </aside>

      <div class="pnl-main">

        <!-- Inicio -->
        <section class="pnl-pane" data-pane="inicio">
          <h1 class="pnl-h">Buenos días, <span data-me></span></h1>
          <p class="pnl-muted" data-today></p>
          <div class="pnl-kpis" data-kpis></div>
          <h2 class="pnl-h2">Lo que te espera</h2>
          <ul class="pnl-todo" data-todo></ul>
          <Tasks />
        </section>

        <!-- Noticias -->
        <section class="pnl-pane" data-pane="noticias" hidden>
          <h1 class="pnl-h">Noticias</h1>
          <p class="pnl-muted">Aprueba lo que espera por ti, dale un vistazo a lo último que salió y busca cualquier noticia publicada para corregirla o quitarla.</p>
          <nav class="apn-tabs pnl-sub" role="tablist" aria-label="Noticias">
            <button type="button" role="tab" aria-selected="true" data-nf="pending">Por aprobar <b data-nn="pending"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="check">Vistazo rápido <b data-nn="check"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="done">Resueltas <b data-nn="done"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="pub">Publicadas <b data-nn="pub"></b></button>
          </nav>
          <div class="pnl-list" data-news></div>
        </section>

        <!-- Escribir -->
        <section class="pnl-pane" data-pane="escribir" hidden>
          <Writer recent={recent.map(({ id, title }) => ({ id, title }))} published={published} />
        </section>

        <!-- Fotos -->
        <section class="pnl-pane" data-pane="fotos" hidden>
          <PhotoLibrary />
        </section>

        <!-- Ventas -->
        <section class="pnl-pane" data-pane="ventas" hidden>
          <SalesDesk />
        </section>

        <!-- Comentarios -->
        <section class="pnl-pane" data-pane="comentarios" hidden>
          <CommentQueue embedded />
        </section>

        <!-- Anuncios -->
        <section class="pnl-pane" data-pane="anuncios" hidden>
          <AdQueue embedded />
        </section>

        <!-- Salud -->
        <section class="pnl-pane" data-pane="salud" hidden>
          <h1 class="pnl-h">Salud del sitio</h1>
          <p class="pnl-muted">Estado real, tomado de GitHub en este momento.</p>
          <div class="pnl-kpis" data-health></div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Cuentas y conexiones</h2><ul class="pnl-checks" data-accounts></ul></div>
            <div class="pnl-card"><h2 class="pnl-h3">Fuentes de noticias <small data-src-n></small></h2><ul class="pnl-srcs" data-srcs></ul></div>
          </div>
        </section>

        <!-- Equipo -->
        <section class="pnl-pane" data-pane="equipo" hidden>
          <h1 class="pnl-h">Equipo</h1>
          <p class="pnl-muted">Quién entra al panel y qué puede hacer.</p>
          {hasBackendBuild && <p class="pnl-muted pnl-small">Para añadir a alguien: primero crea su cuenta en el sitio (Entrar → Crear cuenta). Luego escribe aquí su nombre, su correo o @usuario y su rol. Entra al panel con ese mismo correo y contraseña.</p>}
          <ul class="pnl-team" data-team></ul>
          <form class="pnl-add" data-add novalidate>
            <input placeholder="Nombre" data-add-name maxlength="30" aria-label="Nombre" />
            <input placeholder="Correo o @usuario" data-add-mail maxlength="60" aria-label="Correo o nombre de usuario" autocapitalize="off" />
            <select data-add-role aria-label="Rol"><option value="editor">Editor</option><option value="ads">Ventas</option><option value="reporter">Periodista</option><option value="admin">Administrador</option></select>
            <button type="submit" class="adp-btn">Añadir</button>
          </form>
          <h2 class="pnl-h2">Qué puede hacer cada rol</h2>
          <div class="pnl-tablewrap" data-perms></div>
        </section>
      </div>
    </div>
    <div class="apn-toast" data-ptoast role="status" hidden></div>
  </main>

  <script>
    import { ask, askText } from '../../lib/dialogs';
    import { getReports } from '../../lib/moderation';
    import { listRequests, loadRequests } from '../../lib/adrequests';
    import { hasBackend, staffApi, staffLogin, staffLogout, staffProfile, syncTeam, addToTeam, removeFromTeam } from '../../lib/backend';
    const root = document.querySelector<HTMLElement>('[data-pnl]')!;
    const RECENT: Array<{ id: string; title: string; section: string; url: string; date: string; author: string }> = JSON.parse(root.dataset.recent!);
    const SOURCES: Array<{ name: string; section: string; review: string }> = JSON.parse(root.dataset.sources!);
    const PIN: { title: string; date: string; url: string } | null = JSON.parse(root.dataset.pin || 'null');
    const SECTION_PINS: Array<{ section: string; title: string; url: string }> = JSON.parse(root.dataset.sectionPins || '[]');
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const get = <T,>(k: string, d: T): T => { try { return JSON.parse(localStorage.getItem(k) || 'null') ?? d; } catch { return d; } };
    const set = (k: string, v: unknown) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, JSON.stringify(v)); } catch { /* storage blocked */ } };
    const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
    const num = (n: number) => Math.round(n).toLocaleString('es-PR');
    const ago = (t: number) => { const m = Math.round((Date.now() - t) / 60000); return m < 60 ? `hace ${Math.max(1, m)} min` : m < 1440 ? `hace ${Math.round(m / 60)} h` : `hace ${Math.round(m / 1440)} d`; };
    const toast = (m: string) => { const t = $('[data-ptoast]'); t.textContent = m; t.hidden = false; clearTimeout((t as any).tm); (t as any).tm = setTimeout(() => (t.hidden = true), 3800); };

    // ---------- login + roles ----------
    type Staff = { name: string; role: 'admin' | 'editor' | 'ads' | 'reporter' };
    const ROLE_NAME = { admin: 'Administrador', editor: 'Editor', ads: 'Ventas', reporter: 'Periodista' };
    const ROLE_TABS: Record<Staff['role'], string[]> = {
      admin: ['inicio', 'noticias', 'escribir', 'fotos', 'ventas', 'comentarios', 'anuncios', 'salud', 'equipo'],
      editor: ['inicio', 'noticias', 'escribir', 'fotos', 'comentarios', 'salud'],
      ads: ['inicio', 'ventas', 'anuncios', 'comentarios'],
      reporter: ['inicio', 'escribir', 'fotos'],
    };
    const me = () => get<Staff | null>('nx-staff', null);

    type NewsState = Record<string, { status: 'approved' | 'returned' | 'ok' | 'removed'; title?: string; at: number }>;
    const news = () => get<NewsState>('nx-panel-news', {});
    const setNews = (id: string, v: NewsState[string]) => { set('nx-panel-news', { ...news(), [id]: v }); };
    const checkList = () => RECENT.slice(0, 6).filter((r) => !news()[`c-${r.id}`]);

    // ---------- real work waiting: stories sent for review (Supabase), automatic news (GitHub), reported comments ----------
    type Rev = { id: string; updated_at: string; doc: { title?: string; author?: string; owner?: string; section?: string; date?: string } };
    type Pr = { number: number; title: string; html_url: string; created_at: string };
    const LIVE: { review: Rev[]; prs: Pr[]; comments: number; at: number } = { review: [], prs: [], comments: 0, at: 0 };
    async function loadLive(force = false) {
      if (!force && Date.now() - LIVE.at < 30000) return; LIVE.at = Date.now();
      const [rv, cm, pr] = await Promise.all([
        staffApi('articles?status=eq.review&select=id,updated_at,doc&order=updated_at.desc'),
        staffApi('comments?status=eq.review&select=id', { headers: { Prefer: 'count=exact' } }),
        fetch('https://api.github.com/repos/noticiasxtra/noticias-xtra/pulls?state=open&per_page=30').then((r) => (r.ok ? r.json() : [])).catch(() => []),
      ]);
      if (rv?.ok) LIVE.review = await rv.json();
      if (cm?.ok) LIVE.comments = Number(cm.headers.get('content-range')?.split('/')[1]) || 0;
      LIVE.prs = Array.isArray(pr) ? pr : [];
      paintCounts(); if (tab === 'inicio' || tab === 'noticias') paint[tab]?.();
    }
    addEventListener('nx-articles-changed', () => void loadLive(true));
    const SEC_NAME: Record<string, string> = JSON.parse(root.dataset.secs || '{}');

    const kpi = (label: string, value: string, sub = '', tab = '', tone = '') => `<${tab ? 'button type="button" data-go="' + tab + '"' : 'div'} class="pnl-kpi ${tone}"><span>${label}</span><b>${value}</b>${sub ? `<small>${sub}</small>` : ''}</${tab ? 'button' : 'div'}>`;

    // ---------- counts ----------
    const counts = () => {
      const rep = hasBackend() ? LIVE.comments : getReports().filter((r) => r.status === 'review').length;
      const ads = listRequests().filter((r) => r.status === 'revisar' || r.status === 'disenar').length;
      const td = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
      const leads = get<Array<{ stage: string; follow: string }>>('nx-leads', []).filter((l) => !['won', 'lost'].includes(l.stage) && l.follow && l.follow <= td).length;
      const review = LIVE.review.length; const pending = review + LIVE.prs.length;
      return { noticias: pending + checkList().length, pending, check: checkList().length, comentarios: rep, anuncios: ads, ventas: leads, escribir: review };
    };

    // ---------- tabs ----------
    let tab = 'inicio';
    function showTab(t: string) {
      const s = me(); if (!s) return;
      const allowed = ROLE_TABS[s.role];
      if (!allowed.includes(t)) t = 'inicio';
      tab = t;
      $$('[data-tab]').forEach((b) => { b.hidden = !allowed.includes(b.dataset.tab!); b.setAttribute('aria-current', String(b.dataset.tab === t)); });
      $$('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== t));
      const nav = $('.pnl-nav'), cur = $(`[data-tab="${t}"]`); // phones: keep the current tab visible in the scrolling bar
      if (nav.scrollWidth > nav.clientWidth) nav.scrollLeft = cur.offsetLeft - nav.clientWidth / 2 + cur.offsetWidth / 2;
      if (location.hash.slice(1) !== t) history.replaceState(null, '', `#${t}`);
      paint[t]?.();
      if (hasBackend() && (t === 'inicio' || t === 'noticias')) void loadLive();
    }
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-tab],[data-go]');
      if (b) { showTab(b.dataset.tab || b.dataset.go!); scrollTo({ top: 0, behavior: 'smooth' }); }
    });
    addEventListener('hashchange', () => showTab(location.hash.slice(1)));
    addEventListener('nx-leads', () => paintCounts());
    addEventListener('nx-tasks', () => { if (tab === 'inicio') paint.inicio(); });
    root.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-tk-scroll]')) document.querySelector('[data-tk]')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });

    function paintCounts() {
      const c = counts();
      (Object.entries({ noticias: c.noticias, comentarios: c.comentarios, anuncios: c.anuncios, ventas: c.ventas, escribir: c.escribir }) as Array<[string, number]>)
        .forEach(([k, n]) => { const el = $(`[data-count="${k}"]`); el.textContent = n ? String(n) : ''; });
      const r = me()?.role ?? 'admin'; const mine = ROLE_TABS[r as Staff['role']];
      set('nx-staff-pending', (['noticias', 'comentarios', 'anuncios', 'ventas'] as const).filter((k) => mine.includes(k)).reduce((a, k) => a + c[k], 0)); // profile menu badge (stories in review are counted in Noticias)
      dispatchEvent(new Event('nx-staff-change'));
    }

    // ---------- panes ----------
    const paint: Record<string, () => void> = {
      inicio() {
        const s = me()!; const c = counts(); const allowed = ROLE_TABS[s.role];
        const h = new Date().getHours(); $$('[data-me]').forEach((e) => (e.textContent = s.name));
        $('.pnl-h', $('[data-pane="inicio"]')).firstChild!.textContent = h < 12 ? 'Buenos días, ' : h < 19 ? 'Buenas tardes, ' : 'Buenas noches, ';
        $('[data-today]').textContent = new Date().toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Puerto_Rico' });
        $('[data-kpis]').innerHTML = [
          allowed.includes('noticias') && kpi('Noticias por aprobar', String(c.pending), `${c.check} para vistazo rápido`, 'noticias', c.pending ? 'warn' : ''),
          allowed.includes('comentarios') && kpi('Comentarios por revisar', String(c.comentarios), 'reportados por lectores', 'comentarios', c.comentarios ? 'warn' : ''),
          allowed.includes('anuncios') && kpi('Anuncios por aprobar', String(c.anuncios), 'respuesta en 24 horas', 'anuncios', c.anuncios ? 'warn' : ''),
          s.role === 'reporter' && kpi('Mis noticias en revisión', String(LIVE.review.filter((r) => r.doc.owner === s.name).length), 'esperan por un editor', 'escribir'),
        ].filter(Boolean).join('');
        const todo: string[] = [];
        // Team tasks (Tareas, below): mine that are late or due today
        const td = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
        const myTasks = get<Array<{ owner: string; mates: string[]; status: string; due: string }>>('nx-tasks', []).filter((t) => t.status !== 'done' && (t.owner === s.name || t.mates.includes(s.name)));
        const lateT = myTasks.filter((t) => t.due && t.due < td).length, todayT = myTasks.filter((t) => t.due === td).length;
        if (lateT) todo.push(`<li><span>⏰ <b>${lateT}</b> ${lateT === 1 ? 'tarea atrasada' : 'tareas atrasadas'}.</span><button type="button" data-tk-scroll>Ver</button></li>`);
        if (todayT) todo.push(`<li><span>📌 <b>${todayT}</b> ${todayT === 1 ? 'tarea vence' : 'tareas vencen'} hoy.</span><button type="button" data-tk-scroll>Ver</button></li>`);
        if (PIN && ['admin', 'editor'].includes(s.role)) todo.push(`<li><span>📌 <b>${esc(PIN.title)}</b> está fijada arriba en la Portada (publicada ${ago(Date.parse(PIN.date))}). Para quitarla: ábrela en Escribir y desmarca 📌.</span><a href="${PIN.url}" target="_blank" rel="noopener">Ver</a></li>`);
        if (['admin', 'editor'].includes(s.role)) SECTION_PINS.forEach((p) => todo.push(`<li><span>📌 En <b>${esc(p.section)}</b>, “${esc(p.title)}” está fijada arriba de la sección.</span><a href="${p.url}" target="_blank" rel="noopener">Ver</a></li>`));
        if (allowed.includes('noticias') && c.pending) todo.push(`<li><span>📰 <b>${c.pending}</b> ${c.pending === 1 ? 'noticia espera' : 'noticias esperan'} tu aprobación.</span><button type="button" data-go="noticias">Revisar</button></li>`);
        if (allowed.includes('noticias') && c.check) todo.push(`<li><span>👀 <b>${c.check}</b> publicadas para un vistazo rápido.</span><button type="button" data-go="noticias">Ver</button></li>`);
        if (allowed.includes('ventas') && c.ventas) todo.push(`<li><span>📞 <b>${c.ventas}</b> ${c.ventas === 1 ? 'cliente espera' : 'clientes esperan'} seguimiento hoy.</span><button type="button" data-go="ventas">Ver</button></li>`);
        if (s.role === 'reporter') todo.push(`<li><span>✍️ Escribe una noticia nueva o sigue un borrador.</span><button type="button" data-go="escribir">Escribir</button></li>`);
        if (allowed.includes('comentarios') && c.comentarios) todo.push(`<li><span>💬 <b>${c.comentarios}</b> ${c.comentarios === 1 ? 'comentario reportado' : 'comentarios reportados'} por revisar.</span><button type="button" data-go="comentarios">Revisar</button></li>`);
        if (allowed.includes('anuncios') && c.anuncios) todo.push(`<li><span>📣 <b>${c.anuncios}</b> ${c.anuncios === 1 ? 'anuncio espera' : 'anuncios esperan'}. Prometimos responder en 24 horas.</span><button type="button" data-go="anuncios">Abrir</button></li>`);
        if (s.role === 'admin' && root.dataset.aikey !== 'true') todo.push(`<li><span>🔑 Falta conectar la clave de Anthropic: el redactor automático todavía no redacta noticias.</span><button type="button" data-go="salud">Detalles</button></li>`);
        $('[data-todo]').innerHTML = todo.join('') || '<li><span>🎉 No hay nada pendiente.</span></li>';
      },

      noticias() {
        const c = counts(); const st = news();
        $('[data-nn="pending"]').textContent = c.pending ? String(c.pending) : '';
        $('[data-nn="check"]').textContent = c.check ? String(c.check) : '';
        $('[data-nn="pub"]').textContent = String(PUBLISHED.length);
        const done = Object.keys(st).length; $('[data-nn="done"]').textContent = done ? String(done) : '';
        const box = $('[data-news]');
        if (nf === 'pending') {
          const canApprove = ['admin', 'editor'].includes(me()?.role ?? '');
          const revs = LIVE.review.map((r) => `<article class="pnl-row" data-rev="${esc(r.id)}">
            <div><p class="pnl-muted">✍️ Escrita por <b>${esc(r.doc.author || r.doc.owner || 'Periodista')}</b> · ${esc(SEC_NAME[r.doc.section || ''] ?? '')} · enviada ${ago(Date.parse(r.updated_at))}${r.doc.date && Date.parse(r.doc.date) > Date.now() ? ` · <b>programada para el ${new Date(r.doc.date).toLocaleString('es-PR', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' })}</b>` : ''}</p><h2>${esc(r.doc.title || 'Sin titular')}</h2></div>
            <div class="pnl-row-acts">${canApprove ? '<button type="button" class="adp-btn" data-rv="approve">Aprobar y publicar</button>' : ''}<button type="button" class="adp-btn ghost-dark" data-rv="open">Revisar en Escribir</button>${canApprove ? '<button type="button" class="pnl-link" data-rv="return">Devolver</button>' : ''}</div></article>`).join('');
          const prs = LIVE.prs.map((p) => `<article class="pnl-row"><div><p class="pnl-muted">✍️ Redactada por <b>NX</b> (automático) · ${ago(Date.parse(p.created_at))}</p><h2>${esc(p.title)}</h2></div>
            <div class="pnl-row-acts"><a class="adp-btn ghost-dark" href="${p.html_url}" target="_blank" rel="noopener">Revisar y aprobar en GitHub ↗</a></div></article>`).join('');
          box.innerHTML = (revs ? `<h2 class="pnl-h3">De periodistas</h2>${revs}` : '') + (prs ? `<h2 class="pnl-h3">Del redactor automático</h2>${prs}` : '')
            || '<p class="apr-empty">🎉 No hay noticias esperando aprobación.</p>';
        } else if (nf === 'check') {
          box.innerHTML = checkList().map((r) => `<article class="pnl-row" data-id="c-${r.id}">
            <div><p class="pnl-muted">✍️ Escrita por <b>${esc(r.author || 'Noticias Xtra')}</b> · ${esc(r.section)} · publicada ${ago(Date.parse(r.date))}</p><h2><a href="${r.url}" target="_blank" rel="noopener">${esc(r.title)}</a></h2></div>
            <div class="pnl-row-acts"><button type="button" class="adp-btn ghost-dark" data-act="ok">Se ve bien</button><button type="button" class="adp-btn ghost-dark" data-act="editpub">Editar</button><button type="button" class="apr-reject" data-act="remove">Quitar del sitio</button></div></article>`).join('')
            || '<p class="apr-empty">🎉 Ya le diste un vistazo a todo.</p>';
        } else if (nf === 'pub') {
          // Every story on the site: search, edit in Escribir, see it, or take it down
          box.innerHTML = `<input type="search" class="pl-q pnl-pub-q" data-pub-q placeholder="Buscar en las ${PUBLISHED.length} noticias publicadas…" aria-label="Buscar noticias publicadas" value="${esc(pubQ)}" /><div data-pub-list></div>`;
          paintPub();
          $<HTMLInputElement>('[data-pub-q]', box).addEventListener('input', (e) => { pubQ = (e.target as HTMLInputElement).value; paintPub(); });
        } else {
          const label: Record<string, string> = { approved: 'Aprobada y publicada', returned: 'Devuelta al periodista', rejected: 'Rechazada', ok: 'Revisada: se ve bien', removed: 'Quitada del sitio' };
          const title = (id: string) => st[id]?.title ?? RECENT.find((r) => `c-${r.id}` === id)?.title ?? PUBLISHED.find((p) => `c-${p.id}` === id)?.title ?? id;
          box.innerHTML = Object.entries(st).sort((a, b) => b[1].at - a[1].at).map(([id, v]) => `<article class="pnl-row"><div><p class="pnl-muted">${label[v.status]} · ${ago(v.at)}</p><h2>${esc(title(id))}</h2></div><div class="pnl-row-acts"><button type="button" class="pnl-link" data-undo="${id}">Deshacer</button></div></article>`).join('')
            || '<p class="apr-empty">Todavía no hay decisiones.</p>';
        }
      },

      async salud() {
        const box = $('[data-health]');
        box.innerHTML = kpi('Actualización del sitio', 'Cargando…') + kpi('Redactor de noticias (IA)', 'Cargando…');
        const api = 'https://api.github.com/repos/noticiasxtra/noticias-xtra';
        try {
          const [dep, ai, prs, iss] = await Promise.all([
            fetch(`${api}/actions/workflows/deploy.yml/runs?per_page=1`).then((r) => r.json()),
            fetch(`${api}/actions/workflows/daily-news.yml/runs?per_page=1`).then((r) => r.json()),
            fetch(`${api}/pulls?state=open&per_page=50`).then((r) => r.json()),
            fetch(`${api}/issues?state=open&per_page=50`).then((r) => r.json()),
          ]);
          const run = (x: any) => x?.workflow_runs?.[0];
          const d = run(dep), a = run(ai);
          const state = (r: any) => (!r ? ['Sin datos', ''] : r.status !== 'completed' ? ['Trabajando ahora', ''] : r.conclusion === 'success' ? ['Funciona ✓', 'good'] : ['Falló ✗', 'bad']);
          const [ds, dt] = state(d); let [as, at] = state(a);
          if (root.dataset.aikey !== 'true' && at === 'good') [as, at] = ['Sin clave ⚠', 'bad']; // runs, but writes nothing yet
          const openPrs = Array.isArray(prs) ? prs.length : 0; const checks = Array.isArray(iss) ? iss.filter((i: any) => !i.pull_request && /Vistazo/.test(i.title)).length : 0;
          box.innerHTML = [
            kpi('Actualización del sitio', ds, d ? `cada 15 minutos · última ${ago(Date.parse(d.updated_at))}` : '', '', dt),
            kpi('Redactor de noticias (IA)', as, root.dataset.aikey !== 'true' ? 'corre a las 7 a.m. y 5 p.m., pero no redacta hasta conectar la clave' : a ? `7 a.m. y 5 p.m. · última ${ago(Date.parse(a.updated_at))}` : '', '', at),
            kpi('Esperan aprobación en GitHub', String(openPrs), 'noticias reales por aprobar'),
            kpi('Vistazos rápidos abiertos', String(checks), 'avisos en GitHub'),
          ].join('');
        } catch { box.innerHTML = kpi('Estado', 'No se pudo consultar GitHub', 'intenta en unos minutos', '', 'bad'); }
        const acc: Array<[string, boolean, string]> = [
          ['Sitio publicado en noticiasxtra.com', true, 'GitHub Pages + Cloudflare, con clave de acceso hasta el lanzamiento'], ['Actualización cada 15 minutos', true, 'listo'],
          ['Cuentas, comentarios y este panel (Supabase)', true, 'listo'], ['Entrar con Google', true, 'listo'], ['Google Search Console', true, 'sitio verificado'],
          ['Clave de Anthropic', root.dataset.aikey === 'true', 'el redactor automático no redacta hasta conectarla'],
          ['Google Analytics', false, 'visitantes reales (vuelve la pestaña Analítica)'], ['Stripe y ATH Móvil', false, 'cobros de anuncios (vuelve la pestaña Ingresos)'],
          ['Google Ad Manager / AdSense', false, 'anuncios de Google'], ['Correos @noticiasxtra.com', false, 'redacción, ventas y correos de las cuentas'],
          ['Datos deportivos', false, 'marcadores'], ['EFE o AP', false, 'noticias de agencia'],
        ];
        $('[data-accounts]').innerHTML = acc.map(([n, ok, why]) => `<li class="${ok ? 'ok' : ''}"><span>${ok ? '✓' : '○'} ${n}</span><small>${why}</small></li>`).join('');
        const lv: Record<string, [string, string]> = { auto: ['Se publica sola', 'g'], check: ['Se publica + vistazo', 'y'], always: ['Espera aprobación', 'r'] };
        $('[data-src-n]').textContent = `${SOURCES.length} fuentes oficiales`;
        $('[data-srcs]').innerHTML = SOURCES.map((s) => `<li><span>${esc(s.name)}</span><span class="pnl-lv ${lv[s.review]?.[1] ?? 'r'}">${lv[s.review]?.[0] ?? 'Espera aprobación'}</span></li>`).join('');
      },

      equipo() {
        const s = me()!;
        const team = get<Array<{ id?: string; name: string; mail: string; role: Staff['role'] }>>('nx-staff-team', [
          { name: s.name, mail: 'tú', role: 'admin' }, { name: 'Editora (ejemplo)', mail: 'editora@ejemplo.com', role: 'editor' },
          { name: 'Ventas (ejemplo)', mail: 'ventas@ejemplo.com', role: 'ads' }, { name: 'Periodista (ejemplo)', mail: 'periodista@ejemplo.com', role: 'reporter' },
        ]);
        $('[data-team]').innerHTML = team.map((m, i) => `<li><span class="pnl-av sm">${esc(m.name[0]?.toUpperCase() ?? '?')}</span><span><b>${esc(m.name)}</b><small>${esc(m.mail)}</small></span><span class="pnl-tag">${ROLE_NAME[m.role]}</span>${i ? `<button type="button" class="pnl-link" data-rm="${i}">Quitar</button>` : ''}</li>`).join('');
        const can: Array<[string, boolean[]]> = [
          ['Aprobar noticias', [true, true, false, false]], ['Escribir noticias', [true, true, false, true]], ['Publicar o programar', [true, true, false, false]],
          ['Clientes y propuestas', [true, false, true, false]], ['Moderar comentarios', [true, true, true, false]],
          ['Aprobar anuncios', [true, false, true, false]], ['Ver ingresos', [true, false, true, false]], ['Ver analítica', [true, true, false, false]],
          ['Salud del sitio', [true, true, false, false]], ['Manejar el equipo', [true, false, false, false]],
        ];
        $('[data-perms]').innerHTML = `<table class="pnl-table perms"><thead><tr><th></th><th>Admin</th><th>Editor</th><th>Ventas</th><th>Periodista</th></tr></thead><tbody>${can.map(([k, v]) => `<tr><th scope="row">${k}</th>${v.map((x) => `<td>${x ? '✓' : '—'}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
      },
    };

    // ---------- actions ----------
    let nf = 'pending';
    // ---------- Noticias → Publicadas: every story on the site ----------
    const PUBLISHED: Array<{ id: string; title: string; section: string; author: string; date: string; url: string }> = JSON.parse(root.dataset.published || '[]');
    let pubQ = ''; const takenDown = new Set<string>();
    const plainTxt = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    function paintPub() {
      const words = plainTxt(pubQ.trim()).split(/\s+/).filter(Boolean);
      const rows = PUBLISHED.filter((p) => words.every((w) => plainTxt(`${p.title} ${p.section} ${p.author}`).includes(w))).slice(0, 60);
      const canEdit = ['admin', 'editor'].includes(me()?.role ?? '');
      $('[data-pub-list]').innerHTML = rows.map((p) => `<article class="pnl-row" data-pub="${esc(p.id)}">
        <div><p class="pnl-muted">✍️ Escrita por <b>${esc(p.author || 'Noticias Xtra')}</b> · ${esc(p.section)} · ${new Date(p.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}${takenDown.has(p.id) ? ' · <b class="pnl-down">Quitada: desaparece en unos minutos</b>' : ''}</p>
          <h2><a href="${p.url}" target="_blank" rel="noopener">${esc(p.title)}</a></h2></div>
        <div class="pnl-row-acts"><button type="button" class="adp-btn ghost-dark" data-pub-edit>Editar</button><a class="adp-btn ghost-dark" href="${p.url}" target="_blank" rel="noopener">Ver en el sitio ↗</a>${canEdit && !takenDown.has(p.id) ? '<button type="button" class="apr-reject" data-pub-down>Quitar del sitio</button>' : ''}</div></article>`).join('')
        || `<p class="apr-empty">No encontramos noticias con “${esc(pubQ)}”.</p>`;
    }
    addEventListener('nx-takedown-done', (e) => { const d = (e as CustomEvent).detail as { id: string; ok: boolean }; if (d.ok) { takenDown.add(d.id); if (nf === 'pub') paintPub(); } });
    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement; const row = t.closest<HTMLElement>('[data-pub]'); if (!row) return;
      const p = PUBLISHED.find((x) => x.id === row.dataset.pub); if (!p) return;
      if (t.closest('[data-pub-edit]')) { dispatchEvent(new CustomEvent('nx-edit-story', { detail: { id: p.id } })); showTab('escribir'); scrollTo({ top: 0 }); }
      if (t.closest('[data-pub-down]')) {
        if (!(await ask(`¿Quitar “${p.title}” del sitio? Desaparece en unos 2 minutos. Quedará en Escribir → Borradores para corregirla y publicarla otra vez.`, { ok: 'Quitar del sitio', danger: true }))) return;
        (t as HTMLButtonElement).disabled = true; (t as HTMLButtonElement).textContent = 'Quitando…';
        dispatchEvent(new CustomEvent('nx-takedown', { detail: { id: p.id } }));
      }
    });
    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const sub = t.closest<HTMLElement>('[data-nf]');
      if (sub) { nf = sub.dataset.nf!; $$('[data-nf]').forEach((b) => b.setAttribute('aria-selected', String(b === sub))); paint.noticias(); return; }
      const undo = t.closest<HTMLElement>('[data-undo]');
      if (undo) { const st = news(); delete st[undo.dataset.undo!]; set('nx-panel-news', st); paint.noticias(); paintCounts(); return; }
      const rng = t.closest<HTMLElement>('[data-range]');
      if (rng) { $$('[data-range]').forEach((b) => b.setAttribute('aria-pressed', String(b === rng))); paint.analitica(); return; }
      const rm = t.closest<HTMLElement>('[data-rm]');
      if (rm) {
        if (hasBackend()) {
          const m = get<Array<{ id?: string; name: string }>>('nx-staff-team', [])[Number(rm.dataset.rm)];
          if (!m?.id || !(await ask(`¿Quitar a ${m.name} del equipo? Ya no podrá entrar al panel (su cuenta de lector sigue).`, { ok: 'Quitar', danger: true }))) return;
          if (await removeFromTeam(m.id)) { await syncTeam(); paint.equipo(); dispatchEvent(new Event('nx-team')); toast(`${m.name} ya no está en el equipo.`); } else toast('No se pudo. Solo el administrador puede quitar personas.');
          return;
        }
        const team = get<unknown[]>('nx-staff-team', []); team.splice(Number(rm.dataset.rm), 1); set('nx-staff-team', team); paint.equipo(); return;
      }
      const rv = t.closest<HTMLElement>('[data-rv]');
      if (rv) {
        const row = rv.closest<HTMLElement>('[data-rev]')!; const id = row.dataset.rev!; const r = LIVE.review.find((x) => x.id === id);
        if (rv.dataset.rv === 'open') { dispatchEvent(new CustomEvent('nx-open-article', { detail: { id } })); showTab('escribir'); scrollTo({ top: 0 }); return; }
        if (rv.dataset.rv === 'approve') {
          if (!(await ask(`¿Aprobar y publicar “${r?.doc.title || 'esta noticia'}”? ${r?.doc.date && Date.parse(r.doc.date) > Date.now() ? 'Saldrá sola a la hora programada.' : 'Aparece en el sitio en unos 2 minutos.'}`, { ok: 'Aprobar y publicar' }))) return;
          (rv as HTMLButtonElement).disabled = true; (rv as HTMLButtonElement).textContent = 'Publicando…';
          dispatchEvent(new CustomEvent('nx-approve-article', { detail: { id } }));
          setNews(`a-${id}`, { status: 'approved', title: r?.doc.title, at: Date.now() }); return;
        }
        if (rv.dataset.rv === 'return') {
          const n = await askText('¿Qué debe corregir el periodista?', { placeholder: 'ej. Falta la fuente oficial del dato.', ok: 'Devolver', multiline: true }); if (n === null) return;
          dispatchEvent(new CustomEvent('nx-return-article', { detail: { id, note: n } }));
          setNews(`a-${id}`, { status: 'returned', title: r?.doc.title, at: Date.now() }); return;
        }
      }
      const act = t.closest<HTMLElement>('[data-act]'); const card = t.closest<HTMLElement>('.pnl-draft,.pnl-row');
      if (!act || !card || !card.closest('[data-news]')) return;
      const id = card.dataset.id!; const a = act.dataset.act;
      if (a === 'editpub') { // a published story (Vistazo rápido) opens in Escribir to correct and update it
        dispatchEvent(new CustomEvent('nx-edit-story', { detail: { id: id.replace(/^c-/, '') } }));
        showTab('escribir'); scrollTo({ top: 0 });
        return;
      }
      if (a === 'ok') { setNews(id, { status: 'ok', at: Date.now() }); toast('Marcada como revisada.'); }
      if (a === 'remove') {
        if (!(await ask('¿Quitar esta noticia del sitio? Desaparece en unos 2 minutos. Quedará en Escribir → Borradores para corregirla y publicarla otra vez.', { ok: 'Quitar del sitio', danger: true }))) return;
        dispatchEvent(new CustomEvent('nx-takedown', { detail: { id: id.replace(/^c-/, '') } }));
        setNews(id, { status: 'removed', at: Date.now() });
      }
      card.classList.add('pnl-gone'); setTimeout(() => { paint.noticias(); paintCounts(); }, 250);
    });
    $<HTMLFormElement>('[data-add]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $<HTMLInputElement>('[data-add-name]').value.trim(), mail = $<HTMLInputElement>('[data-add-mail]').value.trim();
      if (hasBackend()) {
        // Real team: the person signs up on the site first; here the admin gives them a role by @username or email
        if (name.length < 2 || mail.length < 3) { toast('Escribe el nombre y su @usuario o correo.'); return; }
        const res = await addToTeam(mail, name, $<HTMLSelectElement>('[data-add-role]').value);
        if (res !== 'ok') { toast(res); return; }
        (e.target as HTMLFormElement).reset(); await syncTeam(); paint.equipo(); dispatchEvent(new Event('nx-team'));
        toast(`Listo: ${name} ya puede entrar al panel con su cuenta.`);
        return;
      }
      if (name.length < 2 || !/^\S+@\S+\.\S+$/.test(mail)) { toast('Escribe el nombre y un correo válido.'); return; }
      const team = get<Array<{ name: string; mail: string; role: string }>>('nx-staff-team', []);
      if (!team.length) { paint.equipo(); }
      set('nx-staff-team', [...get<unknown[]>('nx-staff-team', []), { name, mail, role: $<HTMLSelectElement>('[data-add-role]').value }]);
      (e.target as HTMLFormElement).reset(); paint.equipo();
      toast(`Vista previa: con las cuentas, ${mail} recibirá una invitación por correo.`);
    });
    // Keep the team list saved once it's first shown, so adding works on top of the examples
    const ensureTeam = () => { if (hasBackend()) { void syncTeam().then((t) => { if (t) { if ((location.hash.slice(1) || 'inicio') === 'equipo') paint.equipo(); dispatchEvent(new Event('nx-team')); } }); return; }
      if (!localStorage.getItem('nx-staff-team')) { const s = me(); if (s) set('nx-staff-team', [{ name: s.name, mail: 'tú', role: 'admin' }, { name: 'Editora (ejemplo)', mail: 'editora@ejemplo.com', role: 'editor' }, { name: 'Ventas (ejemplo)', mail: 'ventas@ejemplo.com', role: 'ads' }, { name: 'Periodista (ejemplo)', mail: 'periodista@ejemplo.com', role: 'reporter' }]); } };

    // ---------- start ----------
    function start() {
      const s = me();
      $('[data-login]').hidden = !!s; $('[data-pnl-app]').hidden = !s;
      if (!s) return;
      ensureTeam();
      $$('[data-me]').forEach((e) => (e.textContent = s.name));
      $('[data-av]').textContent = s.name[0].toUpperCase();
      $('[data-role]').textContent = ROLE_NAME[s.role];
      paintCounts(); showTab(location.hash.slice(1) || 'inicio');
      if (hasBackend()) void loadLive(true); // what's really waiting (stories in review, automatic news, reported comments)
      if (hasBackend()) void loadRequests().then(() => { paintCounts(); if ((location.hash.slice(1) || 'inicio') === 'inicio') showTab('inicio'); }); // real ad requests for the counts and Inicio
    }
    // Real login (once BACKEND is set in src/lib/backend.ts): Supabase email + password, role from the `staff` table
    if (hasBackend()) { $('[data-real]').hidden = false; $$('[data-prevlogin]').forEach((e) => (e.hidden = true)); }
    $<HTMLFormElement>('[data-login]').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (hasBackend()) {
        const er = $('[data-err]'); er.hidden = true;
        const ok = await staffLogin($<HTMLInputElement>('#pnl-mail').value.trim(), $<HTMLInputElement>('#pnl-pass').value);
        const who = ok ? await staffProfile() : null;
        if (!who) { er.textContent = ok ? 'Tu cuenta no está en el equipo. Pídele al administrador que te añada.' : 'Correo o contraseña incorrectos.'; er.hidden = false; return; }
        set('nx-staff', who); start(); return;
      }
      const name = $<HTMLInputElement>('#pnl-name').value.trim();
      if (name.length < 2) { const er = $('[data-err]'); er.textContent = 'Escribe tu nombre.'; er.hidden = false; return; }
      set('nx-staff', { name, role: $<HTMLSelectElement>('#pnl-role').value });
      start();
    });
    $('[data-logout]').addEventListener('click', () => { staffLogout(); set('nx-staff', null); set('nx-staff-pending', null); dispatchEvent(new Event('nx-staff-change')); start(); });
    // The comment and ad queues change counts when used
    root.addEventListener('click', () => setTimeout(paintCounts, 50));
    start();
  </script>
</Base>
