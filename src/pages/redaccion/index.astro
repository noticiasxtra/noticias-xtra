      analitica() {
        const r = Number($('[data-range][aria-pressed="true"]').dataset.range);
        const slice = visits.slice(-r);
        const total = slice.reduce((a, v) => a + v.v, 0); const prevTotal = visits.slice(-2 * r, -r).reduce((a, v) => a + v.v, 0) || total;
        const ch = Math.round(((total - prevTotal) / prevTotal) * 100);
        $('[data-an-kpis]').innerHTML = [
          kpi('Visitantes', num(total), r === 1 ? 'hoy hasta ahora' : r === 7 ? `${ch >= 0 ? '▲' : '▼'} ${Math.abs(ch)}% vs. la semana anterior` : 'últimos 30 días'),
          kpi('Páginas vistas', num(total * 2.4), '2.4 por visita'),
