        $('.pnl-h', $('[data-pane="inicio"]')).firstChild!.textContent = h < 12 ? 'Buenos días, ' : h < 19 ? 'Buenas tardes, ' : 'Buenas noches, ';
        $('[data-today]').textContent = new Date().toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Puerto_Rico' });
        const today = visits[visits.length - 1].v; const rev = revenue[revenue.length - 1];
        $('[data-kpis]').innerHTML = [
          allowed.includes('noticias') && kpi('Noticias por aprobar', String(c.pending), `${c.check} para vistazo rápido`, 'noticias', c.pending ? 'warn' : ''),
