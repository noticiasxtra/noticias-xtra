              <h2>${esc(d.title)}</h2><p class="pnl-muted">${esc(d.section)} · ${ago(d.at)} · Fuente: <a href="${d.sourceUrl}" target="_blank" rel="noopener">${esc(d.source)} ↗</a></p></div></header>
            <div class="pnl-cmp">
