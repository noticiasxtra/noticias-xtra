          `<li><span>⏳ <b>Clínica Dental Sonrisa</b>: termina el 20 de octubre.</span></li>`,
          `<li><span>🆕 ${listRequests().filter((r) => !r.paid).length || 0} solicitudes sin pagar en la cola de anuncios.</span><button type="button" data-go="anuncios">Ver</button></li>`,
        ].join('');
        const costs = COSTS.reduce((a, c) => a + c[1], 0);
        const net = tot(m) - fees - costs;
        $('[data-rev-net]').innerHTML = `<table class="pnl-table"><tbody>
          <tr><th scope="row">Ingresos de septiembre</th><td>${money(tot(m))}</td></tr>
