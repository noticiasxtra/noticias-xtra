---
// Staff panel ("Panel de la redacción"): one login for everything waiting on the newsroom.
// Tabs: Inicio, Noticias (approve AI drafts, quick look at published ones), Comentarios, Anuncios, Ingresos,
// Analítica, Salud del sitio, Equipo. What each person sees depends on their role.
// PREVIEW: there are no accounts yet, so login is a name + role kept on this device ('nx-staff'), the drafts,
// analytics and revenue are examples (EJEMPLO / DEMO), and Salud reads the real public GitHub status.
// The real version: Supabase login + roles, a Supabase Edge Function holding the GitHub token (approve = merge
// the pull request), Google Analytics for visitors, and Stripe/ATH/Ad Manager for revenue.
import Base from '../../layouts/Base.astro';
import AdQueue from '../../components/AdQueue.astro';
import CommentQueue from '../../components/CommentQueue.astro';
import SalesDesk from '../../components/panel/SalesDesk.astro';
import Writer from '../../components/panel/Writer.astro';
import Tasks from '../../components/panel/Tasks.astro';
import { getStories, url, SECTIONS, SITE } from '../../lib/site';
import { hasBackend } from '../../lib/backend';
import sources from '../../../scripts/sources.json';

const stories = await getStories();
const hasBackendBuild = hasBackend(); // Supabase connected: real accounts and team
// Everything on the site, for Escribir → Publicadas (with views once analytics is connected)
const published = stories.map((s) => ({ id: s.id, title: s.data.title, section: SECTIONS.find((x) => x.id === s.data.section)?.name ?? '', author: s.data.author, date: s.data.date.toISOString(), url: url(`noticia/${s.id}/`), ai: s.data.aiAssisted }));
// The story pinned (📌) in the home page's main spot, for the reminder on Inicio
const pinnedStory = stories.filter((s) => s.data.pinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const pin = pinnedStory ? { title: pinnedStory.data.title, date: pinnedStory.data.date.toISOString(), url: url(`noticia/${pinnedStory.id}`) } : null;
// Stories pinned at the top of each section (newest pin per section), for the same reminder
const sectionPins = SECTIONS.map((sec) => {
  const p = stories.filter((s) => s.data.section === sec.id && s.data.sectionPinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
  return p ? { section: sec.name, title: p.data.title, url: url(`noticia/${p.id}`) } : null;
}).filter(Boolean);
const recent = stories.filter((s) => s.data.section !== 'opinion').slice(0, 12)
  .map((s) => ({ id: s.id, title: s.data.title, section: SECTIONS.find((x) => x.id === s.data.section)?.name ?? '', url: url(`noticia/${s.id}/`), date: s.data.date.toISOString() }));
const srcs = (sources as Array<{ name: string; section: string; review?: string; enabled?: boolean }>).filter((s) => s.enabled !== false)
  .map((s) => ({ name: s.name, section: s.section, review: s.review ?? 'always' }));
const TABS = [
  ['inicio', 'Inicio', '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>'],
  ['noticias', 'Noticias', '<path d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5"/>'],
  ['escribir', 'Escribir', '<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>'],
  ['comentarios', 'Comentarios', '<path d="M4 5h16v11H9l-5 4z"/>'],
  ['ventas', 'Ventas', '<path d="M3 7h18l-2 12H5z"/><path d="M8 7a4 4 0 0 1 8 0"/>'],
  ['anuncios', 'Anuncios', '<path d="M3 11v2l13 5V6L3 11z"/><path d="M16 9a3 3 0 0 1 0 6"/>'],
  ['ingresos', 'Ingresos', '<path d="M12 3v18M17 7H9.5a3 3 0 0 0 0 6h5a3 3 0 0 1 0 6H6"/>'],
  ['analitica', 'Analítica', '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'],
  ['salud', 'Salud del sitio', '<path d="M3 12h4l2-5 4 10 2-5h6"/>'],
  ['equipo', 'Equipo', '<circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4a3.5 3.5 0 0 1 0 7M22 20a7 7 0 0 0-4-6.3"/>'],
];
---
<Base title="Panel de la redacción" description="Panel interno de Noticias Xtra (uso del personal)." noindex staff>
  <main class="wrap pnl" id="main" data-pnl data-pin={JSON.stringify(pin)} data-section-pins={JSON.stringify(sectionPins)} data-recent={JSON.stringify(recent)} data-sources={JSON.stringify(srcs)} data-base={url()} data-aikey={String(SITE.aiKeyConnected)}>
    <form class="pnl-login" data-login hidden>
      <p class="pnl-kicker">Noticias Xtra</p>
      <h1>Panel de la redacción</h1>
      <p class="pnl-muted">Todo lo que te espera en un solo lugar: noticias por aprobar, comentarios, anuncios, ingresos y analítica.</p>
      {/* With the database: email and password; the role comes from the staff list. Preview: name and role. */}
      <div class="pnl-real" data-real hidden>
        <label for="pnl-mail">Correo</label>
        <input id="pnl-mail" type="email" autocomplete="username" />
        <label for="pnl-pass">Contraseña</label>
        <input id="pnl-pass" type="password" autocomplete="current-password" />
      </div>
      <div class="pnl-prev" data-prevlogin>
      <label for="pnl-name">Tu nombre</label>
      <input id="pnl-name" maxlength="30" autocomplete="name" placeholder="ej. Alfredo" />
      <label for="pnl-role">Rol</label>
      <select id="pnl-role">
        <option value="admin">Administrador: todo</option>
        <option value="editor">Editor: noticias, comentarios y analítica</option>
        <option value="ads">Ventas: clientes, anuncios e ingresos</option>
        <option value="reporter">Periodista: escribir sus noticias</option>
      </select>
      </div>
      <p class="cm-err" data-err hidden></p>
      <button type="submit" class="adp-btn">Entrar</button>
      <p class="pnl-note" data-prevlogin><span class="sp-demo">VISTA PREVIA</span> Sin contraseña por ahora. Con las cuentas, cada persona entra con su correo y su contraseña, y su rol lo asigna el administrador.</p>
    </form>

    <div class="pnl-app" data-pnl-app hidden>
      <aside class="pnl-side">
        <div class="pnl-me"><span class="pnl-av" data-av></span><span><b data-me></b><small data-role></small></span></div>
        <nav class="pnl-nav" aria-label="Secciones del panel">
          {TABS.map(([id, name, d]) => (
            <button type="button" data-tab={id} aria-current="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={d} /></svg>
              <span>{name}</span><b class="pnl-n" data-count={id}></b>
            </button>
          ))}
        </nav>
        <button type="button" class="pnl-out" data-logout>Salir</button>
      </aside>

      <div class="pnl-main">
        <p class="pnl-banner"><span class="sp-demo">VISTA PREVIA</span> Los datos marcados EJEMPLO o DEMO son de muestra. Se vuelven reales cuando se conecten las cuentas (Supabase, Google Analytics, Stripe y ATH Móvil).</p>

        <!-- Inicio -->
        <section class="pnl-pane" data-pane="inicio">
          <h1 class="pnl-h">Buenos días, <span data-me></span></h1>
          <p class="pnl-muted" data-today></p>
          <div class="pnl-kpis" data-kpis></div>
          <h2 class="pnl-h2">Lo que te espera</h2>
          <ul class="pnl-todo" data-todo></ul>
          <Tasks />
        </section>

        <!-- Noticias -->
        <section class="pnl-pane" data-pane="noticias" hidden>
          <h1 class="pnl-h">Noticias</h1>
          <p class="pnl-muted">Las de rutina (tiempo, terremotos, resultados, avisos de agencias) ya se publicaron solas. Aquí aprueba las que esperan por ti y dale un vistazo a las publicadas.</p>
          <p class="pnl-gh" data-gh-news></p>
          <nav class="apn-tabs pnl-sub" role="tablist" aria-label="Noticias">
            <button type="button" role="tab" aria-selected="true" data-nf="pending">Por aprobar <b data-nn="pending"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="check">Vistazo rápido <b data-nn="check"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="done">Resueltas <b data-nn="done"></b></button>
          </nav>
          <div class="pnl-list" data-news></div>
        </section>

        <!-- Escribir -->
        <section class="pnl-pane" data-pane="escribir" hidden>
          <Writer recent={recent.map(({ id, title }) => ({ id, title }))} published={published} />
        </section>

        <!-- Ventas -->
        <section class="pnl-pane" data-pane="ventas" hidden>
          <SalesDesk />
        </section>

        <!-- Comentarios -->
        <section class="pnl-pane" data-pane="comentarios" hidden>
          <CommentQueue embedded />
          <h2 class="pnl-h2">Últimos comentarios en este dispositivo</h2>
          <ul class="pnl-cmts" data-cmts></ul>
        </section>

        <!-- Anuncios -->
        <section class="pnl-pane" data-pane="anuncios" hidden>
          <AdQueue embedded />
        </section>

        <!-- Ingresos -->
        <section class="pnl-pane" data-pane="ingresos" hidden>
          <h1 class="pnl-h">Ingresos <span class="sp-demo">DEMO</span></h1>
          <p class="pnl-muted">Lo que entra por anuncios directos y por Google, lo que falta por cobrar y lo que queda después de los costos del sitio.</p>
          <div class="pnl-kpis" data-rev-kpis></div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Ingresos por mes</h2><div class="pnl-chart" data-rev-chart></div></div>
            <div class="pnl-card"><h2 class="pnl-h3">De dónde viene este mes</h2><div data-rev-mix></div></div>
          </div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Mejores clientes</h2><div data-rev-clients></div></div>
            <div class="pnl-card"><h2 class="pnl-h3">Por cobrar y por renovar</h2><ul class="pnl-todo" data-rev-due></ul></div>
          </div>
          <div class="pnl-card"><h2 class="pnl-h3">Ganancia del mes</h2><div data-rev-net></div></div>
        </section>

        <!-- Analítica -->
        <section class="pnl-pane" data-pane="analitica" hidden>
          <h1 class="pnl-h">Analítica <span class="sp-demo">DEMO</span></h1>
          <div class="pnl-range" role="group" aria-label="Período">
            <button type="button" data-range="1">Hoy</button><button type="button" data-range="7">7 días</button><button type="button" data-range="30" aria-pressed="true">30 días</button>
          </div>
          <div class="pnl-kpis" data-an-kpis></div>
          <div class="pnl-card"><h2 class="pnl-h3">Visitantes por día</h2><div class="pnl-chart" data-an-chart></div></div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Más leídas</h2><ol class="pnl-top" data-an-top></ol></div>
            <div class="pnl-card"><h2 class="pnl-h3">De dónde llegan</h2><div data-an-ref></div></div>
          </div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Dónde están</h2><div data-an-geo></div></div>
            <div class="pnl-card"><h2 class="pnl-h3">Secciones y dispositivos</h2><div data-an-sec></div><div data-an-dev></div></div>
          </div>
        </section>

        <!-- Salud -->
        <section class="pnl-pane" data-pane="salud" hidden>
          <h1 class="pnl-h">Salud del sitio</h1>
          <p class="pnl-muted">Estado real, tomado de GitHub en este momento.</p>
          <div class="pnl-kpis" data-health></div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Cuentas y conexiones</h2><ul class="pnl-checks" data-accounts></ul></div>
            <div class="pnl-card"><h2 class="pnl-h3">Fuentes de noticias <small data-src-n></small></h2><ul class="pnl-srcs" data-srcs></ul></div>
          </div>
        </section>

        <!-- Equipo -->
        <section class="pnl-pane" data-pane="equipo" hidden>
          <h1 class="pnl-h">Equipo</h1>
          <p class="pnl-muted">Quién entra al panel y qué puede hacer.</p>
          {hasBackendBuild && <p class="pnl-muted pnl-small">Para añadir a alguien: primero crea su cuenta en el sitio (Entrar → Crear cuenta). Luego escribe aquí su nombre, su correo o @usuario y su rol. Entra al panel con ese mismo correo y contraseña.</p>}
          <ul class="pnl-team" data-team></ul>
          <form class="pnl-add" data-add novalidate>
            <input placeholder="Nombre" data-add-name maxlength="30" aria-label="Nombre" />
            <input placeholder="Correo o @usuario" data-add-mail maxlength="60" aria-label="Correo o nombre de usuario" autocapitalize="off" />
            <select data-add-role aria-label="Rol"><option value="editor">Editor</option><option value="ads">Ventas</option><option value="reporter">Periodista</option><option value="admin">Administrador</option></select>
            <button type="submit" class="adp-btn">Añadir</button>
          </form>
          <h2 class="pnl-h2">Qué puede hacer cada rol</h2>
          <div class="pnl-tablewrap" data-perms></div>
        </section>
      </div>
    </div>
    <div class="apn-toast" data-ptoast role="status" hidden></div>
  </main>

  <script>
    import { ask } from '../../lib/dialogs';
    import { getReports } from '../../lib/moderation';
    import { listRequests, loadRequests } from '../../lib/adrequests';
    import { hasBackend, staffLogin, staffLogout, staffProfile, syncTeam, addToTeam, removeFromTeam } from '../../lib/backend';
    const root = document.querySelector<HTMLElement>('[data-pnl]')!;
    const RECENT: Array<{ id: string; title: string; section: string; url: string; date: string }> = JSON.parse(root.dataset.recent!);
    const SOURCES: Array<{ name: string; section: string; review: string }> = JSON.parse(root.dataset.sources!);
    const PIN: { title: string; date: string; url: string } | null = JSON.parse(root.dataset.pin || 'null');
    const SECTION_PINS: Array<{ section: string; title: string; url: string }> = JSON.parse(root.dataset.sectionPins || '[]');
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const get = <T,>(k: string, d: T): T => { try { return JSON.parse(localStorage.getItem(k) || 'null') ?? d; } catch { return d; } };
    const set = (k: string, v: unknown) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, JSON.stringify(v)); } catch { /* storage blocked */ } };
    const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
    const num = (n: number) => Math.round(n).toLocaleString('es-PR');
    const ago = (t: number) => { const m = Math.round((Date.now() - t) / 60000); return m < 60 ? `hace ${Math.max(1, m)} min` : m < 1440 ? `hace ${Math.round(m / 60)} h` : `hace ${Math.round(m / 1440)} d`; };
    const toast = (m: string) => { const t = $('[data-ptoast]'); t.textContent = m; t.hidden = false; clearTimeout((t as any).tm); (t as any).tm = setTimeout(() => (t.hidden = true), 3800); };

    // ---------- login + roles ----------
    type Staff = { name: string; role: 'admin' | 'editor' | 'ads' | 'reporter' };
    const ROLE_NAME = { admin: 'Administrador', editor: 'Editor', ads: 'Ventas', reporter: 'Periodista' };
    const ROLE_TABS: Record<Staff['role'], string[]> = {
      admin: ['inicio', 'noticias', 'escribir', 'ventas', 'comentarios', 'anuncios', 'ingresos', 'analitica', 'salud', 'equipo'],
      editor: ['inicio', 'noticias', 'escribir', 'comentarios', 'analitica', 'salud'],
      ads: ['inicio', 'ventas', 'anuncios', 'ingresos', 'comentarios'],
      reporter: ['inicio', 'escribir'],
    };
    const me = () => get<Staff | null>('nx-staff', null);

    // ---------- example news waiting for approval (EJEMPLO) ----------
    type Draft = { id: string; title: string; source: string; sourceUrl: string; why: string[]; excerpt: string; body: string; section: string; at: number };
    const now = Date.now();
    const DRAFTS: Draft[] = [
      { id: 'd1', section: 'Estados Unidos', title: 'Casa Blanca anuncia $2,000 millones para reparar puertos tras huracanes', source: 'La Casa Blanca', sourceUrl: 'https://www.whitehouse.gov/news/', at: now - 50 * 60000,
        why: ['Fuente que siempre se aprueba', 'Tono de gobierno reescrito'],
        excerpt: 'In a historic win for American workers, President announced today an unprecedented $2 billion investment, delivering on his unwavering commitment to rebuild hurricane-damaged ports across the nation…',
        body: 'La Casa Blanca anunció $2,000 millones para reparar puertos dañados por huracanes en Estados Unidos y sus territorios.\n\nSegún el comunicado, el dinero se repartirá mediante solicitudes de los gobiernos estatales y territoriales. El anuncio no detalla cuánto le tocaría a Puerto Rico ni cuándo abre el proceso.\n\nLa Autoridad de los Puertos no había reaccionado al anuncio.' },
      { id: 'd2', section: 'Puerto Rico', title: 'Acusan a dos personas de fraude con ayudas de FEMA tras el huracán Fiona', source: 'Departamento de Justicia de EE.UU.', sourceUrl: 'https://www.justice.gov/', at: now - 3 * 36e5,
        why: ['Crimen o acusación', 'Fuente que siempre se aprueba'],
        excerpt: 'A federal grand jury in San Juan returned an indictment charging two individuals with wire fraud and false claims related to FEMA Individual Assistance following Hurricane Fiona…',
        body: 'Un gran jurado federal en San Juan acusó a dos personas de fraude electrónico y reclamaciones falsas a FEMA tras el huracán Fiona, según el Departamento de Justicia federal.\n\nLa acusación sostiene que pidieron ayudas por daños a residencias que no eran suyas. Las acusaciones no son prueba de culpa; toda persona se presume inocente hasta que se pruebe lo contrario.' },
      { id: 'd3', section: 'Puerto Rico', title: 'LUMA programa interrupciones del servicio el sábado en Caguas y Gurabo', source: 'LUMA Energy', sourceUrl: 'https://lumapr.com/news/', at: now - 5 * 36e5,
        why: ['La IA tiene una duda'],
        excerpt: 'LUMA realizará trabajos de mejoras en la línea de 38 kV entre Caguas y Gurabo. Clientes de las urbanizaciones… estarán sin servicio desde las 7:00 a.m. hasta aproximadamente…',
        body: 'LUMA anunció que el sábado habrá interrupciones del servicio eléctrico en sectores de Caguas y Gurabo por trabajos en una línea de transmisión.\n\nEl corte comenzará a las 7:00 a.m. El comunicado no indica con claridad a qué hora terminará.\n\nDuda de la IA: la hora de fin aparece cortada en el comunicado. Verifícala antes de publicar.' },
    ];
    type NewsState = Record<string, { status: 'approved' | 'rejected' | 'ok' | 'removed'; body?: string; at: number }>;
    const news = () => get<NewsState>('nx-panel-news', {});
    const setNews = (id: string, v: NewsState[string]) => { set('nx-panel-news', { ...news(), [id]: v }); };
    const pendingDrafts = () => DRAFTS.filter((d) => !news()[d.id]);
    const checkList = () => RECENT.slice(0, 6).filter((r) => !news()[`c-${r.id}`]);

    // ---------- demo numbers (stable for a given day) ----------
    let seed = Number(new Date().toISOString().slice(0, 10).replace(/-/g, ''));
    const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
    const DAYS = 30;
    const visits = Array.from({ length: DAYS }, (_, i) => {
      const d = new Date(now - (DAYS - 1 - i) * 864e5); const wk = d.getDay() === 0 || d.getDay() === 6;
      return { d, v: Math.round((wk ? 2600 : 4100) * (0.82 + rnd() * 0.36) * (1 + i * 0.012)) };
    });
    const revenue = [
      { m: 'abr', direct: 420, google: 95, design: 38 }, { m: 'may', direct: 610, google: 130, design: 57 }, { m: 'jun', direct: 780, google: 168, design: 38 },
      { m: 'jul', direct: 940, google: 205, design: 76 }, { m: 'ago', direct: 1120, google: 240, design: 57 }, { m: 'sep', direct: 1310, google: 286, design: 95 },
    ];
    { // October so far: September's pace, slightly up, up to today's date
      const sep = revenue[revenue.length - 1]; const f = (1.06 * new Date().getDate()) / 31;
      revenue.push({ m: 'oct', direct: Math.round(sep.direct * f), google: Math.round(sep.google * f), design: Math.round(sep.design * f) });
    }
    const COSTS = [['IA para noticias', 9], ['Datos deportivos', 50], ['Supabase', 25], ['Boletín', 0], ['Dominio', 1.5]] as const;

    // ---------- small accessible charts (one series, recessive grid, hover tooltip, table view) ----------
    const charts = new Map<HTMLElement, () => void>();
    const ro = new ResizeObserver((es) => es.forEach((e) => { const el = e.target as HTMLElement; const w = Math.round(el.clientWidth); if (w && el.dataset.w !== String(w)) { el.dataset.w = String(w); charts.get(el)?.(); } }));
    function barChart(el: HTMLElement, data: Array<{ label: string; value: number; tip: string }>, fmt: (n: number) => string) {
      // Drawn at the box's real width so the labels stay readable on phones; redrawn when the box resizes
      charts.set(el, () => barChart(el, data, fmt));
      const W = Math.max(280, el.clientWidth || 640), H = W < 420 ? 180 : 220, padL = 44, padB = 26, padT = 10;
      const every = Math.ceil(data.length / Math.max(3, Math.floor(W / 70))); // label every n-th bar
      const max = Math.max(...data.map((d) => d.value)) * 1.1 || 1;
      const step = Math.pow(10, Math.floor(Math.log10(max / 3))); const tick = Math.ceil(max / 3 / step) * step;
      const bw = (W - padL) / data.length; const y = (v: number) => padT + (H - padT - padB) * (1 - v / max);
      const grid = [0, 1, 2, 3].map((i) => i * tick).filter((v) => v <= max)
        .map((v) => `<line x1="${padL}" x2="${W}" y1="${y(v)}" y2="${y(v)}" class="pc-grid"/><text x="${padL - 6}" y="${y(v) + 4}" class="pc-ax" text-anchor="end">${fmt(v)}</text>`).join('');
      const bars = data.map((d, i) => {
        const x = padL + i * bw + 1, w = Math.max(2, bw - 2), top = y(d.value), h = H - padB - top, r = Math.min(4, w / 2);
        return `<g class="pc-bar" tabindex="0" data-tip="${esc(d.tip)}"><rect x="${x - 1}" y="${padT}" width="${bw}" height="${H - padB - padT}" class="pc-hit"/>`
          + `<path d="M${x} ${H - padB}V${top + r}q0 -${r} ${r} -${r}h${w - 2 * r}q${r} 0 ${r} ${r}V${H - padB}z" class="pc-mark"/>`
          + (i % every === 0 || i === data.length - 1 ? `<text x="${x + w / 2}" y="${H - 8}" class="pc-ax" text-anchor="middle">${esc(d.label)}</text>` : '') + '</g>';
      }).join('');
      ro.observe(el); el.dataset.w = String(Math.round(el.clientWidth));
      el.innerHTML = `<div class="pc-wrap"><svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="Gráfica de barras">${grid}<line x1="${padL}" x2="${W}" y1="${H - padB}" y2="${H - padB}" class="pc-base"/>${bars}</svg><div class="pc-tip" hidden></div></div>`
        + `<details class="pc-table"><summary>Ver como tabla</summary><table><tbody>${data.map((d) => `<tr><th scope="row">${esc(d.label)}</th><td>${esc(d.tip)}</td></tr>`).join('')}</tbody></table></details>`;
      const tip = $('.pc-tip', el), wrap = $('.pc-wrap', el);
      const show = (g: Element) => { const r = g.getBoundingClientRect(), wr = wrap.getBoundingClientRect(); tip.textContent = (g as HTMLElement).dataset.tip!; tip.hidden = false;
        tip.style.left = `${Math.min(wr.width - tip.offsetWidth, Math.max(0, r.left - wr.left + r.width / 2 - tip.offsetWidth / 2))}px`; };
      $$('.pc-bar', el).forEach((g) => { g.addEventListener('mouseenter', () => show(g)); g.addEventListener('focus', () => show(g)); g.addEventListener('mouseleave', () => (tip.hidden = true)); g.addEventListener('blur', () => (tip.hidden = true)); });
    }
    // Ranked list with a bar per row (one hue; the label and value are always written out)
    const rows = (items: Array<[string, number]>, fmt = (n: number) => `${n}%`) => {
      const max = Math.max(...items.map((i) => i[1])) || 1;
      return `<ul class="pc-rows">${items.map(([l, v]) => `<li><span class="pc-rl">${esc(l)}</span><span class="pc-rb"><i style="width:${(v / max) * 100}%"></i></span><b>${fmt(v)}</b></li>`).join('')}</ul>`;
    };
    const kpi = (label: string, value: string, sub = '', tab = '', tone = '') => `<${tab ? 'button type="button" data-go="' + tab + '"' : 'div'} class="pnl-kpi ${tone}"><span>${label}</span><b>${value}</b>${sub ? `<small>${sub}</small>` : ''}</${tab ? 'button' : 'div'}>`;

    // ---------- counts ----------
    const counts = () => {
      const rep = getReports().filter((r) => r.status === 'review').length;
      const ads = listRequests().filter((r) => r.status === 'revisar' || r.status === 'disenar').length;
      const td = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
      const leads = get<Array<{ stage: string; follow: string }>>('nx-leads', []).filter((l) => !['won', 'lost'].includes(l.stage) && l.follow && l.follow <= td).length;
      const review = get<Array<{ status: string }>>('nx-articles', []).filter((a) => a.status === 'review').length;
      return { noticias: pendingDrafts().length + checkList().length, pending: pendingDrafts().length, check: checkList().length, comentarios: rep, anuncios: ads, ventas: leads, escribir: review };
    };

    // ---------- tabs ----------
    let tab = 'inicio';
    function showTab(t: string) {
      const s = me(); if (!s) return;
      const allowed = ROLE_TABS[s.role];
      if (!allowed.includes(t)) t = 'inicio';
      tab = t;
      $$('[data-tab]').forEach((b) => { b.hidden = !allowed.includes(b.dataset.tab!); b.setAttribute('aria-current', String(b.dataset.tab === t)); });
      $$('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== t));
      const nav = $('.pnl-nav'), cur = $(`[data-tab="${t}"]`); // phones: keep the current tab visible in the scrolling bar
      if (nav.scrollWidth > nav.clientWidth) nav.scrollLeft = cur.offsetLeft - nav.clientWidth / 2 + cur.offsetWidth / 2;
      if (location.hash.slice(1) !== t) history.replaceState(null, '', `#${t}`);
      paint[t]?.();
    }
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-tab],[data-go]');
      if (b) { showTab(b.dataset.tab || b.dataset.go!); scrollTo({ top: 0, behavior: 'smooth' }); }
    });
    addEventListener('hashchange', () => showTab(location.hash.slice(1)));
    addEventListener('nx-leads', () => paintCounts());
    addEventListener('nx-tasks', () => { if (tab === 'inicio') paint.inicio(); });
    root.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-tk-scroll]')) document.querySelector('[data-tk]')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });

    function paintCounts() {
      const c = counts();
      (Object.entries({ noticias: c.noticias, comentarios: c.comentarios, anuncios: c.anuncios, ventas: c.ventas, escribir: c.escribir }) as Array<[string, number]>)
        .forEach(([k, n]) => { const el = $(`[data-count="${k}"]`); el.textContent = n ? String(n) : ''; });
      const r = me()?.role ?? 'admin'; const mine = ROLE_TABS[r as Staff['role']];
      set('nx-staff-pending', (['noticias', 'comentarios', 'anuncios', 'ventas', 'escribir'] as const).filter((k) => mine.includes(k)).reduce((a, k) => a + c[k], 0)); // profile menu badge
      dispatchEvent(new Event('nx-staff-change'));
    }

    // ---------- panes ----------
    const paint: Record<string, () => void> = {
      inicio() {
