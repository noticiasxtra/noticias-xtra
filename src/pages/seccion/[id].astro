---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import AdSlot from '../../components/AdSlot.astro';
import GamesTeaser from '../../components/GamesTeaser.astro';
import { getStories, topOrder, sectionTop, SECTIONS, SITE, VIDEOS, url, SECTION_LIVE } from '../../lib/site';

export function getStaticPaths() {
  // Deportes, Entretenimiento, Clima, Economía and Opinión have their own pages in this folder
  return SECTIONS.filter((s) => !['deportes', 'entretenimiento', 'clima', 'economia', 'opinion'].includes(s.id)).map((s) => ({ params: { id: s.id }, props: { sec: s } }));
}
const { sec } = Astro.props;
const all = await getStories();
const list = sectionTop(topOrder(all.filter((s) => s.data.section === sec.id)));
const vids = SITE.features.videos ? VIDEOS.filter((v) => v.section === sec.id) : [];
---
<Base title={sec.name} active={sec.id} description={`Noticias de ${sec.name} en ${SITE.name}.`}>
  <main class="wrap" id="main">
    <div class="sec-h" style="margin-top:0"><h1 style="font-size:32px;margin:0;color:var(--purple)">{sec.name}</h1></div>
    <div class="art-grid">
      <div>
        {list.length > 0 ? (
          <>
            <div class="block">
              <h2 class="sr">Últimas noticias</h2>
            <StoryCard story={list[0]} variant="big" priority />
              <div class="list">{list.slice(1, 5).map((s) => <StoryCard story={s} variant="item" />)}</div>
            </div>
            {list.length > 5 && (
              <section>
                <div class="sec-h"><h2>Más de {sec.name}</h2></div>
                <div class="grid3">{list.slice(5).map((s) => <StoryCard story={s} />)}</div>
              </section>
            )}
          </>
        ) : (
          <div class="empty"><p>Todavía no hay noticias de {sec.name.toLowerCase()} hoy.</p><a class="btn" href={url()}>Ir a la portada</a></div>
        )}
        <AdSlot size="infeed" />
        <GamesTeaser />
        {vids.length > 0 && (
          <>
            <div class="sec-h"><h2>Videos de {sec.name}</h2></div>
            <div class="autogrid">{vids.map((v) => <VideoCard video={v} />)}</div>
          </>
        )}
      </div>
      <Sidebar live={SECTION_LIVE[sec.id]} />
    </div>
  </main>
</Base>
