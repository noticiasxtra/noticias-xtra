---
// Internal preview of every holiday logo (not linked from the site). The header picks the right one automatically.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { HOLIDAYS, holidayOn, todayPR, DESCUBRIMIENTO_OPTIONS } from '../lib/holidays';
const y = Number(todayPR().slice(0, 4));
const fmt = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('es-PR', { day: 'numeric', month: 'long', year: 'numeric' });
// Next date each holiday comes up, so the list reads in calendar order from today
const rows = HOLIDAYS.map((h) => {
  const [a, b] = h.dates(y)[1] >= todayPR() ? h.dates(y) : h.dates(y + 1);
  return { h, a, b };
}).sort((p, q) => p.a.localeCompare(q.a));
const now = holidayOn(todayPR());
const desc = HOLIDAYS.find((h) => h.id === 'descubrimiento')!;
---
<Base title="Logos festivos" description="Vista previa de los logos para días feriados (uso interno).">
  <main class="wrap" id="main">
    <p class="pf-demo"><span class="sp-demo">VISTA PREVIA</span> Página interna. El logo cambia solo en estas fechas (hora de Puerto Rico) y se apaga si hay una alerta de ÚLTIMA HORA.</p>
    <h1 class="lf-h">Logos festivos</h1>
    <p class="apn-sub">{now ? `Hoy toca: ${now.name}.` : 'Hoy no hay logo festivo: se ve el logo normal.'} {HOLIDAYS.length} fechas en total, en orden desde hoy.</p>
    <h2 class="lf-sub">Opciones para el Descubrimiento de Puerto Rico</h2>
    <ul class="lf-grid lf-opts">
      {DESCUBRIMIENTO_OPTIONS.map((o) => (
        <li class="lf-card">
          <div class="lf-row">
            <div class="lf-stage"><Logo holiday={{ ...desc, decos: [{ spot: 'side', svg: o.svg, vb: o.vb, wide: o.wide }] }} href="#" /></div>
            <div class="lf-stage dark" data-theme="dark"><Logo holiday={{ ...desc, decos: [{ spot: 'side', svg: o.svg, vb: o.vb, wide: o.wide }] }} href="#" /></div>
          </div>
          <h2>{o.name}</h2>
        </li>
      ))}
    </ul>
    <h2 class="lf-sub">Todas las fechas</h2>
    <ul class="lf-grid">
      {rows.map(({ h, a, b }) => (
        <li class="lf-card">
          <div class="lf-row">
            <div class="lf-stage"><Logo holiday={h} href="#" /></div>
            <div class="lf-stage dark" data-theme="dark"><Logo holiday={h} href="#" /></div>
          </div>
          <h2>{h.name} <span class={`lf-tone ${h.tone}`}>{h.tone === 'festivo' ? 'Festivo' : 'Respetuoso'}</span></h2>
          <p>{h.when} · próximo: <b>{a === b ? fmt(a) : `${fmt(a)} al ${fmt(b)}`}</b></p>
          <p class="lf-title">Al pasar el ratón: “{h.title}”</p>
        </li>
      ))}
    </ul>
  </main>
</Base>
