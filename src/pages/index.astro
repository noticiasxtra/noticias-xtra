---
// Home page. Main column on the left, right column (Sidebar) for the whole height of the page,
// so there are no empty gaps. Section blocks only appear for sections that have stories.
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import VideoCard from '../components/VideoCard.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Sidebar from '../components/Sidebar.astro';
import Ph from '../components/Ph.astro';
import Label from '../components/Label.astro';
import HomeStrip from '../components/HomeStrip.astro';
import AdSlot from '../components/AdSlot.astro';
import BracketView from '../components/deportes/BracketView.astro';
import GamesTeaser from '../components/GamesTeaser.astro';
import { getStories, url, SITE, SECTIONS, VIDEOS } from '../lib/site';

const stories = await getStories();
const F = SITE.features;
const lead = stories.find((s) => s.data.featured) ?? stories[0];
const others = stories.filter((s) => s.id !== lead?.id);
const left = others.slice(0, 3);
const row = others.slice(3, 6);
const more = others.slice(6, 11);
const related = (lead?.data.related ?? []).map((id) => stories.find((s) => s.id === id)).filter((s) => s !== undefined);
const leadRelated = related.length ? related : others.slice(0, 3);
// Section blocks in the order a Puerto Rico reader cares about: island news first (government,
// politics, sports, the economy and bills, entertainment, health, weather), then the United States,
// the world and opinion. Only sections with stories appear (Puerto Rico news is already up top).
const HOME_ORDER = ['gobierno', 'politica', 'deportes', 'economia', 'entretenimiento', 'salud', 'clima', 'estados-unidos', 'mundo', 'opinion'] as const;
const sectionIds = [...HOME_ORDER, ...SECTIONS.map((s) => s.id).filter((id) => id !== 'puerto-rico' && !(HOME_ORDER as readonly string[]).includes(id))]
  .filter((id) => stories.some((s) => s.data.section === id)) as Array<(typeof SECTIONS)[number]['id']>;
---
<Base active="home">
  <HomeStrip />
  <div class="wrap home-grid" id="main">
    <main class="home-main">
      {!lead && <div class="empty"><p>Muy pronto publicaremos las primeras noticias.</p></div>}
      {lead && (
        <div class="home-hero">
          <article class="lead">
            {/* Headline sits on the photo so it is visible without scrolling */}
            <a class="lead-media" href={url(`noticia/${lead.id}`)}>
              <Ph sectionId={lead.data.section} image={lead.data.image} place={lead.data.place} league={lead.data.league} />
              <div class="lead-over"><Label story={lead} /><h1>{lead.data.title}</h1></div>
            </a>
            <p class="dek">{lead.data.description}</p>
            <ul class="related">{leadRelated.map((s) => <li><a href={url(`noticia/${s.id}`)} class="hl">{s.data.title}</a></li>)}</ul>
          </article>
          <div class="stack left">{left.map((s) => <StoryCard story={s} variant="mini" />)}</div>
        </div>
      )}

      {row.length > 0 && <div class="home-row">{row.map((s) => <StoryCard story={s} />)}</div>}

      {/* MLB postseason bracket (shows only while src/data/llaves.json has one) */}
      <BracketView league="mlb" home />

      <AdSlot size="infeed" />

      {more.length > 0 && (
        <section>
          <div class="sec-h"><h2>Más noticias</h2><a href={url('noticias')}>Ver todas</a></div>
          <div class="block">
            <StoryCard story={more[0]} variant="big" />
            <div class="list">{more.slice(1).map((s) => <StoryCard story={s} variant="item" />)}</div>
          </div>
        </section>
      )}

      {F.videos && (
        <section>
          <div class="sec-h"><h2>Videos</h2><a href={url('videos')}>Ver todos</a></div>
          <div class="vgrid">{VIDEOS.slice(0, 4).map((v) => <VideoCard video={v} />)}</div>
        </section>
      )}

      <div class="home-sections">
        {sectionIds.map((id, i) => (
          <>
            {/* a leftover block at the end spreads across the full width instead of leaving a gap */}
            <div class:list={{ 'sec-wide': i === sectionIds.length - 1 && sectionIds.length % 2 === 1 }}><SectionBlock sectionId={id} stories={stories} /></div>
            {i === 3 && i < sectionIds.length - 1 && <AdSlot size="infeed" class="ad-span" />}
            {i === 5 && i < sectionIds.length - 1 && <div class="ad-span"><GamesTeaser /></div>}
          </>
        ))}
      </div>

      {F.app && <section class="promo">
        <img src={url('icono-app.svg')} alt="" />
        <div><h2>Descarga la app de Noticias Xtra</h2><p>Recibe alertas de última hora y mira la transmisión en vivo desde tu celular.</p></div>
        <div class="stores">
          <button class="store" type="button" data-app><small>Descárgala en</small>App Store</button>
          <button class="store" type="button" data-app><small>Disponible en</small>Google Play</button>
        </div>
      </section>}
    </main>
    <Sidebar newsletter={false} foro />
  </div>
</Base>
