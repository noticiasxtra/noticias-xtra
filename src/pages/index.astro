---
// Home page. Main column on the left, right column (Sidebar) for the whole height of the page,
// so there are no empty gaps. Section blocks only appear for sections that have stories.
import Markets from '../components/economia/Markets.astro';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import VideoCard from '../components/VideoCard.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Sidebar from '../components/Sidebar.astro';
import Ph from '../components/Ph.astro';
import Label from '../components/Label.astro';
import HomeStrip from '../components/HomeStrip.astro';
import AdSlot from '../components/AdSlot.astro';
import LocalScores from '../components/deportes/LocalScores.astro';
import GamesTeaser from '../components/GamesTeaser.astro';
import { getStories, topOrder, pinTop, url, SITE, SECTIONS, VIDEOS, VIDEO_SOURCES } from '../lib/site';

const stories = await getStories();
const F = SITE.features;
// Top spots: Puerto Rico first, unless a U.S. or world story is trending (src/lib/site.ts topOrder)
const ordered = pinTop(topOrder(stories)); // a pinned story (📌) keeps the main spot; the editor's pick comes next
const lead = ordered[0];
// Each story appears once in the top area. Spots are filled in order of importance: the headlines under the main
// story (the editor's related stories, or else the next stories in line), the three smaller stories next to the main photo, the
// row of cards, then the block. Editors' picks ("Principal") are first in line after the main story.
const related = (lead?.data.related ?? []).map((id) => stories.find((s) => s.id === id)).filter((s) => s !== undefined && s.id !== lead?.id);
const inLine = ordered.filter((s) => s.id !== lead?.id && !related.includes(s));
const take = (n: number) => inLine.splice(0, n);
const leadRelated = related.length ? related : take(3);
const left = take(3);
const row = take(3);
const more = take(5);
// Section boxes further down skip what's already in the top area
const topIds = new Set([lead, ...leadRelated, ...left, ...row, ...more].filter(Boolean).map((s) => s!.id));
const restStories = stories.filter((s) => !topIds.has(s.id));
// Section blocks in the order a Puerto Rico reader cares about: island news first (government,
// politics, sports, the economy and bills, entertainment, health, weather), then the United States,
// the world and opinion. Only sections with stories appear (Puerto Rico news is already up top).
const HOME_ORDER = ['gobierno', 'politica', 'deportes', 'economia', 'entretenimiento', 'salud', 'clima', 'estados-unidos', 'mundo', 'opinion'] as const;
const sectionIds = [...HOME_ORDER, ...SECTIONS.map((s) => s.id).filter((id) => id !== 'puerto-rico' && !(HOME_ORDER as readonly string[]).includes(id))]
  .filter((id) => restStories.some((s) => s.data.section === id)) as Array<(typeof SECTIONS)[number]['id']>;
// Section boxes sit side by side in pairs. To avoid blank space under a shorter box, each section is
// paired with the next one (in priority order) that shows the same number of stories (a box shows up to 4).
// A section with no match gets a full-width row of its own.
const shown = (id: string) => Math.min(4, restStories.filter((s) => s.data.section === id).length);
const rows: Array<typeof sectionIds> = [];
const queue = [...sectionIds];
while (queue.length) {
  const a = queue.shift()!;
  const j = queue.findIndex((b) => shown(b) === shown(a));
  rows.push(j >= 0 ? [a, queue.splice(j, 1)[0]] : [a]);
}
---
<Base active="home">
  <HomeStrip />
  <div class="wrap home-grid" id="main">
    <main class="home-main">
      {!lead && <div class="empty"><p>Muy pronto publicaremos las primeras noticias.</p></div>}
      {lead && (
        <div class="home-hero hero-wide">
          <article class="lead">
            {/* Big photo across the main column, headline on the photo so it is visible without scrolling */}
            <a class="lead-media" href={url(`noticia/${lead.id}`)}>
              <Ph sectionId={lead.data.section} image={lead.data.image} place={lead.data.place} league={lead.data.league} sizes="(max-width:760px) 100vw, 900px" priority whole />
              <div class="lead-over"><Label story={lead} /><h1>{lead.data.title}</h1></div>
            </a>
            <p class="dek">{lead.data.description}</p>
            <ul class="related">{leadRelated.map((s) => <li><a href={url(`noticia/${s.id}`)} class="hl">{s.data.title}</a></li>)}</ul>
          </article>
          {/* Three smaller top stories next to the main one (under it on phones) */}
          {left.length > 0 && (
            <div class="stack hero-side">
              {left.map((s) => <StoryCard story={s} variant="item" />)}
              {/* Fills the space under the three stories; hidden when the column is narrower than the ad */}
              <AdSlot size="rectangle" class="hero-ad" />
            </div>
          )}
        </div>
      )}

      {row.length > 0 && <div class="home-row">{row.map((s) => <StoryCard story={s} />)}</div>}

      {more.length > 0 && (
        <section>
          <div class="sec-h"><h2>Más noticias</h2><a href={url('noticias')}>Ver todas</a></div>
          <div class="block">
            <StoryCard story={more[0]} variant="big" />
            <div class="list">{more.slice(1).map((s) => <StoryCard story={s} variant="item" />)}</div>
          </div>
        </section>
      )}

      <AdSlot size="infeed" />

      {/* BSN, Doble A and La Pro scores: live first, then recent results */}
      <LocalScores />

      {F.videos && (
        <section>
          <div class="sec-h"><h2>Videos</h2><a href={url('videos')}>Ver todos</a></div>
          {/* NotiCel's newest upload (always current, straight from YouTube) next to the latest NotiCel videos */}
          <div class="vx-home">
            <div class="vx-player">
              <div class="lg-video-frame">
                <iframe data-src={`https://www.youtube-nocookie.com/embed/videoseries?list=UU${VIDEO_SOURCES.noticel.channel.slice(2)}&autoplay=1&mute=1&rel=0&playsinline=1`} title="Lo más reciente de NotiCel en YouTube" loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              </div>
              <p class="vsrc">Lo más reciente de <a href={VIDEO_SOURCES.noticel.url} rel="noopener" target="_blank">NotiCel en YouTube</a></p>
            </div>
            <div class="vx-list">{VIDEOS.filter((v) => v.src === 'noticel').slice(0, 4).map((v) => <VideoCard video={v} />)}</div>
          </div>
        </section>
      )}

      <Markets strip />

      <div class="home-sections">
        {rows.map((row, i) => (
          <>
            {row.map((id) => <div class:list={{ 'sec-wide': row.length === 1 }}><SectionBlock sectionId={id} stories={restStories} /></div>)}
            {i === 1 && i < rows.length - 1 && <AdSlot size="infeed" class="ad-span" />}
            {i === 3 && i < rows.length - 1 && <div class="ad-span"><GamesTeaser /></div>}
            {i === 4 && i < rows.length - 1 && <AdSlot size="infeed" class="ad-span" />}
          </>
        ))}
      </div>

      {F.app && <section class="promo">
        <img src={url('icono-app.svg')} alt="" />
        <div><h2>Descarga la app de Noticias Xtra</h2><p>Recibe alertas de última hora y mira la transmisión en vivo desde tu celular.</p></div>
        <div class="stores">
          <button class="store" type="button" data-app><small>Descárgala en</small>App Store</button>
          <button class="store" type="button" data-app><small>Disponible en</small>Google Play</button>
        </div>
      </section>}
    </main>
    <Sidebar foro extras />
  </div>
</Base>
