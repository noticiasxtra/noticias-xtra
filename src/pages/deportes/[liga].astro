---
// One page per league: /deportes/bsn/, /deportes/doble-a/ ...
import Base from '../../layouts/Base.astro';
import LeagueTabs from '../../components/deportes/LeagueTabs.astro';
import ScoreStrip from '../../components/deportes/ScoreStrip.astro';
import FeedCard from '../../components/deportes/FeedCard.astro';
import { getStories, url } from '../../lib/site';
import { LEAGUES, type League } from '../../lib/leagues';

export function getStaticPaths() {
  return LEAGUES.map((l) => ({ params: { liga: l.id }, props: { l } }));
}
const { l } = Astro.props as { l: League };
const list = (await getStories()).filter((s) => s.data.section === 'deportes' && s.data.league === l.id);
---
<Base title={`${l.full} | Deportes`} active="deportes" description={`${l.full}: ${l.about}`}>
  <section class="sp-top sp-top-league" style={`--lc:${l.color}`}>
    <div class="wrap">
      <div class="sp-title">
        <h1><a href={url('seccion/deportes')}>Xtra <span>Deportes</span></a> <em>/</em> {l.name}</h1>
        <p>{l.full}. {l.about}{'url' in l && l.url && <> <a href={l.url} rel="noopener" target="_blank">Sitio oficial ↗</a></>}</p>
      </div>
      <LeagueTabs active={l.id} />
      <ScoreStrip only={l.id} />
    </div>
  </section>
  <main class="wrap" id="main">
    {list.length ? (
      <div class="sp-feed-list">{list.map((s) => <FeedCard story={s} />)}</div>
    ) : (
      <div class="empty"><p>Todavía no hay noticias de {l.full}.</p><a class="btn" href={url('seccion/deportes')}>Ver todos los deportes</a></div>
    )}
  </main>
</Base>
