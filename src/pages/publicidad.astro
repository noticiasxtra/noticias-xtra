---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="Anúnciate con nosotros">
  <main class="wrap" id="main">
    <div class="page">
      <h1>Anúnciate con nosotros</h1>
      <p>Lleva tu mensaje a lectores de Puerto Rico con anuncios en la portada y junto a nuestras noticias.</p>
      {SITE.email ? (
        <p>Para conocer opciones y precios, escríbenos a <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Publicidad')}`}>{SITE.email}</a>.</p>
      ) : (
        <p>Muy pronto publicaremos la información de contacto de ventas.</p>
      )}
    </div>
  </main>
</Base>
