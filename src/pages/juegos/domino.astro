---
// Dominó: double-six dominoes against the computer. 7 tiles each, the rest go to the pile.
// Match a number at either end of the line. Can't play? Draw from the pile, or pass when it's empty.
// The round winner scores the points left in the other hand; first to 100 wins the match.
import Base from '../../layouts/Base.astro';
import GameLayout from '../../components/GameLayout.astro';
import { url } from '../../lib/site';
---
<Base title="Dominó" description="Juega dominó contra la computadora. Gratis, en tu celular o computadora.">
  <main class="wrap" id="main">
    <GameLayout id="domino">
    <div class="jg-game dm" data-domino>
      <p class="tv-kicker"><a href={url('juegos')}>Juegos Xtra</a> · Dominó</p>
      <h1>Dominó</h1>
      <p class="jg-stats"><span>Tú: <b data-score-me>0</b></span><span>Computadora: <b data-score-cpu>0</b></span><span>Partida a 100</span></p>
      <div class="dm-cpu"><span>Computadora</span><span class="dm-backs" data-cpu></span></div>
      <div class="dm-table" data-table aria-label="Mesa"></div>
      <p class="jg-msg" aria-live="polite" data-msg></p>
      <div class="dm-ends" data-ends hidden>
        <button type="button" class="jg-btn" data-end="L">◀ Poner a la izquierda</button>
        <button type="button" class="jg-btn" data-end="R">Poner a la derecha ▶</button>
      </div>
      <div class="dm-hand" data-hand aria-label="Tus fichas"></div>
      <div class="dm-actions">
        <button type="button" class="tool" data-draw>Robar (<span data-pile>0</span>)</button>
        <button type="button" class="tool" data-pass>Pasar</button>
        <button type="button" class="jg-btn" data-next hidden>Siguiente mano</button>
      </div>
      <p class="jg-help">Toca una ficha que tenga el mismo número que una de las puntas de la mesa. Si no tienes jugada, roba del montón; si se acaba, pasa.</p>
    </div>
    </GameLayout>
  </main>
  <script>
    type Tile = [number, number];
    const box = document.querySelector<HTMLElement>('[data-domino]')!;
    const $ = (s: string) => box.querySelector<HTMLElement>(s)!;
    const PIPS: Record<number, number[]> = { 0: [], 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };
    const half = (n: number) => `<span class="dm-half">${[...Array(9)].map((_, i) => `<i${PIPS[n].includes(i) ? ' class="on"' : ''}></i>`).join('')}</span>`;
    const tileHTML = (t: Tile, vertical = false) => `<span class="dm-tile${vertical ? ' v' : ''}${t[0] === t[1] ? ' dbl' : ''}" aria-label="Ficha ${t[0]} y ${t[1]}">${half(t[0])}${half(t[1])}</span>`;
    const pips = (h: Tile[]) => h.reduce((s, t) => s + t[0] + t[1], 0);

    let score = { me: 0, cpu: 0 };
    let me: Tile[] = [], cpu: Tile[] = [], pile: Tile[] = [], line: Tile[] = [], turn: 'me' | 'cpu' = 'me', passes = 0, over = false, pick = -1;
    const ends = () => (line.length ? [line[0][0], line[line.length - 1][1]] : [-1, -1]);
    const fits = (t: Tile) => { if (!line.length) return ['L']; const [l, r] = ends(); const o: string[] = []; if (t[0] === l || t[1] === l) o.push('L'); if (t[0] === r || t[1] === r) o.push('R'); return o; };
    function place(t: Tile, side: string) {
      if (!line.length) { line.push(t); return; }
      const [l, r] = ends();
      if (side === 'L') line.unshift(t[1] === l ? t : [t[1], t[0]]);
      else line.push(t[0] === r ? t : [t[1], t[0]]);
    }
    function deal() {
      const all: Tile[] = []; for (let a = 0; a <= 6; a++) for (let b = a; b <= 6; b++) all.push([a, b]);
      for (let i = all.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [all[i], all[j]] = [all[j], all[i]]; }
      me = all.slice(0, 7); cpu = all.slice(7, 14); pile = all.slice(14); line = []; passes = 0; over = false; pick = -1;
      // Whoever holds the highest double starts
      const best = (h: Tile[]) => Math.max(-1, ...h.filter((t) => t[0] === t[1]).map((t) => t[0]));
      turn = best(me) >= best(cpu) ? 'me' : 'cpu';
      $('[data-next]').hidden = true;
      say(turn === 'me' ? 'Empiezas tú. Juega cualquier ficha.' : 'Empieza la computadora…');
      render();
      if (turn === 'cpu') setTimeout(cpuTurn, 900);
    }
    function say(t: string) { $('[data-msg]').textContent = t; }
    function render() {
      $('[data-table]').innerHTML = line.length ? line.map((t) => tileHTML(t, t[0] === t[1])).join('') : '<span class="dm-empty">La mesa está vacía</span>';
      $('[data-cpu]').innerHTML = cpu.map(() => '<i></i>').join('') + ` <b>${cpu.length}</b>`;
      $('[data-pile]').textContent = String(pile.length);
      const hand = $('[data-hand]'); hand.innerHTML = '';
      me.forEach((t, i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'dm-pick'; b.innerHTML = tileHTML(t);
        const can = turn === 'me' && !over && fits(t).length > 0;
        b.disabled = !can; if (i === pick) b.classList.add('sel');
        b.addEventListener('click', () => choose(i));
        hand.append(b);
      });
      const canPlay = me.some((t) => fits(t).length);
      (box.querySelector('[data-draw]') as HTMLButtonElement).disabled = turn !== 'me' || over || canPlay || !pile.length;
      (box.querySelector('[data-pass]') as HTMLButtonElement).disabled = turn !== 'me' || over || canPlay || pile.length > 0;
      $('[data-ends]').hidden = pick < 0;
      $('[data-score-me]').textContent = String(score.me); $('[data-score-cpu]').textContent = String(score.cpu);
    }
    function choose(i: number) {
      const opts = fits(me[i]);
      if (opts.length === 2 && ends()[0] !== ends()[1]) { pick = i; say('¿De qué lado la pones?'); render(); return; }
      play(i, opts[0]);
    }
    function play(i: number, side: string) {
      place(me[i], side); me.splice(i, 1); pick = -1; passes = 0;
      if (!me.length) return endRound('me');
      turn = 'cpu'; say('Juega la computadora…'); render(); setTimeout(cpuTurn, 900);
    }
    function cpuTurn() {
      if (over) return;
      let opts = cpu.map((t, i) => ({ t, i, sides: fits(t) })).filter((x) => x.sides.length);
      while (!opts.length && pile.length) { cpu.push(pile.pop()!); opts = cpu.map((t, i) => ({ t, i, sides: fits(t) })).filter((x) => x.sides.length); }
      if (!opts.length) {
        passes++; say('La computadora pasa. Te toca.');
        if (passes >= 2) return endRound(null);
      } else {
        opts.sort((a, b) => b.t[0] + b.t[1] - (a.t[0] + a.t[1])); // heaviest tile first
        const { t, i, sides } = opts[0];
        place(t, sides[0]); cpu.splice(i, 1); passes = 0;
        if (!cpu.length) { render(); return endRound('cpu'); }
        say(`La computadora jugó el ${t[0]}-${t[1]}. Te toca.`);
      }
      turn = 'me'; render();
    }
    function endRound(winner: 'me' | 'cpu' | null) {
      over = true;
      if (!winner) winner = pips(me) <= pips(cpu) ? 'me' : 'cpu'; // blocked game: fewest points wins
      const pts = winner === 'me' ? pips(cpu) : pips(me);
      score[winner] += pts;
      const matchOver = score[winner] >= 100;
      say(`${winner === 'me' ? '¡Ganaste la mano!' : 'La computadora ganó la mano.'} +${pts} puntos.${matchOver ? (winner === 'me' ? ' ¡Ganaste la partida! 🎉' : ' La computadora ganó la partida.') : ''}`);
      if (matchOver) { try { if (winner === 'me') localStorage.setItem('nx-domino-wins', String(Number(localStorage.getItem('nx-domino-wins') || 0) + 1)); } catch { /* storage blocked */ } }
      const next = $('[data-next]'); next.hidden = false; next.textContent = matchOver ? 'Nueva partida' : 'Siguiente mano';
      next.onclick = () => { if (matchOver) score = { me: 0, cpu: 0 }; deal(); };
      render();
    }
    box.querySelectorAll<HTMLButtonElement>('[data-end]').forEach((b) => b.addEventListener('click', () => { if (pick >= 0) play(pick, b.dataset.end!); }));
    $('[data-draw]').addEventListener('click', () => { if (pile.length) { me.push(pile.pop()!); say(me.some((t) => fits(t).length) ? 'Ahora sí tienes jugada.' : 'Sigue robando.'); render(); } });
    $('[data-pass]').addEventListener('click', () => { passes++; if (passes >= 2) return endRound(null); turn = 'cpu'; say('Pasaste. Juega la computadora…'); render(); setTimeout(cpuTurn, 900); });
    deal();
  </script>
</Base>
