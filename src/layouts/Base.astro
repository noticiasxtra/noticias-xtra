---
import '../styles/global.css';
import { SITE, SECTIONS, url } from '../lib/site';
import { getBreaking } from '../lib/breaking';
import AdSlot from '../components/AdSlot.astro';
import Logo from '../components/Logo.astro';
import { holidayOn, todayPR } from '../lib/holidays';

interface Props {
  title?: string;
  description?: string;
  active?: string; // nav item to highlight: 'home', a section id, or 'videos'
  image?: string;
  article?: { published: Date; section: string };
  noindex?: boolean; // internal pages: ask search engines not to list them
}
const { title, description = SITE.description, active, image, article, noindex } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Local images ('images/x.jpg') need the base path; full URLs are used as-is
const ogImage = new URL(image ? (image.startsWith('http') ? image : url(image)) : url('icon-512.png'), Astro.site).toString();
const half = Math.ceil(SECTIONS.length / 2);
const F = SITE.features;
// Deportes and Entretenimiento pages skip the red bar, except for a real ÚLTIMA HORA alert
const quietBar = active === 'deportes' || active === 'entretenimiento';
const bar = await getBreaking();
const breaking = quietBar && bar?.label !== 'ÚLTIMA HORA' ? null : bar;
const today = new Date().toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Puerto_Rico' });
const todayCap = today.charAt(0).toUpperCase() + today.slice(1);
// Holiday logo: automatic by date, never during an ÚLTIMA HORA alert (a festive logo next to bad news looks wrong)
const holiday = F.holidayLogo && bar?.label !== 'ÚLTIMA HORA' ? holidayOn(todayPR()) : undefined;
---
<!doctype html>
<html lang="es" data-theme={active === 'deportes' ? 'dark' : undefined} data-force-dark={active === 'deportes' ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2B1185" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="es_PR" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Theme before the page paints (no white flash). Automatic by Puerto Rico time: dark from 7 p.m. to 6 a.m.,
      // light during the day. A reader's switch in the profile menu lasts until the next automatic change.
      // Sports pages are always dark (data-force-dark).
      (function () {
        var h = (new Date().getUTCHours() + 20) % 24; // Puerto Rico is UTC-4 all year
        var auto = h >= 19 || h < 6 ? 'dark' : 'light';
        var t = null;
        try { var m = JSON.parse(localStorage.getItem('nx-theme-manual') || 'null'); if (m && Date.now() < m.until) t = m.theme; localStorage.removeItem('nx-theme'); } catch (e) {}
        if (!document.documentElement.hasAttribute('data-force-dark')) document.documentElement.dataset.theme = t || auto;
      })();
      // Reader's text size for stories (set on the story page), applied before paint
      try { var f = [0.9, 1, 1.12, 1.25, 1.4][JSON.parse(localStorage.getItem('nx-font') || '1')]; if (f) document.documentElement.style.setProperty('--read-scale', f); } catch (e) {}
    </script>
  </head>
  <body data-base={url()}>
    {SITE.demoMode && <div class="demo">Sitio de demostración. Las noticias que aparecen son ejemplos.</div>}
    <header class="masthead">
      <div class="wrap">
        <Logo holiday={holiday} />
        {/* Today's date beside the logo (wide screens; phones see it in the profile menu) */}
        <time class="mh-date" datetime={new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' })}>{todayCap}</time>
        <form class="search" role="search" action={url('buscar')} method="get">
          <label for="q" class="sr">Buscar noticias</label>
          <input id="q" name="q" type="search" placeholder="Buscar noticias" />
          <button type="submit" aria-label="Buscar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
          </button>
        </form>
        <div class="mh-right">
          {/* Live button, then two icons: search (phones) and the profile menu with every reader setting */}
          {F.live && <a href={url('en-vivo')} class="live-btn" aria-current={active === 'en-vivo' ? 'page' : undefined}><span class="dot" aria-hidden="true"></span>En vivo</a>}
          <div class="mh-icons">
            <a href={url('buscar')} class="mh-ico search-btn" aria-label="Buscar noticias">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
            </a>
            <div class="pf-wrap">
              <button type="button" class="mh-ico pf-btn" data-pf-btn data-pf-toggle aria-haspopup="true" aria-expanded="false" aria-controls="pf-menu" aria-label="Mi cuenta y ajustes" title="Mi cuenta y ajustes">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
              </button>
              <span class="pf-dot" data-nf-dot hidden></span>
              <div class="pf-menu" id="pf-menu" data-pf-menu hidden>
                <div class="pf-menu-h">
                  <span class="pf-menu-av" data-pf-av aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg></span>
                  <span><b data-pf-name>Mi cuenta</b><small>{todayCap}</small></span>
                </div>
                <button type="button" class="pf-menu-i" data-nf-toggle aria-expanded="false" aria-controls="nf-panel">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z" /><path d="M10 21h4" /></svg>Notificaciones
                  <span class="pf-badge red" data-nf-count hidden></span>
                </button>
                <div class="nf-panel" id="nf-panel" data-nf-panel data-story-url={url('noticias')} data-game-url={url('juegos/domino')} hidden>
                  <ul class="nf-list" data-nf-list></ul>
                  <div class="nf-foot"><button type="button" data-nf-readall>Marcar como leídas</button><a href={`${url('perfil')}#notificaciones`}>Ver todas ›</a></div>
                </div>
                {/* Staff only: shown once someone has logged into the staff panel on this device */}
                <a class="pf-menu-i pf-staff" href={url('redaccion')} data-staff-link hidden>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M8 14h3M8 17h6" /></svg>Panel de la redacción
                  <span class="pf-badge red" data-staff-count hidden></span>
                </a>
                <a class="pf-menu-i" href={url('perfil')}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>Mi perfil
                </a>
                <a class="pf-menu-i" href={url('guardadas')}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z" /></svg>Noticias guardadas
                  <span class="pf-badge" data-saved-count hidden></span>
                </a>
                <button type="button" class="pf-menu-i notranslate" translate="no" data-translate aria-label="Read this page in English">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h10M8 3v2M5.5 5c.6 3.6 3 6.6 6.5 8.3M10.5 5c-.8 4-3.4 7.2-7.5 9"/><path d="M13 21l4.2-10L21.4 21M14.6 17.5h5.2"/></svg>
                  <span data-lang-label>English</span>
                  <span class="lang-tag" data-lang-tag>EN</span>
                </button>
                <button type="button" class="pf-menu-i" data-theme-toggle aria-pressed="false">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>Modo oscuro
                  <span class="pf-switch" aria-hidden="true"></span>
                </button>
                <a class="pf-menu-i" href={`${url('juegos')}#puntos`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" /></svg>Puntos de juegos
                  <span class="pf-pts" data-pts-total>0</span>
                </a>
                <a class="pf-menu-i" href={url('contacto')}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z" /><path d="M12 7v4M12 13.5h.01" /></svg>Envía tu denuncia
                </a>
                <hr />
                <a class="pf-menu-i" href={url('publicidad/panel')}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>Panel de anunciante
                </a>
                <a class="pf-menu-i" href={url('publicidad')}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11v2l13 5V6L3 11z" /><path d="M16 9a3 3 0 0 1 0 6" /></svg>Anúnciate
                </a>
              </div>
            </div>
          </div>
          <a class="mh-ad-btn" href={url('publicidad')}>Anúnciate</a>
        </div>
      </div>
    </header>

    <nav class="nav" aria-label="Secciones">
      <div class="wrap">
        <a href={url()} class="nav-logo" tabindex="-1" aria-hidden="true"><img src={url('logo.svg')} alt="" width="80" height="30" /></a>
        <div class="nav-links">
          <a class="nav-ad" href={url('publicidad')}>Anúnciate</a>
          <a href={url()} aria-current={active === 'home' ? 'page' : undefined}>Portada</a>
          {SECTIONS.map((s) => (
            <a href={url(`seccion/${s.id}`)} aria-current={active === s.id ? 'page' : undefined}>{s.name}</a>
          ))}
        </div>
      </div>
    </nav>
    <script is:inline>
      // Phones: the section menu scrolls sideways. Keep it where the reader left it when they open another section,
      // and make sure the current section is in view (runs right away so the menu doesn't jump).
      (function () {
        var bar = document.querySelector('.nav .wrap');
        if (!bar) return;
        try { var x = sessionStorage.getItem('nx-nav-x'); if (x) bar.scrollLeft = +x; } catch (e) { /* storage blocked */ }
        var cur = bar.querySelector('[aria-current="page"]');
        if (cur) {
          var b = bar.getBoundingClientRect(), r = cur.getBoundingClientRect();
          if (r.left < b.left || r.right > b.right) bar.scrollLeft += r.left - b.left - (b.width - r.width) / 2;
        }
        bar.addEventListener('click', function () { try { sessionStorage.setItem('nx-nav-x', String(bar.scrollLeft)); } catch (e) { /* storage blocked */ } });
        // Phones lock the logo bar on top; the menu sits right under it
        var mast = document.querySelector('.masthead');
        var setH = function () { if (mast) document.documentElement.style.setProperty('--mh-h', mast.offsetHeight + 'px'); };
        setH(); addEventListener('resize', setH);
      })();
    </script>

    {breaking && (
      <div class="breaking">
        <div class="wrap"><b>{breaking.label}</b><a href={url(`noticia/${breaking.id}`)}>{breaking.text}</a></div>
      </div>
    )}

    <slot />

    <div class="wrap"><AdSlot size="leaderboard" class="ad-bottom" /></div>
    <footer>
      <div class="wrap">
        <div>
          <a href={url()} class="flogo" aria-label={SITE.name}><img src={url('logo.svg')} alt="" /></a>
          <p>Noticias de Puerto Rico, Estados Unidos y el mundo: gobierno, política, economía, deportes y más.</p>
        </div>
        <div><h4>Secciones</h4><ul>{SECTIONS.slice(0, half).map((s) => <li><a href={url(`seccion/${s.id}`)}>{s.name}</a></li>)}</ul></div>
        <div><h4>Más secciones</h4><ul>{SECTIONS.slice(half).map((s) => <li><a href={url(`seccion/${s.id}`)}>{s.name}</a></li>)}</ul></div>
        <div>
          <h4>{SITE.name}</h4>
          <ul>
            {F.live && <li><a href={url('en-vivo')}>Ver en vivo</a></li>}
            {F.videos && <li><a href={url('videos')}>Videos</a></li>}
            <li><a href={url('juegos')}>Juegos Xtra</a></li>
            <li><a href={url('foro')}>Foro Xtra</a></li>
            <li><a href={url('perfil')}>Mi perfil</a></li>
            <li><a href={url('horoscopo')}>Horóscopo</a></li>
            <li><a href={url('quienes-somos')}>Quiénes somos</a></li>
            <li><a href={url('normas-editoriales')}>Normas editoriales y correcciones</a></li>
            <li><a href={url('ia')}>Cómo usamos la IA</a></li>
            <li><a href={url('privacidad')}>Política de privacidad</a></li>
            <li><a href={url('contacto')}>Envía tu denuncia</a></li>
            <li><a href={url('publicidad')}>Anúnciate con nosotros</a></li>
          </ul>
        </div>
      </div>
      <div class="legal"><div class="wrap">© {new Date().getFullYear()} {SITE.name}.{SITE.demoMode && ' Sitio de demostración con contenido de ejemplo.'}</div></div>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import { seedExamples, unreadCount, getNotifs, markRead, type Notif } from '../lib/notifications';
      import { renderNotifs, sentence } from '../lib/notif-view';
      // Profile menu: every reader setting in one place, opens over the page (Escape or a tap outside closes it)
      const pfBtn = document.querySelector<HTMLButtonElement>('[data-pf-toggle]');
      const pfMenu = document.querySelector<HTMLElement>('[data-pf-menu]');
      if (pfBtn && pfMenu) {
        const setOpen = (open: boolean) => { pfMenu.hidden = !open; pfBtn.setAttribute('aria-expanded', String(open)); };
        pfBtn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(pfMenu.hidden); if (!pfMenu.hidden) pfMenu.querySelector<HTMLElement>('a,button')?.focus({ preventScroll: true }); });
        document.addEventListener('click', (e) => { if (!pfMenu.hidden && !pfMenu.contains(e.target as Node)) setOpen(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pfMenu.hidden) { setOpen(false); pfBtn.focus(); } });
      }

      // Dark mode switch (remembered in this browser)
      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      // Sports pages are always dark, so the switch is hidden there
      if (themeBtn && document.documentElement.hasAttribute('data-force-dark')) themeBtn.hidden = true;
      else if (themeBtn) {
        const sync = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          themeBtn.setAttribute('aria-pressed', String(dark));
        };
        sync();
        // Next automatic change: 6 a.m. or 7 p.m. Puerto Rico time (UTC-4)
        const nextSwitch = () => {
          const pr = new Date(Date.now() - 4 * 36e5); const h = pr.getUTCHours();
          const at = h < 6 ? 6 : h < 19 ? 19 : 30; // 30 = tomorrow 6 a.m.
          return Date.UTC(pr.getUTCFullYear(), pr.getUTCMonth(), pr.getUTCDate(), at + 4);
        };
        const autoTheme = () => { const h = (new Date().getUTCHours() + 20) % 24; return h >= 19 || h < 6 ? 'dark' : 'light'; };
        themeBtn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('nx-theme-manual', JSON.stringify({ theme: next, until: nextSwitch() })); } catch { /* storage blocked */ }
          sync();
        });
        // Switch by itself at 6 a.m. / 7 p.m. while the page is open (unless the reader chose otherwise)
        setInterval(() => {
          let manual = false;
          try { const m = JSON.parse(localStorage.getItem('nx-theme-manual') || 'null'); manual = !!m && Date.now() < m.until; } catch { /* storage blocked */ }
          if (!manual && document.documentElement.dataset.theme !== autoTheme()) { document.documentElement.dataset.theme = autoTheme(); sync(); }
        }, 60000);
      }

      // English: the page is translated in place by Google's translation tool, with Google's bar and pop-ups hidden.
      // The tool loads only after a reader taps EN; the choice is remembered (localStorage 'nx-lang' and Google's
      // 'googtrans' cookie), so every page they open stays in English until they tap ES.
      // Readers who arrive on Google's translated copy (*.translate.goog) get an ES button back to the original.
      const langBtns = document.querySelectorAll<HTMLElement>('[data-translate]');
      const setTag = (t: string, label: string) => langBtns.forEach((a) => {
        const tag = a.querySelector('[data-lang-tag]'); if (tag) tag.textContent = t;
        const lbl = a.querySelector('[data-lang-label]'); if (lbl) lbl.textContent = t === 'EN' ? 'English' : 'Español';
        a.setAttribute('aria-label', label); a.title = label;
      });
      const setCookie = (v: string | null) => {
        const base = v ? `googtrans=${v}; path=/` : 'googtrans=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = base;
        if (location.hostname.includes('.')) document.cookie = `${base}; domain=${location.hostname}`;
      };
      const getLang = () => { try { return localStorage.getItem('nx-lang'); } catch { return null; } };
      const putLang = (v: string | null) => { try { v ? localStorage.setItem('nx-lang', v) : localStorage.removeItem('nx-lang'); } catch { /* storage blocked */ } };
      let gtLoaded = false;
      function loadTranslator() {
        if (gtLoaded) return; gtLoaded = true;
        document.documentElement.classList.add('nx-en');
        const el = document.createElement('div'); el.id = 'gt-el'; el.hidden = true; document.body.append(el);
        (window as any).nxGT = () => {
          const g = (window as any).google;
          new g.translate.TranslateElement({ pageLanguage: 'es', includedLanguages: 'en', autoDisplay: false }, 'gt-el');
          // Pick English in Google's hidden menu (it may already show English but still needs the change event to start)
          const pick = (n = 0) => {
            const sel = document.querySelector<HTMLSelectElement>('.goog-te-combo');
            if (sel && sel.options.length > 1) { sel.value = 'en'; sel.dispatchEvent(new Event('change')); }
            else if (n < 40) setTimeout(() => pick(n + 1), 150);
          };
          pick();
        };
        const sc = document.createElement('script');
        sc.src = 'https://translate.google.com/translate_a/element.js?cb=nxGT';
        sc.onerror = () => { gtLoaded = false; document.documentElement.classList.remove('nx-en'); putLang(null); setCookie(null); setTag('EN', 'Read this page in English'); toast('No se pudo cargar la traducción. Intenta otra vez.'); };
        document.body.append(sc);
      }
      if (location.hostname.endsWith('.translate.goog')) {
        const orig = location.hostname.replace(/\.translate\.goog$/, '').replace(/--/g, '\u0000').replace(/-/g, '.').replace(/\u0000/g, '-');
        const q = new URLSearchParams(location.search); [...q.keys()].filter((k) => k.startsWith('_x_tr_')).forEach((k) => q.delete(k));
        const back = `https://${orig}${location.pathname}${q.toString() ? `?${q}` : ''}`;
        langBtns.forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); location.href = back; }));
        setTag('ES', 'Leer en español');
      } else {
        if (getLang() === 'en') { setTag('ES', 'Leer en español'); loadTranslator(); }
        langBtns.forEach((a) => a.addEventListener('click', (e) => {
          e.preventDefault();
          if (getLang() === 'en') { // back to Spanish: forget the choice and show the original page
            putLang(null); setCookie(null); location.reload();
          } else {
            putLang('en'); setCookie('/es/en'); setTag('ES', 'Leer en español'); loadTranslator();
          }
        }));
      }

      // When the masthead scrolls away, the sticky menu shows a small logo beside the sections
      const mast = document.querySelector('.masthead');
      const navBar = document.querySelector('.nav');
      if (mast && navBar && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => navBar.classList.toggle('stuck', !e.isIntersecting)).observe(mast);
      }

      // Relative times: "Hace 2 horas"
      function relTimes() {
        const now = Date.now();
        document.querySelectorAll<HTMLTimeElement>('time[data-rel]').forEach((t) => {
          const h = Math.floor((now - new Date(t.dateTime).getTime()) / 36e5);
          if (h < 0) return;
          if (h < 1) t.textContent = 'Hace minutos';
          else if (h < 24) t.textContent = `Hace ${h} ${h === 1 ? 'hora' : 'horas'}`;
        });
      }
      relTimes();

      const toastEl = document.getElementById('toast')!;
      let toastTimer: number | undefined;
      function toast(msg: string) {
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2600);
      }

      document.querySelectorAll<HTMLElement>('[data-app]').forEach((b) =>
        b.addEventListener('click', (e) => { e.preventDefault(); toast('La app estará disponible próximamente.'); }),
      );
      document.querySelectorAll<HTMLElement>('[data-play]').forEach((b) =>
        b.addEventListener('click', () => toast('Video de demostración. Aquí se reproducirá el contenido real.')),
      );

      // Share buttons
      // Profile button: shows the reader's initial once they sign in (demo profile in localStorage 'nx-profile')
      const showProfile = () => {
        let p: { name?: string; color?: string; photo?: string } = {};
        try { p = JSON.parse(localStorage.getItem('nx-profile') || '{}'); } catch { /* storage blocked */ }
        document.querySelectorAll<HTMLElement>('[data-pf-btn]').forEach((b) => {
          b.dataset.icon ??= b.innerHTML;
          b.classList.toggle('in', !!p.name);
          b.style.background = p.name ? p.color || '#2B1185' : '';
          b.style.backgroundImage = p.name && p.photo ? `url("${p.photo}")` : '';
          b.classList.toggle('has-photo', !!(p.name && p.photo));
          if (p.name) b.textContent = p.photo ? '' : p.name[0].toUpperCase(); else b.innerHTML = b.dataset.icon;
          b.title = p.name ? `Mi cuenta: ${p.name}` : 'Mi cuenta y ajustes';
        });
        const nm = document.querySelector<HTMLElement>('[data-pf-name]'), av = document.querySelector<HTMLElement>('[data-pf-av]');
        if (nm) nm.textContent = p.name || 'Mi cuenta';
        if (av) {
          av.dataset.icon ??= av.innerHTML; av.style.background = p.name ? p.color || '#2B1185' : ''; av.style.color = p.name ? '#fff' : '';
          av.style.backgroundImage = p.name && p.photo ? `url("${p.photo}")` : ''; av.classList.toggle('has-photo', !!(p.name && p.photo));
          if (p.name) av.textContent = p.photo ? '' : p.name[0].toUpperCase(); else av.innerHTML = av.dataset.icon;
        }
      };
      showProfile();
      addEventListener('nx-profile-change', showProfile);
      // Juegos Xtra points: total in the profile menu, and a "+N puntos" toast when a game awards points
      const showPts = () => {
        let t = 0; try { t = JSON.parse(localStorage.getItem('nx-points') || '{}').total || 0; } catch { /* storage blocked */ }
        document.querySelectorAll<HTMLElement>('[data-pts-total]').forEach((el) => (el.textContent = t.toLocaleString('es-PR')));
      };
      showPts();
      addEventListener('nx-points', (e) => { showPts(); const d = (e as CustomEvent).detail; toast(`⭐ +${d.added} puntos · ${d.why}`); });
      addEventListener('storage', (e) => e.key === 'nx-points' && showPts());
      // Saved stories counter in the header (list kept only in this browser, key 'nx-saved')
      const showSaved = () => {
        let n = 0;
        try { n = JSON.parse(localStorage.getItem('nx-saved') || '[]').length; } catch { /* storage blocked */ }
        document.querySelectorAll<HTMLElement>('[data-saved-count]').forEach((el) => { el.textContent = String(n); el.hidden = !n; });
      };
      showSaved();
      addEventListener('nx-saved-change', showSaved);
      addEventListener('storage', (e) => e.key === 'nx-saved' && showSaved());
      // Staff panel link: only for people who logged into /redaccion/ on this device (preview login, 'nx-staff')
      const showStaff = () => {
        let staff = false, n = 0;
        try { staff = !!localStorage.getItem('nx-staff'); n = Number(localStorage.getItem('nx-staff-pending') || 0); } catch { /* storage blocked */ }
        document.querySelectorAll<HTMLElement>('[data-staff-link]').forEach((a) => (a.hidden = !staff));
        document.querySelectorAll<HTMLElement>('[data-staff-count]').forEach((b) => { b.textContent = String(n); b.hidden = !staff || !n; });
      };
      showStaff();
      addEventListener('nx-staff-change', showStaff);
      addEventListener('storage', (e) => (e.key === 'nx-staff' || e.key === 'nx-staff-pending') && showStaff());
      // Notifications: count on the profile icon, latest five in the profile menu, a toast when a new one arrives
      const nfPanel = document.querySelector<HTMLElement>('[data-nf-panel]');
      if (nfPanel) {
        seedExamples(nfPanel.dataset.storyUrl!, nfPanel.dataset.gameUrl!);
        const nfBtn = document.querySelector<HTMLButtonElement>('[data-nf-toggle]')!;
        const showNotifs = () => {
          const n = unreadCount();
          document.querySelectorAll<HTMLElement>('[data-nf-dot],[data-nf-count]').forEach((el) => { el.textContent = n > 9 ? '9+' : String(n); el.hidden = !n; });
          pfBtn?.setAttribute('aria-label', n ? `Mi cuenta y ajustes: ${n} notificaciones nuevas` : 'Mi cuenta y ajustes');
          nfPanel.querySelector('[data-nf-list]')!.innerHTML = renderNotifs(getNotifs().slice(0, 5)) || '<li class="nf-empty">No tienes notificaciones.</li>';
        };
        showNotifs();
        nfBtn.addEventListener('click', () => { nfPanel.hidden = !nfPanel.hidden; nfBtn.setAttribute('aria-expanded', String(!nfPanel.hidden)); });
        nfPanel.querySelector('[data-nf-readall]')!.addEventListener('click', () => markRead());
        nfPanel.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest<HTMLElement>('[data-nf-id]'); if (a) markRead(a.dataset.nfId); });
        addEventListener('nx-notifs', (e) => {
          showNotifs();
          const n = (e as CustomEvent).detail?.added as Notif | undefined;
          if (n) toast(`🔔 ${sentence(n)}`);
        });
        addEventListener('storage', (e) => e.key === 'nx-notifs' && showNotifs());
      }
      document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) =>
        b.addEventListener('click', async () => {
          const u = encodeURIComponent(location.href);
          const t = encodeURIComponent(document.title);
          const kind = b.dataset.share;
          if (kind === 'copy') {
            try { await navigator.clipboard.writeText(location.href); toast('Enlace copiado'); }
            catch { toast('Copia el enlace desde la barra del navegador'); }
          }
          if (kind === 'facebook') window.open(`https://www.facebook.com/sharer/sharer.php?u=${u}`, '_blank', 'noopener');
          if (kind === 'whatsapp') window.open(`https://wa.me/?text=${t}%20${u}`, '_blank', 'noopener');
        }),
      );

      // Newsletter (demo only: nothing is sent yet)
      document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((f) => {
        const input = f.querySelector('input')!;
        const err = f.querySelector<HTMLElement>('.err')!;
        input.addEventListener('input', () => (err.hidden = true));
        f.addEventListener('submit', (e) => {
          e.preventDefault();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())) {
            err.textContent = 'Escribe un correo válido, por ejemplo nombre@correo.com.';
            err.hidden = false;
            input.focus();
            return;
          }
          f.hidden = true;
          (f.nextElementSibling as HTMLElement).hidden = false;
        });
      });

      // Tip form (validates, then hands the message to the reader's email app)
      const tip = document.querySelector<HTMLFormElement>('form[data-tip]');
      if (tip) {
        const msg = tip.querySelector('textarea')!;
        const err = tip.querySelector<HTMLElement>('.err')!;
        const ok = tip.querySelector<HTMLElement>('.ok')!;
        msg.addEventListener('input', () => (err.hidden = true));
        tip.addEventListener('submit', (e) => {
          e.preventDefault();
          if (msg.value.trim().length < 10) {
            err.textContent = 'Describe lo que está pasando en al menos una oración.';
            err.hidden = false;
            msg.focus();
            return;
          }
          const to = tip.dataset.tip;
          if (!to) return;
          const town = tip.querySelector<HTMLInputElement>('#tipTown')!.value.trim();
          const contact = tip.querySelector<HTMLInputElement>('#tipContact')!.value.trim();
          const body = [msg.value.trim(), town && `Pueblo: ${town}`, contact && `Contacto: ${contact}`].filter(Boolean).join('\n\n');
          location.href = `mailto:${to}?subject=${encodeURIComponent('Denuncia para Noticias Xtra')}&body=${encodeURIComponent(body)}`;
          ok.hidden = false;
        });
      }
    </script>
  </body>
</html>
