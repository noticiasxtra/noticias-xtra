---
// Full-document viewer for the document cards in stories (src/lib/doccard.mjs): on computers the PDF opens over
// the page with the browser's own viewer (zoom, search, print); on phones the link opens the phone's PDF viewer,
// which handles long documents better than a frame. Download and "new tab" are always offered.
---
<dialog class="docv" data-docv aria-labelledby="docv-t">
  <div class="docv-bar">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
    <b id="docv-t" data-docv-t></b>
    <a class="docv-btn" data-docv-dl download>Descargar</a>
    <a class="docv-btn" data-docv-tab target="_blank" rel="noopener">Abrir aparte ↗</a>
    <button type="button" class="docv-x" data-docv-x aria-label="Cerrar documento">✕</button>
  </div>
  <iframe data-docv-frame title="Documento"></iframe>
</dialog>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-docv]');
  if (dlg) {
    const frame = dlg.querySelector<HTMLIFrameElement>('[data-docv-frame]')!;
    const small = () => matchMedia('(max-width: 760px)').matches || /iPhone|iPad|Android/i.test(navigator.userAgent);
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.doc-open');
      if (!a || small() || e.metaKey || e.ctrlKey) return; // phones and "open in new tab" keep the normal link
      e.preventDefault();
      dlg.querySelector('[data-docv-t]')!.textContent = a.dataset.docTitle || 'Documento';
      dlg.querySelector<HTMLAnchorElement>('[data-docv-dl]')!.href = a.href;
      dlg.querySelector<HTMLAnchorElement>('[data-docv-tab]')!.href = a.href;
      frame.src = a.href; dlg.showModal();
    });
    dlg.querySelector('[data-docv-x]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => (frame.src = 'about:blank'));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // tap outside closes
  }
</script>
