---
// Article editor (staff panel → Escribir), close to WordPress: title, subtitle, featured photo with caption and credit,
// a formatted body (subheadings, bold, italic, links, lists, quotes, separators, photos, embeds from YouTube, X,
// Instagram, Facebook, TikTok, Spotify and Google Maps), section, place, author, publish date and time (schedule),
// labels for editors, sources, related stories and corrections; live preview and a pre-publish checklist.
// The output is the same Markdown story file the site already uses (src/content/noticias/, see content.config.ts).
// Periodistas send to review; editors and the admin publish or schedule.
// With Supabase connected (src/lib/backend.ts), articles are shared by the team (table `articles`, supabase/articles.sql),
// photos and PDFs go to the "noticias" storage bucket, and Publicar/Aprobar call the "publicar" Edge Function
// (supabase/functions/publicar/), which saves the story file in GitHub so the site rebuilds in about 2 minutes.
// Without Supabase it's a preview: articles stay on this device ('nx-articles') and can be downloaded as story files.
import { SECTIONS, PR_MUNICIPIOS, url } from '../../lib/site';
import { LEAGUES } from '../../lib/leagues';
import AiDraft from './AiDraft.astro';
type Pub = { id: string; title: string; section: string; author: string; date: string; url: string; ai: boolean };
interface Props { recent: Array<{ id: string; title: string }>; published: Pub[] }
const { recent, published } = Astro.props;
const secs = SECTIONS.map(({ id, name }) => ({ id, name }));
const leagues = LEAGUES.map(({ id, name }) => ({ id, name }));
const I = (d: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const TOOLS = [
  ['bold', 'Negrita (Ctrl+B)', '<path d="M7 5h6a3.5 3.5 0 0 1 0 7H7zM7 12h7a3.5 3.5 0 0 1 0 7H7z"/>'],
  ['italic', 'Cursiva (Ctrl+I)', '<path d="M11 5h6M7 19h6M14 5l-4 14"/>'],
  ['link', 'Enlace', '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>'],
  ['ul', 'Lista', '<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="18" r="1"/>'],
  ['ol', 'Lista numerada', '<path d="M10 6h10M10 12h10M10 18h10M4 5l1.5-1V9M3.5 13.5a1.5 1.5 0 0 1 2.6 1L3.5 18h3"/>'],
  ['quote', 'Cita', '<path d="M7 7h4v5c0 3-2 5-4 5M15 7h4v5c0 3-2 5-4 5"/>'],
  ['hr', 'Línea separadora', '<path d="M3 12h18"/>'],
  ['image', 'Foto', '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 8"/>'],
  ['embed', 'Insertar video o publicación', '<path d="M8 8l-5 4 5 4M16 8l5 4-5 4M13.5 5l-3 14"/>'],
  ['doc', 'Documento (PDF)', '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>'],
  ['undo', 'Deshacer (Ctrl+Z)', '<path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>'],
  ['redo', 'Rehacer', '<path d="M15 14l5-5-5-5"/><path d="M20 9H10a6 6 0 0 0 0 12h3"/>'],
  ['clear', 'Quitar formato', '<path d="M6 5h12M12 5l-3 14M4 20L20 4"/>'],
];
---
<section class="wr" data-wr data-secs={JSON.stringify(secs)} data-recent={JSON.stringify(recent)} data-published={JSON.stringify(published)} data-base={url()}>
  <!-- List of my articles -->
  <div data-wr-list-view>
    <header class="sd-head">
      <div><h1 class="pnl-h">Escribir</h1><p class="pnl-muted">Escribe y edita noticias como en WordPress. Los periodistas las envían a revisión; los editores las publican o las programan.</p></div>
      <span class="wr-head-acts"><button type="button" class="adp-btn ghost-dark" data-wr-ai hidden>✨ Redactar con IA</button><button type="button" class="adp-btn" data-wr-new>+ Nueva noticia</button></span>
    </header>
    <nav class="apn-tabs pnl-sub" role="tablist" aria-label="Estado">
      <button type="button" role="tab" aria-selected="true" data-ws="draft">Borradores <b data-wn="draft"></b></button>
      <button type="button" role="tab" aria-selected="false" data-ws="review">En revisión <b data-wn="review"></b></button>
      <button type="button" role="tab" aria-selected="false" data-ws="scheduled">Programadas <b data-wn="scheduled"></b></button>
      <button type="button" role="tab" aria-selected="false" data-ws="published">Publicadas <b data-wn="published"></b></button>
    </nav>
    <div class="wr-list" data-wr-list></div>
  </div>

  <!-- Editor -->
  <div class="wr-ed" data-wr-editor hidden>
    <div class="wr-bar">
      <button type="button" class="pnl-link" data-wr-back>← Mis noticias</button>
      <span class="wr-state" data-wr-state></span>
      <span class="wr-saved" data-wr-saved aria-live="polite"></span>
      <span class="wr-bar-sp"></span>
      <button type="button" class="adp-btn ghost-dark" data-wr-preview>Vista previa</button>
      <button type="button" class="adp-btn ghost-dark" data-wr-save>Guardar borrador</button>
      <button type="button" class="adp-btn" data-wr-go>Publicar</button>
    </div>
    <div class="wr-cols">
      <div class="wr-main">
        <textarea class="wr-title" data-f="title" rows="1" maxlength="140" placeholder="Titular" aria-label="Titular"></textarea>
        <p class="wr-count" data-cnt="title"></p>
        <textarea class="wr-sub" data-f="description" rows="2" maxlength="260" placeholder="Subtítulo o resumen: una o dos oraciones que expliquen la noticia" aria-label="Subtítulo"></textarea>
        <p class="wr-count" data-cnt="description"></p>

        <div class="wr-photo" data-wr-photo>
          <div class="wr-photo-empty" data-photo-empty>
            <label class="adp-btn ghost-dark">Subir foto principal<input type="file" accept="image/*" class="sr" data-photo-file /></label>
            <span class="pnl-muted">o pega el enlace de una foto: <input type="url" data-f="imageUrl" placeholder="https://…" aria-label="Enlace de la foto" /></span>
          </div>
          <figure class="wr-photo-full" data-photo-full hidden>
            <img alt="" data-photo-img />
            <button type="button" class="wr-photo-x" data-photo-rm aria-label="Quitar foto">✕</button>
          </figure>
          <div class="wr-2" data-photo-meta hidden>
            <label>Pie de foto<input data-f="imageCaption" maxlength="200" placeholder="Qué se ve en la foto" /></label>
            <label>Crédito (obligatorio)<input data-f="imageCredit" maxlength="120" placeholder="Foto: Nombre / Noticias Xtra" /></label>
            <label>Enlace de la licencia (opcional)<input type="url" data-f="imageCreditUrl" maxlength="500" placeholder="https://…" /></label>
          </div>
        </div>

        <div class="wr-tools" role="toolbar" aria-label="Formato">
          <select data-block aria-label="Tipo de texto"><option value="p">Párrafo</option><option value="h2">Subtítulo grande</option><option value="h3">Subtítulo pequeño</option></select>
          {TOOLS.map(([id, label, d]) => <button type="button" data-tool={id} title={label} aria-label={label}><Fragment set:html={I(d)} /></button>)}
        </div>
        <div class="wr-body body" data-body contenteditable="true" role="textbox" aria-multiline="true" aria-label="Texto de la noticia" data-ph="Escribe la noticia aquí. Pega un enlace de YouTube, X, Instagram, Facebook o TikTok en su propia línea y se inserta solo."></div>
        <p class="wr-count" data-wcount></p>
      </div>

      <aside class="wr-side">
        <div data-ai-box hidden></div>
        <div class="pnl-card"><h2 class="pnl-h3">Publicación</h2>
          <label>Sección<select data-f="section">{secs.map((s) => <option value={s.id}>{s.name}</option>)}</select></label>
          <label data-league-wrap hidden>Liga<select data-f="league"><option value="">—</option>{leagues.map((l) => <option value={l.id}>{l.name}</option>)}</select></label>
          <label>Lugar<input data-f="place" list="wr-towns" maxlength="60" placeholder="San Juan" /></label>
          <datalist id="wr-towns">{PR_MUNICIPIOS.map((t) => <option value={t} />)}<option value="Puerto Rico" /><option value="Washington" /><option value="Nueva York" /><option value="Orlando, Florida" /></datalist>
          <label>Autor<input data-f="author" maxlength="60" /></label>
          <label>Fecha y hora de publicación<input type="datetime-local" data-f="date" /></label>
          <p class="pnl-muted pnl-small">Déjala en el pasado o ahora para publicar ya; ponla en el futuro para programarla.</p>
        </div>
        <div class="pnl-card" data-editor-only><h2 class="pnl-h3">Etiquetas</h2>
          <label class="adb-check"><input type="checkbox" data-f="breaking" /> Última hora (barra roja)</label>
          <label class="adb-check"><input type="checkbox" data-f="trending" /> Tendencia (puede ir arriba aunque no sea local)</label>
          <label class="adb-check"><input type="checkbox" data-f="featured" /> Destacada en portada</label>
          <p class="pnl-muted pnl-small wr-lead-h">Noticia principal (dura hasta 2 días o hasta que marques otra):</p>
          <label class="adb-check"><input type="checkbox" data-f="pinned" /> 📌 Fijar arriba en la Portada (se queda hasta que la desfijes)</label>
          <label class="adb-check"><input type="checkbox" data-f="homeLead" /> Principal de la Portada</label>
          <label class="adb-check"><input type="checkbox" data-f="sectionPinned" /> 📌 Fijar arriba en su sección (se queda hasta que la desfijes)</label>
          <label class="adb-check"><input type="checkbox" data-f="sectionLead" /> Principal de su sección</label>
          <label class="adb-check"><input type="checkbox" data-f="live" /> En vivo / en desarrollo</label>
        </div>
        <div class="pnl-card"><h2 class="pnl-h3">Fuentes</h2>
          <ul class="wr-srcs" data-srcs></ul>
          <div class="wr-addsrc"><input data-src-name placeholder="Nombre (ej. Policía de PR)" aria-label="Nombre de la fuente" /><input data-src-url type="url" placeholder="Enlace (opcional)" aria-label="Enlace de la fuente" /><button type="button" class="pnl-link" data-src-add>Añadir</button></div>
        </div>
        <div class="pnl-card"><h2 class="pnl-h3">Noticias relacionadas</h2>
          <select data-rel-pick aria-label="Añadir relacionada"><option value="">Escoge una noticia…</option>{recent.map((r) => <option value={r.id}>{r.title}</option>)}</select>
          <ul class="wr-srcs" data-rels></ul>
        </div>
        <div class="pnl-card"><h2 class="pnl-h3">Corrección</h2>
          <textarea data-f="correction" rows="2" maxlength="300" placeholder="Solo si corriges algo ya publicado: qué se corrigió y cuándo"></textarea>
        </div>
        <div class="pnl-card"><h2 class="pnl-h3">Antes de publicar</h2><ul class="pnl-checks" data-checks></ul></div>
        <div class="pnl-card"><h2 class="pnl-h3">Archivo</h2>
          <p class="pnl-muted pnl-small">La noticia como archivo del sitio (Markdown).</p>
          <button type="button" class="pnl-link" data-dl>Descargar archivo</button>
          <details class="wr-md"><summary>Ver el archivo</summary><textarea readonly rows="10" data-md></textarea></details>
        </div>
      </aside>
    </div>
  </div>

  <!-- Attach a document -->
  <!-- Insert panels: they open right next to the toolbar button (or the block being edited) -->
  <dialog class="wr-pop" data-pop="link" aria-labelledby="wr-link-h">
    <form class="sd-form" data-link-form>
      <header class="sd-dlg-h"><h2 id="wr-link-h">Enlace</h2><button type="button" class="sd-x" data-pop-close aria-label="Cerrar">✕</button></header>
      <label>Dirección<input type="url" name="url" required placeholder="https://…" /></label>
      <label class="adb-check"><input type="checkbox" name="newtab" checked /> Abrir en otra pestaña</label>
      <footer class="sd-dlg-f"><button type="button" class="pnl-link" data-unlink>Quitar enlace</button><button type="submit" class="adp-btn">Aplicar</button></footer>
    </form>
  </dialog>
  <dialog class="wr-pop wide" data-pop="embed" aria-labelledby="wr-emb-h">
    <form class="sd-form" data-embed-form>
      <header class="sd-dlg-h"><h2 id="wr-emb-h" data-embed-h>Insertar video o publicación</h2><button type="button" class="sd-x" data-pop-close aria-label="Cerrar">✕</button></header>
      <label>Enlace<input type="url" name="url" required placeholder="YouTube, X, Instagram, Facebook, TikTok, Spotify o Google Maps" /></label>
      <div class="wr-emb-prev" data-embed-prev><p class="pnl-muted pnl-small">Pega el enlace y verás la publicación aquí.</p></div>
      <fieldset class="wr-lay"><legend>Tamaño</legend><label><input type="radio" name="size" value="" checked /> Automático</label><label><input type="radio" name="size" value="s" /> Pequeño</label><label><input type="radio" name="size" value="m" /> Mediano</label><label><input type="radio" name="size" value="l" /> Grande</label></fieldset>
        <fieldset class="wr-lay"><legend>Posición</legend><label><input type="radio" name="align" value="l" /> Izquierda</label><label><input type="radio" name="align" value="" checked /> Centro</label><label><input type="radio" name="align" value="r" /> Derecha</label></fieldset>
        <p class="pnl-muted pnl-small">Izquierda o derecha: el texto lo rodea en computadora; en celular va a lo ancho.</p>
      <p class="cm-err" data-embed-err hidden></p>
      <footer class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-pop-close>Cancelar</button><button type="submit" class="adp-btn" data-embed-go>Insertar</button></footer>
    </form>
  </dialog>
  <dialog class="wr-pop wide" data-pop="image" aria-labelledby="wr-img-h">
    <form class="sd-form" data-img-form>
      <header class="sd-dlg-h"><h2 id="wr-img-h" data-img-h>Insertar foto</h2><button type="button" class="sd-x" data-pop-close aria-label="Cerrar">✕</button></header>
      <label data-img-file-wrap>Foto<input type="file" name="file" accept="image/*" /></label>
      <img class="wr-img-prev" data-img-prev alt="" hidden />
      <label>Pie de foto<input name="cap" maxlength="200" placeholder="Qué se ve en la foto" /></label>
      <label>Crédito<input name="credit" maxlength="120" placeholder="Foto: Nombre / Noticias Xtra" /></label>
      <fieldset class="wr-lay"><legend>Tamaño</legend><label><input type="radio" name="size" value="" checked /> Automático</label><label><input type="radio" name="size" value="s" /> Pequeño</label><label><input type="radio" name="size" value="m" /> Mediano</label><label><input type="radio" name="size" value="l" /> Grande</label></fieldset>
        <fieldset class="wr-lay"><legend>Posición</legend><label><input type="radio" name="align" value="l" /> Izquierda</label><label><input type="radio" name="align" value="" checked /> Centro</label><label><input type="radio" name="align" value="r" /> Derecha</label></fieldset>
        <p class="pnl-muted pnl-small">Izquierda o derecha: el texto lo rodea en computadora; en celular va a lo ancho.</p>
      <p class="cm-err" data-img-err hidden></p>
      <footer class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-pop-close>Cancelar</button><button type="submit" class="adp-btn" data-img-go>Insertar</button></footer>
    </form>
  </dialog>
  <dialog class="wr-pop wide" data-pop="doc" data-doc-dlg aria-labelledby="wr-doc-h">
    <form class="sd-form" data-doc-form>
      <header class="sd-dlg-h"><h2 id="wr-doc-h">Añadir documento</h2><button type="button" class="sd-x" data-pop-close aria-label="Cerrar">✕</button></header>
      <p class="pnl-muted">En la noticia se ve como una tarjeta limpia; el lector toca “Ver documento” y lo lee completo.</p>
      <label>Título que verá el lector<input name="title" maxlength="120" required placeholder="ej. Informe de la Contralora sobre el municipio de Ponce" /></label>
      <label>Sube el PDF<input type="file" name="file" accept="application/pdf" /></label>
      <p class="pnl-muted pnl-small">o pega el enlace de un PDF público (por ejemplo, de una agencia o un tribunal):</p>
      <label>Enlace<input type="url" name="url" placeholder="https://…/documento.pdf" /></label>
      <label>De dónde viene (opcional)<input name="source" maxlength="60" placeholder="ej. Oficina del Contralor" /></label>
      <p class="cm-err" data-doc-err hidden></p>
      <footer class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-pop-close>Cancelar</button><button type="submit" class="adp-btn">Insertar</button></footer>
    </form>
  </dialog>

  <!-- Preview -->
  <dialog class="wr-prev" data-wr-prev aria-label="Vista previa">
    <div class="wr-prev-bar">
      <span class="sp-demo">VISTA PREVIA</span><span class="wr-prev-t">La página real del sitio con esta noticia</span>
      <div class="pnl-range" role="group" aria-label="Pantalla"><button type="button" data-dev="desk" aria-pressed="true">Computadora</button><button type="button" data-dev="phone" aria-pressed="false">Celular</button></div>
      <a class="pnl-link" href={url('redaccion/vista-previa')} target="_blank" rel="noopener">Abrir en otra pestaña ↗</a>
      <button type="button" class="adp-btn ghost-dark" data-prev-close>Cerrar</button>
    </div>
    <div class="wr-prev-stage" data-prev-stage><iframe title="Vista previa de la noticia" data-prev-frame></iframe></div>
  </dialog>
  <div class="apn-toast" data-wr-toast role="status" hidden></div>
  <AiDraft />
</section>

<script>
  import { embedFor } from '../../lib/embeds.mjs';
  import { docCard } from '../../lib/doccard.mjs';
  import { ask, askText } from '../../lib/dialogs';
  import { hasBackend, listArticles, putArticle, deleteArticle, uploadStoryFile, publishArticle } from '../../lib/backend';
  import { patchGen, wipe } from '../../lib/ai-drafts';
  const root = document.querySelector<HTMLElement>('[data-wr]');
  if (root) {
    type Src = { name: string; url?: string };
    type Art = {
      id: string; status: 'draft' | 'review' | 'scheduled' | 'published'; updated: number; owner: string; note?: string;
      title: string; description: string; section: string; league: string; place: string; author: string; date: string;
      image: string; imageUrl: string; imageCaption: string; imageCredit: string; imageCreditUrl?: string; breaking: boolean; trending: boolean; featured: boolean; live: boolean; pinned?: boolean; homeLead?: boolean; sectionLead?: boolean; sectionPinned?: boolean;
      sources: Src[]; related: string[]; correction: string; body: string; slug?: string;
      aiAssisted?: boolean; fmExtra?: string; // kept from an existing story file: the AI label and fields the editor doesn't show
      aiGen?: string; // made with "Redactar con IA": its row in ai_generations (only the admin approves it)
    };
    const SECS: Array<{ id: string; name: string }> = JSON.parse(root.dataset.secs!);
    const RECENT: Array<{ id: string; title: string }> = JSON.parse(root.dataset.recent!);
    type Pub = { id: string; title: string; section: string; author: string; date: string; url: string; ai: boolean; local?: boolean };
    const PUBLISHED: Pub[] = JSON.parse(root.dataset.published!);
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const toast = (m: string) => { const t = $('[data-wr-toast]'); t.textContent = m; t.hidden = false; clearTimeout((t as any).tm); (t as any).tm = setTimeout(() => (t.hidden = true), 4000); };
    const me = () => { try { return JSON.parse(localStorage.getItem('nx-staff') || 'null') as { name: string; role: string } | null; } catch { return null; } };
    const canPublish = () => ['admin', 'editor'].includes(me()?.role ?? '');
    const isAdmin = () => me()?.role === 'admin';
    const canApprove = (a: Art) => canPublish() && (!a.aiGen || isAdmin()); // AI drafts: admin only
    // With Supabase (src/lib/backend.ts) articles are shared by the team; without it they stay on this device ('nx-articles')
    const DB = hasBackend();
    const KEY = 'nx-articles';
    let CACHE: Art[] = [];
    const load = (): Art[] => { if (DB) return CACHE; try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const saveLocal = (list: Art[]) => {
      try { localStorage.setItem(KEY, JSON.stringify(list)); return true; }
      catch { toast('No hay espacio en este dispositivo: usa fotos más pequeñas o borra borradores viejos.'); return false; }
    };
    /** Saves one article (shared database or this device). */
    async function store(a: Art): Promise<boolean> {
      const list = load(); const i = list.findIndex((x) => x.id === a.id);
      if (i >= 0) list[i] = a; else list.unshift(a);
      if (!DB) return saveLocal(list);
      const { status, ...doc } = a;
      const ok = await putArticle(a.id, status, doc, a.slug);
      if (!ok) toast('No se pudo guardar en la base de datos. Revisa la conexión e intenta otra vez.');
      return ok;
    }
    async function drop(id: string): Promise<boolean> {
      if (!DB) return saveLocal(load().filter((x) => x.id !== id));
      const ok = await deleteArticle(id);
      if (ok) CACHE = CACHE.filter((x) => x.id !== id); else toast('No se pudo borrar.');
      return ok;
    }
    async function refresh() {
      if (!DB) return;
      const rows = await listArticles();
      if (!rows) { toast('No pudimos cargar las noticias del equipo. Revisa la conexión.'); return; }
      // A scheduled story counts as published once its time has passed
      CACHE = rows.map((r) => ({ ...r.doc, id: r.id, slug: r.slug ?? undefined, updated: Date.parse(r.updated_at),
        status: r.status === 'scheduled' && Date.parse(r.doc.date) <= Date.now() ? 'published' : r.status }));
    }
    /** Photos and PDFs go to the shared storage when Supabase is connected (a data URL stays as is otherwise). */
    async function upload(data: string, kind: 'foto' | 'doc', ext: string): Promise<string> {
      if (!DB || !data.startsWith('data:') || !cur) return data;
      const url = await uploadStoryFile(`${cur.id.toLowerCase()}/${kind}-${Date.now().toString(36)}.${ext}`, data);
      if (!url) toast('No se pudo subir el archivo. Intenta otra vez.');
      return url ?? '';
    }
    const localNow = () => { const d = new Date(Date.now() - new Date().getTimezoneOffset() * 60000); return d.toISOString().slice(0, 16); };
    const ago = (t: number) => { const m = Math.round((Date.now() - t) / 60000); return m < 1 ? 'ahora' : m < 60 ? `hace ${m} min` : m < 1440 ? `hace ${Math.round(m / 60)} h` : `hace ${Math.round(m / 1440)} d`; };
    const STATUS = { draft: 'Borrador', review: 'En revisión', scheduled: 'Programada', published: 'Publicada' };

    // ---------- list ----------
    let tab: Art['status'] = 'draft';
    function renderList() {
      $('[data-wr-ai]').hidden = !(DB && isAdmin()); // "Redactar con IA" is for the admin
      const s = me(); const all = load().filter((a) => canPublish() || a.owner === s?.name); // periodistas see their own
      (['draft', 'review', 'scheduled', 'published'] as const).forEach((k) => { const n = all.filter((a) => a.status === k).length; $(`[data-wn="${k}"]`).textContent = n ? String(n) : ''; });
      const pubs = publishedList();
      $('[data-wn="published"]').textContent = pubs.length ? String(pubs.length) : '';
      if (tab === 'published') { renderPublished(pubs); return; }
      const list = all.filter((a) => a.status === tab).sort((a, b) => b.updated - a.updated);
      $('[data-wr-list]').innerHTML = list.map((a) => `<article class="pnl-row" data-id="${a.id}">
        <div><p class="pnl-muted">${STATUS[a.status]} · ${esc(SECS.find((x) => x.id === a.section)?.name ?? '')} · ${esc(a.author || a.owner)} · ${ago(a.updated)}${a.status === 'scheduled' ? ` · sale el ${new Date(a.date).toLocaleString('es-PR', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' })}` : ''}</p>
          <h2>${esc(a.title || 'Sin titular')}</h2>${a.note ? `<p class="sd-warn">Nota del editor: ${esc(a.note)}</p>` : ''}</div>
        <div class="pnl-row-acts">
          ${a.status === 'review' && canApprove(a) ? `<button type="button" class="adp-btn" data-la="approve">Aprobar y publicar</button>${a.aiGen ? '' : '<button type="button" class="pnl-link" data-la="return">Devolver</button>'}` : ''}
          <button type="button" class="adp-btn ghost-dark" data-la="preview">Vista previa</button>
          <button type="button" class="adp-btn ghost-dark" data-la="edit">${a.status === 'published' ? 'Editar o corregir' : 'Editar'}</button>
          <button type="button" class="pnl-link" data-la="dup">Duplicar</button>
          ${DB && (a.status === 'published' || a.status === 'scheduled') ? '' : '<button type="button" class="apr-reject" data-la="del">Borrar</button>'}
        </div></article>`).join('') || `<p class="apr-empty">${tab === 'draft' ? 'No tienes borradores. Toca “Nueva noticia” para empezar.' : 'Nada aquí todavía.'}</p>`;
    }

    // ---------- Publicadas: every published article with its numbers (DEMO until Google Analytics is connected) ----------
    let pubSort: 'new' | 'views' = 'new'; let openStats = '';
    function publishedList(): Pub[] {
      const s = me(); const mine = (p: Pub) => canPublish() || p.author === s?.name;
      const mineHere = load().filter((a) => a.status === 'published');
      const local = mineHere.map((a) => ({ id: a.id, title: a.title || 'Sin titular', section: SECS.find((x) => x.id === a.section)?.name ?? '', author: a.author || a.owner,
        date: new Date(a.date || a.updated).toISOString(), url: a.slug ? `${root.dataset.base!.replace(/\/$/, '')}/noticia/${a.slug}/` : '', ai: false, local: !DB }));
      const slugs = new Set(mineHere.map((a) => a.slug).filter(Boolean));
      return [...local, ...PUBLISHED.filter((p) => !slugs.has(p.id))].filter(mine);
    }
    // Stable sample numbers per article: they grow with its age and never change between visits
    const hash = (t: string) => [...t].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
    function statsOf(p: Pub) {
      const h = hash(p.id), days = Math.max(0.2, (Date.now() - Date.parse(p.date)) / 864e5);
      const peak = 600 + (h % 5200);
      const views = Math.round(peak * (1 - Math.exp(-days / 1.6)) + (h % 90));
      const byDay = Array.from({ length: 7 }, (_, i) => { const d = days - (6 - i); return d < 0 ? 0 : Math.round(peak * Math.exp(-Math.max(0, d) / 1.6) * 0.42 + ((h >> i) % 40)); });
      const mins = 1 + (h % 3), secs = 10 + (h % 50);
      const google = 30 + (h % 20), fb = 15 + ((h >> 3) % 18), wa = 8 + ((h >> 5) % 10), direct = 100 - google - fb - wa;
      const pr = 62 + (h % 20), phone = 70 + ((h >> 2) % 15);
      return { views, byDay, time: `${mins} min ${secs} s`, comments: (h >> 4) % 23, shares: Math.round(views / (40 + (h % 30))),
        refs: [['Google', google], ['Facebook', fb], ['WhatsApp', wa], ['Directo y otros', direct]] as Array<[string, number]>,
        geo: [['Puerto Rico', pr], ['Estados Unidos', 100 - pr - 3], ['Otros países', 3]] as Array<[string, number]>, phone };
    }
    const fmtN = (n: number) => n.toLocaleString('es-PR');
    const EYE = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';
    const LIVE = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';
    const bars = (rows: Array<[string, number]>) => `<ul class="pc-rows">${rows.map(([l, v]) => `<li><span class="pc-rl">${esc(l)}</span><span class="pc-rb"><i style="width:${v}%"></i></span><b>${v}%</b></li>`).join('')}</ul>`;
    function renderPublished(pubs: Pub[]) {
      const rows = pubs.map((p) => ({ p, st: statsOf(p) })).sort((a, b) => (pubSort === 'views' ? b.st.views - a.st.views : Date.parse(b.p.date) - Date.parse(a.p.date)));
      const total = rows.reduce((a, r) => a + r.st.views, 0);
      const top = rows.slice().sort((a, b) => b.st.views - a.st.views)[0];
      const head = `<div class="wr-pub-head">
        <div class="pnl-kpis"><div class="pnl-kpi"><span>Publicadas</span><b>${fmtN(rows.length)}</b></div><div class="pnl-kpi"><span>Vistas en total</span><b>${fmtN(total)}</b><small>DEMO</small></div>
          <div class="pnl-kpi"><span>Promedio por noticia</span><b>${fmtN(Math.round(total / Math.max(1, rows.length)))}</b></div>
          ${top ? `<div class="pnl-kpi"><span>La más leída</span><b class="wr-top-t">${esc(top.p.title)}</b><small>${fmtN(top.st.views)} vistas</small></div>` : ''}</div>
        <div class="pnl-range" role="group" aria-label="Ordenar"><button type="button" data-psort="new" aria-pressed="${pubSort === 'new'}">Más recientes</button><button type="button" data-psort="views" aria-pressed="${pubSort === 'views'}">Más vistas</button></div>
        <p class="pnl-muted pnl-small"><span class="sp-demo">DEMO</span> Las vistas son de muestra. Con Google Analytics conectado, aquí salen las reales de cada noticia.</p></div>`;
      $('[data-wr-list]').innerHTML = head + (rows.map(({ p, st }) => {
        const open = openStats === p.id; const max = Math.max(1, ...st.byDay);
        const mineArt = load().some((a) => a.id === p.id);
        const siteStory = !mineArt && !p.local && canPublish(); // a story already on the site (AI or older): editors and admins
        return `<article class="pnl-row wr-pub" data-pid="${esc(p.id)}"${mineArt ? ` data-id="${esc(p.id)}"` : ''}>
          <span class="wr-pub-ic" title="Publicada" aria-label="Publicada">${LIVE}</span>
          <div class="wr-pub-main"><p class="pnl-muted">${esc(p.section)} · ${esc(p.author)} · ${new Date(p.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}${p.ai ? ' · <span class="wr-ai">IA</span>' : ''}${p.local ? ' · <span class="wr-ai">desde el editor</span>' : ''}</p>
            <h2>${p.url ? `<a href="${p.url}" target="_blank" rel="noopener">${esc(p.title)}</a>` : esc(p.title)}</h2>
            <p class="wr-pub-stats"><span class="wr-views">${EYE} <b>${fmtN(st.views)}</b> vistas</span><span>⏱ ${st.time}</span><span>💬 ${st.comments}</span><span>↗ ${fmtN(st.shares)} compartidas</span></p>
            ${open ? `<div class="wr-pub-detail">
              <div><h3 class="pnl-h4">Vistas en los últimos 7 días</h3><div class="wr-spark">${st.byDay.map((v, i) => `<span title="${fmtN(v)} vistas"><i style="height:${Math.round((v / max) * 100)}%"></i><small>${['L', 'M', 'M', 'J', 'V', 'S', 'D'][(new Date(Date.now() - (6 - i) * 864e5).getDay() + 6) % 7]}</small></span>`).join('')}</div></div>
              <div><h3 class="pnl-h4">De dónde llegan</h3>${bars(st.refs)}</div>
              <div><h3 class="pnl-h4">Dónde están</h3>${bars(st.geo)}<p class="pnl-muted pnl-small">${st.phone}% en celular</p></div>
            </div>` : ''}
          </div>
          <div class="pnl-row-acts">${mineArt ? '<button type="button" class="adp-btn" data-la="edit">Editar o corregir</button>' : siteStory ? `<button type="button" class="adp-btn" data-import="${esc(p.id)}">Editar o corregir</button>` : ''}${p.url ? `<a class="adp-btn ghost-dark" href="${p.url}" target="_blank" rel="noopener">Ver en el sitio ↗</a>` : ''}<button type="button" class="adp-btn ${open ? '' : 'ghost-dark'}" data-pstats="${esc(p.id)}">${open ? 'Cerrar' : 'Estadísticas'}</button></div>
        </article>`;
      }).join('') || '<p class="apr-empty">Todavía no hay noticias publicadas.</p>');
    }
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const so = t.closest<HTMLElement>('[data-psort]'); if (so) { pubSort = so.dataset.psort as 'new' | 'views'; renderList(); return; }
      const ps = t.closest<HTMLElement>('[data-pstats]'); if (ps) { openStats = openStats === ps.dataset.pstats ? '' : ps.dataset.pstats!; renderList(); }
    });

    // ---------- editor ----------
    const body = $('[data-body]');
    let cur: Art | null = null, dirty = false, timer = 0;
    const blank = (): Art => ({ id: `A-${Date.now().toString(36)}`, status: 'draft', updated: Date.now(), owner: me()?.name ?? '', title: '', description: '', section: 'puerto-rico', league: '',
      place: '', author: me()?.name ?? 'Noticias Xtra', date: localNow(), image: '', imageUrl: '', imageCaption: '', imageCredit: '', imageCreditUrl: '', breaking: false, trending: false, featured: false, live: false, pinned: false, homeLead: false, sectionLead: false, sectionPinned: false,
      sources: [], related: [], correction: '', body: '' });
    const field = (k: string) => $<HTMLInputElement>(`[data-f="${k}"]`);
    function openEditor(a: Art) {
      cur = structuredClone(a);
      (['title', 'description', 'section', 'league', 'place', 'author', 'date', 'imageUrl', 'imageCaption', 'imageCredit', 'imageCreditUrl', 'correction'] as const).forEach((k) => (field(k).value = String(cur![k] ?? '')));
      (['breaking', 'trending', 'featured', 'live', 'pinned', 'homeLead', 'sectionLead', 'sectionPinned'] as const).forEach((k) => (field(k).checked = !!cur![k]));
      body.innerHTML = cur.body || '<p><br></p>';
      body.querySelectorAll<HTMLElement>('figure.wr-embed').forEach(paintEmbed);
      $$('[data-editor-only]').forEach((e) => (e.hidden = !canPublish()));
      $('[data-wr-list-view]').hidden = true; $('[data-wr-editor]').hidden = false;
      sync(); dirty = false; $('[data-wr-saved]').textContent = ''; scrollTo({ top: 0 });
      ($('[data-f="title"]') as HTMLTextAreaElement).focus();
      dispatchEvent(new CustomEvent('nx-wr-open', { detail: { art: cur } })); // the AI box (AiDraft.astro)
    }
    function closeEditor() { if (dirty) void persist(); cur = null; dispatchEvent(new CustomEvent('nx-wr-open', { detail: { art: null } })); $('[data-wr-editor]').hidden = true; $('[data-wr-list-view]').hidden = false; renderList(); }
    function readEditor() {
      if (!cur) return;
      (['title', 'description', 'section', 'league', 'place', 'author', 'date', 'imageUrl', 'imageCaption', 'imageCredit', 'imageCreditUrl', 'correction'] as const).forEach((k) => ((cur as any)[k] = field(k).value.trim()));
      (['breaking', 'trending', 'featured', 'live', 'pinned', 'homeLead', 'sectionLead', 'sectionPinned'] as const).forEach((k) => (cur![k] = field(k).checked));
      cur.body = body.innerHTML;
    }
    async function persist(status?: Art['status']) {
      readEditor(); if (!cur) return false;
      if (status) cur.status = status;
      // A reporter's change to a published story goes back to an editor
      if (!canPublish() && (cur.status === 'published' || cur.status === 'scheduled')) cur.status = 'review';
      cur.updated = Date.now();
      const a = structuredClone(cur);
      if (!(await store(a))) return false;
      dirty = false; $('[data-wr-saved]').textContent = `Guardado ${new Date().toLocaleTimeString('es-PR', { hour: 'numeric', minute: '2-digit' })}`;
      return true;
    }

    // Everything that depends on the fields: counters, checklist, buttons, file
    function sync() {
      if (!cur) return;
      readEditor();
      const words = (body.innerText.trim().match(/\S+/g) || []).length;
      $('[data-wcount]').textContent = `${words} palabras · ${Math.max(1, Math.round(words / 220))} min de lectura${words > 450 ? ' · nuestras noticias suelen tener 250 a 450 palabras' : ''}`;
      $('[data-cnt="title"]').textContent = `${cur.title.length}/110 caracteres${cur.title.length > 110 ? ' · muy largo para Google y redes' : ''}`;
      $('[data-cnt="description"]').textContent = `${cur.description.length}/200`;
      $('[data-league-wrap]').hidden = cur.section !== 'deportes';
      const photo = cur.image || cur.imageUrl;
      $('[data-photo-empty]').hidden = !!photo; $('[data-photo-full]').hidden = !photo; $('[data-photo-meta]').hidden = !photo;
      if (photo) $<HTMLImageElement>('[data-photo-img]').src = /^(https?:|data:)/.test(photo) ? photo : `${root.dataset.base!.replace(/\/$/, '')}/${photo}`;
      $('[data-srcs]').innerHTML = cur.sources.map((s, i) => `<li><span>${s.url ? `<a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.name)}</a>` : esc(s.name)}</span><button type="button" class="pnl-link" data-src-rm="${i}" aria-label="Quitar">✕</button></li>`).join('');
      $('[data-rels]').innerHTML = cur.related.map((id, i) => `<li><span>${esc(RECENT.find((r) => r.id === id)?.title ?? id)}</span><button type="button" class="pnl-link" data-rel-rm="${i}" aria-label="Quitar">✕</button></li>`).join('');
      const future = new Date(cur.date).valueOf() > Date.now() + 60000;
      const go = $<HTMLButtonElement>('[data-wr-go]');
      go.textContent = !canPublish() ? 'Enviar a revisión' : future ? 'Programar' : cur.status === 'published' ? 'Actualizar' : 'Publicar';
      if (cur.aiGen && !isAdmin() && cur.status !== 'published') go.textContent = 'Lo aprueba el administrador';
      go.disabled = !!cur.aiGen && !isAdmin() && cur.status !== 'published';
      $('[data-wr-state]').textContent = STATUS[cur.status];
      $('[data-wr-state]').className = `wr-state ${cur.status}`;
      const checks: Array<[boolean, string]> = [
        [cur.title.length >= 20 && cur.title.length <= 110, 'Titular claro (20 a 110 caracteres)'],
        [cur.description.length >= 40, 'Subtítulo de una o dos oraciones'],
        [words >= 80, 'Al menos 80 palabras'],
        [!!cur.place || !!cur.aiGen, cur.aiGen ? 'Lugar (vacío = Puerto Rico)' : 'Lugar'],
        [!photo || !!cur.imageCredit, 'Crédito de la foto (si tiene foto)'],
        [cur.sources.length > 0, 'Al menos una fuente'],
      ];
      $('[data-checks]').innerHTML = checks.map(([ok, t]) => `<li class="${ok ? 'ok' : ''}"><span>${ok ? '✓' : '○'} ${t}</span></li>`).join('');
      $<HTMLTextAreaElement>('[data-md]').value = toFile(cur);
      return checks.every(([ok]) => ok);
    }
    const changed = () => { dirty = true; $('[data-wr-saved]').textContent = 'Cambios sin guardar'; clearTimeout(timer); timer = window.setTimeout(() => { if (cur && dirty) void persist(); }, 2500); sync(); };
    $('[data-wr-editor]').addEventListener('input', changed);
    $('[data-wr-editor]').addEventListener('change', changed);
    $$<HTMLTextAreaElement>('.wr-title,.wr-sub').forEach((t) => t.addEventListener('input', () => { t.style.height = 'auto'; t.style.height = `${t.scrollHeight}px`; }));

    // ---------- body: toolbar ----------
    const exec = (cmd: string, val?: string) => { body.focus(); document.execCommand(cmd, false, val); changed(); };
    let savedRange: Range | null = null;
    body.addEventListener('blur', () => { const s = getSelection(); if (s?.rangeCount && body.contains(s.anchorNode)) savedRange = s.getRangeAt(0).cloneRange(); });
    const restore = () => { body.focus(); if (savedRange) { const s = getSelection()!; s.removeAllRanges(); s.addRange(savedRange); } };
    const insertBlock = (html: string) => { restore(); document.execCommand('insertHTML', false, `${html}<p><br></p>`); body.querySelectorAll<HTMLElement>('figure.wr-embed:not([data-ready])').forEach(paintEmbed); body.querySelectorAll<HTMLElement>('figure.wr-img:not([data-ready])').forEach(paintImg); changed(); };
    const LAY = { size: { '': '', s: 'Pequeño', m: 'Mediano', l: 'Grande' } as Record<string, string>, align: { '': '', l: 'Izquierda', r: 'Derecha' } as Record<string, string> };
    const layClass = (f: HTMLElement) => `${f.dataset.size ? ` sz-${f.dataset.size}` : ''}${f.dataset.align ? ` al-${f.dataset.align}` : ''}`;
    const layLabel = (f: HTMLElement) => [LAY.size[f.dataset.size || ''], LAY.align[f.dataset.align || '']].filter(Boolean).join(' · ');
    $<HTMLSelectElement>('[data-block]').addEventListener('change', (e) => { const v = (e.target as HTMLSelectElement).value; exec('formatBlock', v === 'p' ? 'P' : v.toUpperCase()); (e.target as HTMLSelectElement).value = 'p'; });
    function paintEmbed(fig: HTMLElement) {
      const u = fig.dataset.url!; fig.setAttribute('contenteditable', 'false'); fig.dataset.ready = '1';
      fig.className = `wr-embed${layClass(fig)}`;
      fig.innerHTML = `${embedFor(u) ?? ''}<figcaption><span>${esc(layLabel(fig) || u)}</span><span><button type="button" class="pnl-link" data-block-edit>Editar</button> <button type="button" class="pnl-link" data-embed-rm>Quitar</button></span></figcaption>`;
    }
    function paintImg(fig: HTMLElement) {
      fig.setAttribute('contenteditable', 'false'); fig.dataset.ready = '1'; fig.className = `wr-img${layClass(fig)}`;
      const cap = [fig.dataset.cap, fig.dataset.credit].filter(Boolean).join(' ');
      fig.innerHTML = `<img src="${esc(fig.dataset.src!)}" alt="${esc(fig.dataset.cap || '')}"><figcaption><span>${esc(cap)}${layLabel(fig) ? ` <small>(${esc(layLabel(fig))})</small>` : ''}</span><span><button type="button" class="pnl-link" data-block-edit>Editar</button></span></figcaption><button type="button" class="wr-photo-x" data-img-rm aria-label="Quitar foto">✕</button>`;
    }
    root.addEventListener('click', (e) => {
      const rm = (e.target as HTMLElement).closest('[data-embed-rm],[data-img-rm]');
      if (rm) { rm.closest('figure')!.remove(); changed(); }
    });
    $$<HTMLButtonElement>('[data-tool]').forEach((b) => b.addEventListener('mousedown', (e) => e.preventDefault()));
    $$<HTMLButtonElement>('[data-tool]').forEach((b) => b.addEventListener('click', async () => {
      const t = b.dataset.tool;
      if (t === 'bold') exec('bold'); if (t === 'italic') exec('italic');
      if (t === 'ul') exec('insertUnorderedList'); if (t === 'ol') exec('insertOrderedList');
      if (t === 'quote') exec('formatBlock', 'BLOCKQUOTE');
      if (t === 'hr') { exec('insertHorizontalRule'); }
      if (t === 'undo') exec('undo'); if (t === 'redo') exec('redo');
      if (t === 'clear') { exec('removeFormat'); exec('formatBlock', 'P'); exec('unlink'); }
      if (t === 'link') {
        const sel = getSelection(); if (!sel || sel.isCollapsed) { toast('Primero selecciona las palabras que quieres convertir en enlace.'); return; }
        linkRange = sel.getRangeAt(0).cloneRange();
        const cur = (sel.anchorNode?.parentElement?.closest('a') as HTMLAnchorElement | null);
        linkForm.reset(); (linkForm.elements.namedItem('url') as HTMLInputElement).value = cur?.getAttribute('href') ?? '';
        openPop('link', b);
      }
      if (t === 'doc') { docForm.reset(); $('[data-doc-err]').hidden = true; openPop('doc', b); }
      if (t === 'embed') { editing = null; embedForm.reset(); $('[data-embed-h]').textContent = 'Insertar video o publicación'; $('[data-embed-go]').textContent = 'Insertar'; embedPrev(); openPop('embed', b); }
      if (t === 'image') { editing = null; imgForm.reset(); imgData = ''; $('[data-img-prev]').hidden = true; $('[data-img-file-wrap]').hidden = false; $('[data-img-h]').textContent = 'Insertar foto'; $('[data-img-go]').textContent = 'Insertar'; openPop('image', b); }
    }));
    // Paste: plain text only (no stray styles from other sites); a lone supported link becomes an embed
    body.addEventListener('paste', (e) => {
      e.preventDefault();
      const text = e.clipboardData?.getData('text/plain') ?? '';
      if (/^https?:\/\/\S+$/.test(text.trim()) && embedFor(text.trim())) { insertBlock(`<figure class="wr-embed" data-url="${esc(text.trim())}"></figure>`); return; }
      const html = text.split(/\n{2,}/).map((p) => `<p>${esc(p).replace(/\n/g, '<br>')}</p>`).join('');
      document.execCommand('insertHTML', false, html); changed();
    });

    // ---------- photos ----------
    function shrink(file: File, max: number): Promise<string> {
      return new Promise((res, rej) => {
        const img = new Image();
        img.onload = () => { const k = Math.min(1, max / img.naturalWidth); const c = document.createElement('canvas'); c.width = Math.round(img.naturalWidth * k); c.height = Math.round(img.naturalHeight * k);
          c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(img.src); res(c.toDataURL('image/jpeg', 0.82)); };
        img.onerror = () => rej(new Error('read')); img.src = URL.createObjectURL(file);
      });
    }
    $<HTMLInputElement>('[data-photo-file]').addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0]; (e.target as HTMLInputElement).value = ''; if (!f || !cur) return;
      try { const data = await shrink(f, 1400); cur.image = await upload(data, 'foto', 'jpg'); cur.imageUrl = ''; field('imageUrl').value = ''; changed(); } catch { toast('No pudimos leer esa imagen.'); }
    });
    $('[data-photo-rm]').addEventListener('click', () => { if (!cur) return; cur.image = ''; field('imageUrl').value = ''; changed(); });

    // ---------- sources and related ----------
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement; if (!cur) return;
      if (t.closest('[data-src-add]')) {
        const n = $<HTMLInputElement>('[data-src-name]'), u = $<HTMLInputElement>('[data-src-url]');
        let name = n.value.trim(), link = u.value.trim();
        if (name.length < 2) { n.focus(); return; }
        if (/^https?:\/\/\S+$/i.test(name)) { if (!link) link = name; try { name = new URL(name).hostname.replace(/^www\./, ''); } catch { /* keep as typed */ } }
        cur.sources.push({ name: name.slice(0, 80), ...(link ? { url: link } : {}) }); n.value = ''; u.value = ''; changed();
