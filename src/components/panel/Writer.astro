      for (const o of old) {
        const u: Art = structuredClone(o); u.updated = Date.now();
        // The replaced story moves to the first spot under the new one (Portada and/or its section)
        if (a.pinned && u.pinned) { u.pinned = false; u.homeLead = true; }
        if (a.sectionPinned && u.sectionPinned && u.section === a.section) { u.sectionPinned = false; u.sectionLead = true; }
        if (!(await store(u))) continue;
        if (DB && u.slug) { const r = await publishArticle({ id: u.id, slug: u.slug, file: toFile(u), title: u.title, scheduled: u.status === 'scheduled' }); if (!r.ok) continue; }
        done.push(u.title || 'Sin titular');
      }
      return done;
    }
    const unpinNote = (titles: string[]) => (titles.length ? ` Se desfijó “${titles.join('”, “')}”.` : '');
    async function goLive(a: Art): Promise<boolean> {
      const future = new Date(a.date).valueOf() > Date.now() + 60000;
      if (!DB) {
        a.status = future ? 'scheduled' : 'published'; a.updated = Date.now(); await store(a);
        const un = await unpinOthers(a);
        toast((future ? `Programada para el ${when(a.date)}. Vista previa: con Supabase, sale sola a esa hora.` : 'Publicada. Vista previa: con Supabase, aparece en el sitio en unos 2 minutos.') + unpinNote(un));
        return true;
      }
      toast('Publicando…');
      const firstDate = !a.date; if (firstDate) a.date = localNow(); // AI drafts get their date when they're published
      const r = await publishArticle({ id: a.id, slug: slug(a), file: toFile(a), title: a.title, scheduled: future });
      if (!r.ok) { toast(`No se publicó: ${r.error}`); return false; }
      a.status = future ? 'scheduled' : 'published'; a.slug = r.slug; a.updated = Date.now();
      if (firstDate) await store(a);
      if (a.aiGen) void patchGen(a.aiGen, { status: 'published', decided_by: me()?.name ?? '', decided_at: new Date().toISOString() });
      await refresh();
      const un = await unpinOthers(a);
      if (un.length) await refresh();
      toast((future ? `Programada: sale sola el ${when(a.date)}.` : 'Publicada. Aparece en el sitio en unos 2 minutos.') + unpinNote(un));
      return true;
    }
    const goBtn = $<HTMLButtonElement>('[data-wr-go]');
    goBtn.addEventListener('click', async () => {
      if (!cur) return;
      const ok = sync();
      if (!ok && !(await ask('Faltan cosas en “Antes de publicar”. ¿Seguir de todos modos?', { ok: 'Seguir' }))) return;
      goBtn.disabled = true;
      try {
        if (!canPublish()) { cur.note = ''; if (await persist('review')) { toast('Enviada a revisión. Un editor la revisará.'); closeEditor(); } return; }
        // Save first (as it is now), then publish the saved copy
        if (!(await persist(cur.status === 'published' || cur.status === 'scheduled' ? cur.status : 'draft'))) return;
        if (await goLive(structuredClone(cur))) closeEditor();
      } finally { goBtn.disabled = false; }
    });
    $('[data-wr-back]').addEventListener('click', closeEditor);

    // ---------- "Redactar con IA" (AiDraft.astro): admin only, with the shared database ----------
    const aiBtn = $('[data-wr-ai]');
    aiBtn.addEventListener('click', () => dispatchEvent(new Event('nx-ai-open')));
    addEventListener('nx-ai-draft', async (e) => {
      const { art, genId } = (e as CustomEvent).detail as { art: Art; genId: string };
      if (!(await store(art))) return;
      await patchGen(genId, { status: 'review', article_id: art.id });
      await refresh(); tab = 'review'; $$('[data-ws]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.ws === 'review')));
      openEditor(load().find((x) => x.id === art.id) ?? art);
      toast('Guardada en “En revisión”. Revísala; solo se publica cuando tú la apruebes.');
    });
    addEventListener('nx-ai-photo', (e) => {
      const p = (e as CustomEvent).detail as { src: string; caption?: string; credit: string; creditUrl: string }; if (!cur) return;
      cur.image = ''; field('imageUrl').value = p.src; field('imageCaption').value = p.caption ?? ''; field('imageCredit').value = p.credit; field('imageCreditUrl').value = p.creditUrl; changed();
    });
    addEventListener('nx-ai-approve', () => { if (cur?.aiGen && isAdmin()) goBtn.click(); });
    addEventListener('nx-ai-reject', async () => {
      if (!cur?.aiGen || !isAdmin()) return;
      const a = cur; dirty = false; clearTimeout(timer);
      if (!(await drop(a.id))) return;
      await patchGen(a.aiGen!, wipe(a.title, me()?.name ?? '')); // the log keeps only title, links, who and when
      closeEditor(); toast('Rechazada: se borró el borrador.');
    });
    $('[data-wr-new]').addEventListener('click', () => openEditor(blank()));
    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const st = t.closest<HTMLElement>('[data-ws]');
      if (st) { tab = st.dataset.ws as Art['status']; $$('[data-ws]').forEach((b) => b.setAttribute('aria-selected', String(b === st))); renderList(); return; }
      const la = t.closest<HTMLElement>('[data-la]'); if (!la) return;
      const id = t.closest<HTMLElement>('[data-id]')!.dataset.id!; const all = load(); const a = all.find((x) => x.id === id)!;
      if (la.dataset.la === 'edit') openEditor(a);
      if (la.dataset.la === 'preview') showPreview(a);
      if (la.dataset.la === 'dup') { const { slug: _s, ...copy } = structuredClone(a); await store({ ...copy, id: `A-${Date.now().toString(36)}`, status: 'draft', title: `${a.title} (copia)`, updated: Date.now(), owner: me()?.name ?? a.owner }); renderList(); }
      if (la.dataset.la === 'del') { if (await ask(`¿Borrar “${a.title || 'Sin titular'}”?`, { ok: 'Borrar', danger: true })) { await drop(id); renderList(); } }
      if (la.dataset.la === 'approve') { (la as HTMLButtonElement).disabled = true; await goLive(structuredClone(a)); renderList(); }
      if (la.dataset.la === 'return') { const n = await askText('¿Qué debe corregir el periodista?', { placeholder: 'ej. Falta la fuente oficial del dato.', ok: 'Devolver', multiline: true }); if (n === null) return; await store({ ...a, status: 'draft', note: n, updated: Date.now() }); renderList(); }
    });
    addEventListener('beforeunload', () => { if (cur && dirty) void persist(); });
    if (DB) { $('[data-wr-list]').innerHTML = '<p class="apr-empty">Cargando las noticias del equipo…</p>'; refresh().then(renderList); } else renderList();
  }
</script>
