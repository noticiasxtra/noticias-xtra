---
// "✨ Redactar con IA" (panel → Escribir, admin only). 3 links from authorized outlets → the "redactar-ia" Edge Function
// reads them, checks they're independent, lists the facts, writes one original story from the facts only, checks it for
// copying and finds up to 3 free photos. The result is saved as a draft "En revisión"; only a person publishes it.
// Also the "IA" box inside the editor (facts, warnings, copy score, photo options, Aprobar / Editar / Rechazar)
// and the lists of authorized outlets and of generations (the log). Talks to Writer.astro with window events:
//   nx-ai-open → this window opens · nx-ai-draft {art} → Writer saves and opens the draft · nx-wr-open {art} → the box
//   nx-ai-photo {photo} · nx-ai-approve · nx-ai-reject → Writer acts on the open story
---
<dialog class="sd-dlg ai-dlg" data-ai-dlg aria-labelledby="ai-h">
  <div class="sd-form">
    <header class="sd-dlg-h"><h2 id="ai-h">✨ Redactar con IA</h2><button type="button" class="sd-x" data-ai-close aria-label="Cerrar">✕</button></header>

    <!-- 1. The links -->
    <form data-ai-form novalidate>
      <p class="pnl-muted">Pega 3 artículos sobre la <b>misma noticia</b> de fuentes autorizadas (medios con permiso y sitios oficiales). La IA saca los hechos, escribe una noticia original de Noticias Xtra y la deja <b>en revisión</b>. Nunca se publica sola.</p>
      <label>Artículo 1<input type="url" name="u1" required placeholder="https://noticel.com/…" /></label>
      <label>Artículo 2<input type="url" name="u2" required placeholder="https://…" /></label>
      <label>Artículo 3<input type="url" name="u3" required placeholder="https://…" /></label>
      <label>Notas para el redactor (opcional)<textarea name="notes" rows="2" maxlength="1000" placeholder="ej. Enfócate en el impacto en los agricultores del centro de la isla."></textarea></label>
      <p class="cm-err" data-ai-err hidden></p>
      <div class="sd-dlg-f ai-foot">
        <span><button type="button" class="pnl-link" data-ai-view="outlets">Fuentes autorizadas</button> · <button type="button" class="pnl-link" data-ai-view="log">Registro</button></span>
        <button type="submit" class="adp-btn">Redactar</button>
      </div>
    </form>

    <!-- 2. Working -->
    <div data-ai-work hidden>
      <ol class="ai-steps" data-ai-steps></ol>
      <p class="pnl-muted pnl-small">Toma de 1 a 3 minutos. No cierres esta ventana.</p>
    </div>

    <!-- 2b. A page couldn't be read: paste its text -->
    <form data-ai-paste hidden novalidate>
      <p class="sd-warn">No pudimos leer algunas páginas. Copia el texto del artículo desde el sitio y pégalo aquí (solo el texto, sin fotos).</p>
      <div data-ai-paste-list></div>
      <p class="cm-err" data-ai-perr hidden></p>
      <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-ai-restart>Empezar de nuevo</button><button type="submit" class="adp-btn">Seguir</button></div>
    </form>

    <!-- 3. Result -->
    <div data-ai-result hidden></div>

    <!-- Authorized outlets -->
    <div data-ai-outlets hidden>
      <p class="pnl-muted">Solo se pueden usar páginas de estos sitios: medios que dieron permiso y fuentes oficiales. Añade un medio <b>solo si dio permiso</b>, y anota cómo.</p>
      <ul class="ai-list" data-ai-outlet-list></ul>
      <form class="ai-add" data-ai-outlet-form novalidate>
        <input name="domain" placeholder="Dominio (ej. noticel.com)" aria-label="Dominio" required />
        <input name="name" placeholder="Nombre (ej. NotiCel)" aria-label="Nombre" required />
        <input name="permission" placeholder="Cómo dio permiso (ej. acuerdo por correo, oct. 2026)" aria-label="Permiso" required />
        <button type="submit" class="adp-btn">Añadir</button>
      </form>
      <p class="cm-err" data-ai-oerr hidden></p>
      <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-ai-view="form">← Volver</button></div>
    </div>

    <!-- Log -->
    <div data-ai-log hidden>
      <p class="pnl-muted">Cada vez que se usa Redactar con IA: quién, cuándo, con qué fuentes y qué pasó con la noticia.</p>
      <ul class="ai-list" data-ai-log-list></ul>
      <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-ai-view="form">← Volver</button></div>
    </div>
  </div>
</dialog>

<script>
  import { callAi, getGen, patchGen, listGens, listOutlets, addOutlet, removeOutlet, overlap, type AiSource, type AiPhoto, type AiGen, type AiStory } from '../../lib/ai-drafts';
  import { ask } from '../../lib/dialogs';
  const dlg = document.querySelector<HTMLDialogElement>('[data-ai-dlg]');
  if (dlg) {
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = dlg) => el.querySelector<T>(s)!;
    const esc = (s = '') => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const me = () => { try { return JSON.parse(localStorage.getItem('nx-staff') || 'null') as { name: string; role: string } | null; } catch { return null; } };
    const views = { form: '[data-ai-form]', work: '[data-ai-work]', paste: '[data-ai-paste]', result: '[data-ai-result]', outlets: '[data-ai-outlets]', log: '[data-ai-log]' } as const;
    const show = (v: keyof typeof views) => (Object.keys(views) as Array<keyof typeof views>).forEach((k) => ($(views[k]).hidden = k !== v));
    const SECS: Record<string, string> = { 'puerto-rico': 'Puerto Rico', politica: 'Política', gobierno: 'Gobierno', 'estados-unidos': 'Estados Unidos', mundo: 'Mundo', economia: 'Economía', deportes: 'Deportes', entretenimiento: 'Entretenimiento', clima: 'Clima', salud: 'Salud' };
    const PROV: Record<AiPhoto['provider'], string> = { biblioteca: 'Biblioteca de Noticias Xtra', wikimedia: 'Wikimedia Commons', pexels: 'Pexels', unsplash: 'Unsplash' };
    let busy = false;

    addEventListener('nx-ai-open', () => { if (busy) { dlg.showModal(); return; } $<HTMLFormElement>('[data-ai-form]').reset(); $('[data-ai-err]').hidden = true; show('form'); dlg.showModal(); });
    $('[data-ai-close]').addEventListener('click', async () => { if (busy && !(await ask('La IA todavía está trabajando. ¿Cerrar de todos modos? Se pierde este intento.', { ok: 'Cerrar' }))) return; busy = false; dlg.close(); });
    dlg.addEventListener('cancel', (e) => { if (busy) e.preventDefault(); });
    dlg.addEventListener('click', (e) => { const v = (e.target as HTMLElement).closest<HTMLElement>('[data-ai-view]'); if (!v) return; const k = v.dataset.aiView as keyof typeof views; show(k); if (k === 'outlets') void paintOutlets(); if (k === 'log') void paintLog(); });

    // ---------- progress ----------
    const STEPS = ['Leyendo las fuentes', 'Revisando que sean independientes', 'Sacando los hechos', 'Escribiendo la noticia', 'Revisando que no haya copia', 'Buscando fotos'];
    const step = (n: number) => { $('[data-ai-steps]').innerHTML = STEPS.map((t, i) => `<li class="${i < n ? 'ok' : i === n ? 'on' : ''}">${i < n ? '✓' : i === n ? '…' : '○'} ${t}</li>`).join(''); };
    const fail = (msg: string) => { busy = false; show('form'); const e = $('[data-ai-err]'); e.textContent = msg; e.hidden = false; };

    // ---------- run ----------
    let notes = '', srcs: Array<AiSource | null> = [], urls: string[] = [];
    $<HTMLFormElement>('[data-ai-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); $('[data-ai-err]').hidden = true;
      const f = new FormData(e.target as HTMLFormElement);
      urls = ['u1', 'u2', 'u3'].map((k) => String(f.get(k) || '').trim()); notes = String(f.get('notes') || '').trim();
      if (urls.some((u) => !/^https?:\/\/\S+\.\S+/.test(u))) return fail('Pega los 3 enlaces completos (empiezan con https://).');
      busy = true; show('work'); step(0);
      const r = await callAi<{ results: Array<{ ok: boolean; source?: AiSource; url?: string; error?: string }> }>('fetch', { urls });
      if (r.error) return fail(r.error);
      srcs = r.results.map((x) => (x.ok ? x.source! : null));
      if (srcs.every(Boolean)) return void facts();
      // Some pages couldn't be read: ask for their text (an unauthorized outlet can't be pasted either)
      const blocked = r.results.find((x) => !x.ok && /fuentes autorizadas/.test(x.error || ''));
      if (blocked) return fail(`${blocked.url}: ${blocked.error}`);
      $('[data-ai-paste-list]').innerHTML = r.results.map((x, i) => x.ok ? '' : `<fieldset data-pi="${i}"><legend>Artículo ${i + 1}</legend><p class="cm-err">${esc(x.error || '')}</p><p class="pnl-small"><a href="${esc(x.url || '')}" target="_blank" rel="noopener">${esc(x.url || '')} ↗</a></p>
        <label>Titular<input name="title" maxlength="200" /></label><label>Autor (si aparece)<input name="author" maxlength="120" /></label><label>Fecha (si aparece)<input name="date" maxlength="40" placeholder="ej. 3 de octubre de 2026" /></label>
        <label>Texto del artículo<textarea name="text" rows="8" required></textarea></label></fieldset>`).join('');
      busy = false; show('paste');
    });
    $('[data-ai-restart]').addEventListener('click', () => show('form'));
    $<HTMLFormElement>('[data-ai-paste]').addEventListener('submit', (e) => {
      e.preventDefault(); const err = $('[data-ai-perr]'); err.hidden = true;
      for (const fs of dlg.querySelectorAll<HTMLFieldSetElement>('[data-pi]')) {
        const i = Number(fs.dataset.pi); const v = (n: string) => (fs.querySelector<HTMLInputElement>(`[name="${n}"]`)!.value || '').trim();
        const text = v('text'); if ((text.match(/\S+/g) || []).length < 80) { err.textContent = `El texto del artículo ${i + 1} es muy corto: pega el artículo completo.`; err.hidden = false; return; }
        srcs[i] = { url: urls[i], outlet: '', title: v('title'), author: v('author'), date: v('date'), text, words: 0, links: [], pasted: true };
      }
      busy = true; show('work'); void facts();
    });

    async function facts() {
      step(1); await new Promise((r) => setTimeout(r, 300)); step(2);
      const f = await callAi<{ genId: string }>('facts', { sources: srcs, notes });
      if (f.error) return fail(f.error);
      step(3);
      const w = await callAi<{ story: AiStory; overlap: number; overlapSpans: string[]; warnings: string[]; suggestions: string[] }>('write', { genId: f.genId });
      if (w.error) return fail(w.error);
      step(5);
      const p = await callAi<{ options: AiPhoto[]; note: string }>('photos', { genId: f.genId });
      const gen = await getGen(f.genId);
      busy = false;
      if (!gen) return fail('No pudimos leer el resultado. Revisa “Registro”.');
      result(gen, p.error ? `No se pudieron buscar fotos: ${p.error}` : p.note);
    }

    // ---------- the result: a quick look, then save as a draft for approval ----------
    let chosen = 0;
    function result(g: AiGen, photoNote: string) {
      const s = g.story!; chosen = g.photo_options.length ? 0 : -1;
      const paint = () => { $('[data-ai-result]').innerHTML = `
        ${box(g, { compact: true })}
        <h3 class="ai-t">${esc(s.title)}</h3><p class="pnl-muted">${esc(s.description)}</p>
        <p class="pnl-small">${esc(SECS[s.section] ?? s.section)}${s.place ? ` · ${esc(s.place)}` : ''} · ${s.words} palabras</p>
        <div class="ai-body body">${s.body}</div>
        <h4 class="pnl-h4">Foto</h4>${photos(g.photo_options, chosen)}${photoNote ? `<p class="sd-warn">${esc(photoNote)}</p>` : ''}
        <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-ai-discard>Descartar</button><button type="button" class="adp-btn" data-ai-save>Guardar para aprobar</button></div>`; };
      paint(); show('result');
      $('[data-ai-result]').onclick = async (e) => {
        const t = e.target as HTMLElement;
        const pick = t.closest<HTMLElement>('[data-ai-pick]'); if (pick) { chosen = Number(pick.dataset.aiPick); paint(); return; }
        if (t.closest('[data-ai-discard]')) { if (await ask('¿Descartar esta noticia? Queda en el registro como rechazada.', { ok: 'Descartar', danger: true })) { await patchGen(g.id, { status: 'rejected', decided_by: me()?.name ?? '', decided_at: new Date().toISOString() }); dlg.close(); } return; }
        if (t.closest('[data-ai-save]')) {
          const ph = g.photo_options[chosen];
          if (ph?.provider === 'unsplash' && ph.downloadLocation) void callAi('unsplash', { downloadLocation: ph.downloadLocation });
          dispatchEvent(new CustomEvent('nx-ai-draft', { detail: { genId: g.id, art: {
            id: `A-${Date.now().toString(36)}`, status: 'review', updated: Date.now(), owner: me()?.name ?? '', aiGen: g.id, aiAssisted: true,
            title: s.title, description: s.description, section: s.section, league: s.league, place: s.place, author: '', date: '',
            image: '', imageUrl: ph?.src ?? '', imageCaption: ph?.caption ?? '', imageCredit: ph?.credit ?? '', imageCreditUrl: ph?.creditUrl ?? '',
            breaking: false, trending: false, featured: false, live: false, pinned: false, homeLead: false, sectionLead: false, sectionPinned: false,
            sources: s.sources, related: s.related, correction: '', body: s.body } } }));
          dlg.close();
        }
      };
    }

    // ---------- shared pieces ----------
    function photos(opts: AiPhoto[], cur: number, current?: string) {
      if (!opts.length) return '<p class="pnl-muted pnl-small">Sin opciones de foto.</p>';
      return `<ul class="ai-photos">${opts.map((p, i) => { const on = current ? current === p.src : i === cur; return `<li class="${on ? 'on' : ''}">
        <img src="${esc(p.thumb)}" alt="${esc(p.caption || '')}" loading="lazy" />
        <p class="pnl-small">${esc(p.caption || '')}</p><p class="ai-lic">${esc(p.credit)} · <a href="${esc(p.creditUrl)}" target="_blank" rel="noopener">licencia ↗</a><br>${esc(PROV[p.provider])}</p>
        <button type="button" class="${on ? 'adp-btn' : 'adp-btn ghost-dark'}" data-ai-pick="${i}">${on ? '✓ Escogida' : 'Usar esta'}</button></li>`; }).join('')}</ul>`;
    }
    function box(g: AiGen, o: { compact?: boolean; text?: string } = {}) {
      const ov = o.text != null ? overlap(o.text, g.sources.map((x) => x.text)) : { score: g.overlap ?? 0, spans: g.overlap_spans ?? [] };
      const lvl = ov.spans.length ? 'bad' : ov.score > 0 ? 'mid' : 'ok';
      const warns = (g.warnings ?? []).filter((w) => !/^Copia:/.test(w) || ov.spans.length);
      return `<div class="ai-box">
        <p class="ai-tag">✨ Generado con asistencia de IA · ${esc(g.created_by_name || '')} · ${new Date(g.created_at).toLocaleString('es-PR', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' })}</p>
        ${g.independent ? '' : '<p class="ai-bad">⚠ Fuentes no independientes</p>'}
        ${warns.length ? `<ul class="ai-warn">${warns.map((w) => `<li>${esc(w)}</li>`).join('')}</ul>` : ''}
        <p class="ai-ov ${lvl}">Parecido con las fuentes: <b>${ov.score} %</b> ${ov.spans.length ? `· ${ov.spans.length} pasaje(s) de 8+ palabras iguales` : '· sin pasajes copiados'}</p>
        ${ov.spans.length ? `<ul class="ai-spans">${ov.spans.map((x) => `<li>«${esc(x)}»</li>`).join('')}</ul>` : ''}
        ${g.suggestions?.length ? `<ul class="ai-sug">${g.suggestions.map((x) => `<li>💡 ${esc(x)}</li>`).join('')}</ul>` : ''}
        ${o.compact ? '' : `<details><summary>Fuentes (${g.sources.length})</summary><ol class="ai-srcs">${g.sources.map((x) => `<li><a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.title || x.url)}</a><br><span class="pnl-small">${esc(x.outlet)}${x.author ? ` · ${esc(x.author)}` : ''}${x.date ? ` · ${esc(x.date.slice(0, 10))}` : ''} · ${x.words} palabras${x.pasted ? ' · texto pegado a mano' : ''}</span></li>`).join('')}</ol></details>
        <details><summary>Hechos (${g.facts?.hechos.length ?? 0})</summary><ol class="ai-facts">${(g.facts?.hechos ?? []).map((h) => `<li>${esc(h.hecho)}${h.cita ? `<br><i>“${esc(h.cita)}” — ${esc(h.quien)}</i>` : ''} <span class="ai-src">${esc(h.medios.join(', '))}</span>${h.exclusivo ? ` <span class="ai-ex">exclusivo de ${esc(h.exclusivo)}</span>` : ''}</li>`).join('')}</ol></details>`}
      </div>`;
    }

    // ---------- the box inside the editor (only for AI drafts) ----------
    let open: { genId: string; gen: AiGen | null } | null = null;
    const slot = () => document.querySelector<HTMLElement>('[data-ai-box]');
    async function paintBox(curPhoto?: string) {
      const el = slot(); if (!el || !open) return;
      if (me()?.role !== 'admin') { el.hidden = false; el.innerHTML = '<div class="ai-box"><p class="ai-tag">✨ Borrador de IA</p><p class="pnl-small">Lo revisa y lo aprueba el administrador.</p></div>'; return; }
      open.gen ??= await getGen(open.genId);
      const g = open.gen; if (!g) { el.hidden = false; el.innerHTML = '<div class="ai-box"><p class="cm-err">No pudimos cargar los datos de la IA.</p></div>'; return; }
      const text = (document.querySelector<HTMLElement>('[data-body]')?.innerText ?? '');
      el.hidden = false;
      el.innerHTML = `<div class="pnl-card ai-card"><h2 class="pnl-h3">Borrador de IA</h2>${box(g, { text })}
        <button type="button" class="pnl-link" data-ai-recheck>Volver a revisar copia</button>
        <h3 class="pnl-h4">Fotos</h3>${photos(g.photo_options, -1, curPhoto)}
        <div class="ai-acts"><button type="button" class="adp-btn" data-ai-approve>Aprobar y publicar</button><button type="button" class="adp-btn ghost-dark" data-ai-edit>Editar</button><button type="button" class="apr-reject" data-ai-reject>Rechazar</button></div></div>`;
    }
    addEventListener('nx-wr-open', (e) => {
      const a = (e as CustomEvent).detail?.art as { aiGen?: string; imageUrl?: string; image?: string } | null;
      const el = slot(); if (!el) return;
      if (!a?.aiGen) { open = null; el.hidden = true; el.innerHTML = ''; return; }
      open = { genId: a.aiGen, gen: open?.genId === a.aiGen ? open.gen : null }; void paintBox(a.imageUrl || a.image);
    });
    document.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement; const el = slot(); if (!el || !open || !el.contains(t) || !open.gen) return;
      if (t.closest('[data-ai-recheck]')) { void paintBox(); return; }
      const pick = t.closest<HTMLElement>('[data-ai-pick]');
      if (pick) {
        const ph = open.gen.photo_options[Number(pick.dataset.aiPick)];
        if (ph.provider === 'unsplash' && ph.downloadLocation) void callAi('unsplash', { downloadLocation: ph.downloadLocation });
        dispatchEvent(new CustomEvent('nx-ai-photo', { detail: ph })); void paintBox(ph.src); return;
      }
      if (t.closest('[data-ai-edit]')) { document.querySelector<HTMLElement>('[data-f="title"]')?.focus(); scrollTo({ top: 0, behavior: 'smooth' }); return; }
      if (t.closest('[data-ai-approve]')) { dispatchEvent(new Event('nx-ai-approve')); return; }
      if (t.closest('[data-ai-reject]')) { if (await ask('¿Rechazar esta noticia? Se borra el borrador; el registro guarda quién la rechazó.', { ok: 'Rechazar y borrar', danger: true })) dispatchEvent(new Event('nx-ai-reject')); }
    });

    // ---------- authorized outlets ----------
    async function paintOutlets() {
      const list = await listOutlets(); const ul = $('[data-ai-outlet-list]');
      if (!list) { ul.innerHTML = '<li class="cm-err">No pudimos cargar la lista. ¿Corriste supabase/ai-drafts.sql?</li>'; return; }
      ul.innerHTML = list.map((o) => `<li><span><b>${esc(o.name)}</b> · ${esc(o.domain)}<br><span class="pnl-small">${esc(o.permission || 'sin nota de permiso')} · añadido por ${esc(o.added_by || '—')}</span></span><button type="button" class="pnl-link" data-ai-orm="${esc(o.domain)}">Quitar</button></li>`).join('') || '<li class="pnl-muted">No hay fuentes autorizadas.</li>';
    }
    $<HTMLFormElement>('[data-ai-outlet-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); const f = new FormData(e.target as HTMLFormElement); const err = $('[data-ai-oerr]'); err.hidden = true;
      const domain = String(f.get('domain') || '').trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/.*$/, '');
      const name = String(f.get('name') || '').trim(), permission = String(f.get('permission') || '').trim();
      if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(domain) || !name || permission.length < 4) { err.textContent = 'Escribe el dominio (ej. noticel.com), el nombre y cómo dio permiso.'; err.hidden = false; return; }
      const bad = await addOutlet({ domain, name, permission, added_by: me()?.name ?? '' });
      if (bad) { err.textContent = bad; err.hidden = false; return; }
      (e.target as HTMLFormElement).reset(); void paintOutlets();
    });
    $('[data-ai-outlet-list]').addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ai-orm]'); if (!b) return;
      if (await ask(`¿Quitar ${b.dataset.aiOrm} de las fuentes autorizadas?`, { ok: 'Quitar', danger: true })) { await removeOutlet(b.dataset.aiOrm!); void paintOutlets(); }
    });

    // ---------- log ----------
    const ST: Record<AiGen['status'], string> = { started: 'Sin terminar', review: 'En revisión', published: 'Publicada', rejected: 'Rechazada' };
    async function paintLog() {
      const rows = await listGens(); const ul = $('[data-ai-log-list]');
      ul.innerHTML = rows.map((g: AiGen & { title?: string }) => `<li><span><b>${esc(g.title || 'Sin noticia')}</b><br><span class="pnl-small">${new Date(g.created_at).toLocaleString('es-PR', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' })} · ${esc(g.created_by_name || '—')} · ${ST[g.status]}${g.decided_by ? ` por ${esc(g.decided_by)}` : ''}</span><br>${g.urls.map((u) => `<a class="pnl-small" href="${esc(u)}" target="_blank" rel="noopener">${esc(u.replace(/^https?:\/\/(www\.)?/, '').slice(0, 70))}</a>`).join('<br>')}</span></li>`).join('') || '<li class="pnl-muted">Todavía no hay nada en el registro.</li>';
    }
  }
</script>
