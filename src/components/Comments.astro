---
// Comments under each story, Instagram style: avatar, name, text, likes, replies, stickers.
// DEMO: there is no server yet, so new comments are saved only in this reader's browser
// (localStorage 'nx-comments-<story id>'), and the sample comments are marked EJEMPLO.
// When a real service is connected (e.g. Supabase), this component is where it plugs in.
interface Props { storyId: string; kind?: 'story' | 'game' }
const { storyId, kind = 'story' } = Astro.props;
// Sample comments: invented usernames, clearly labeled as examples
const SAMPLES = kind === 'game' ? [
  { id: 's1', name: 'tito_domino', text: '¡Hoy llegué a 100 primero! Este juego me tiene enganchao. 🔥', likes: 18, ago: 'hace 1 h', level: 'diamante' },
  { id: 's2', name: 'la_nena_de_caguas', text: '¿Alguien más se tranca siempre en el nivel difícil? Denme un truco.', likes: 9, ago: 'hace 3 h', level: 'top' },
  { id: 's3', name: 'abuela_sudoku', text: 'Lo juego todas las mañanas con el café. ☕', likes: 6, ago: 'hace 6 h', level: 'voz', media: 'gif-cafe' },
] : [
  { id: 's1', name: 'lectora_bayamon', text: 'Muy buena información, gracias por explicarlo claro. 👏', likes: 24, ago: 'hace 2 h', level: 'diamante' },
  { id: 's2', name: 'jose.boricua', text: 'Esto hay que seguirlo de cerca. ¿Habrá vistas públicas?', likes: 11, ago: 'hace 3 h', level: 'top' },
  { id: 's3', name: 'abuela_de_ponce', text: '🇵🇷🙏', likes: 7, ago: 'hace 5 h', level: 'comentarista', media: 'te-quiero-pr' },
];
// Commenter levels (src/lib/reputation.ts): badge shown next to the name
import { LEVELS, RULES, LEVEL_INFO, SPECIALS } from '../lib/reputation';
import { BADGE } from '../lib/badges';
const levelName = (id: string) => LEVELS.find((l) => l.id === id)?.name ?? '';
const STICKERS = ['👏', '🔥', '❤️', '😂', '😮', '😢', '🙏', '🇵🇷', '💯', '⚾', '🏀', '🎶'];
// Our own drawn stickers and animated "GIFs Xtra" (public/stickers/); GIPHY search shows too when SITE.giphyKey is set
import { SITE, url } from '../lib/site';
const STICKER_IMGS = [['wepa', '¡Wepa!'], ['coqui', 'Coquí'], ['bandera', 'Bandera de Puerto Rico'], ['te-quiero-pr', 'Te quiero PR'], ['jajaja', 'Jajaja'], ['fuego', 'Fuego'],
  ['palante', "¡Pa'lante!"], ['que-bueno', '¡Qué bueno!'], ['bravo', '¡Bravo!'], ['cafe', 'Buenos días'], ['capicu', '¡Capicú!']];
const GIF_IMGS = [['gif-wepa', '¡Wepa! animado'], ['gif-coqui', 'Coquí saltando'], ['gif-bandera', 'Bandera ondeando'], ['gif-corazon', 'Corazón latiendo'],
  ['gif-jajaja', 'Jajaja animado'], ['gif-fuego', 'Fuego animado'], ['gif-bravo', '¡Bravo! con destellos'], ['gif-cafe', 'Café humeante']];
---
<section class="cm" id="comentarios" data-comments={storyId} data-badges={JSON.stringify(BADGE)} aria-labelledby="cm-h">
  <div class="cm-head">
    <h2 id="cm-h">Comentarios <span data-cm-count></span></h2>
    <span class="sp-demo">DEMO</span>
  </div>
  <p class="cm-note">Vista previa de los comentarios: lo que escribas se guarda solo en este dispositivo.</p>

  <form class="cm-form" data-cm-form novalidate>
    <span class="cm-av me" data-cm-me aria-hidden="true">T</span>
    <div class="cm-box">
      <label for={`cm-text-${storyId}`} class="sr">Escribe un comentario</label>
      <textarea id={`cm-text-${storyId}`} rows="1" maxlength="500" placeholder="Añade un comentario…"></textarea>
      <div class="cm-media-prev" data-media-prev hidden><img alt="" /><button type="button" data-media-rm aria-label="Quitar">✕</button></div>
      <div class="cm-picker" data-picker hidden>
        <div class="cm-pk-grid emoji" data-pane="emoji">{STICKERS.map((s) => <button type="button" data-stk={s} aria-label={`Emoji ${s}`}>{s}</button>)}</div>
        <div class="cm-pk-grid" data-pane="sticker" hidden>{STICKER_IMGS.map(([id, alt]) => <button type="button" data-media="sticker" data-src={url(`stickers/${id}.svg`)} aria-label={alt} title={alt}><img src={url(`stickers/${id}.svg`)} alt="" /></button>)}</div>
        <div data-pane="gif" hidden data-giphy={SITE.giphyKey}>
          {SITE.giphyKey && <input type="search" class="cm-gif-q" data-gif-q placeholder="Buscar GIF…" />}
          <div class="cm-pk-grid" data-gif-grid>{GIF_IMGS.map(([id, alt]) => <button type="button" data-media="gif" data-src={url(`stickers/${id}.svg`)} aria-label={alt} title={alt}><img src={url(`stickers/${id}.svg`)} alt="" /></button>)}</div>
          <p class="cm-pk-note">{SITE.giphyKey ? 'Busca en GIPHY o usa los GIFs Xtra.' : 'GIFs Xtra animados. Muy pronto podrás buscar más GIFs.'}</p>
        </div>
      </div>
      <div class="cm-tools">
        <div class="cm-pick-btns" role="group" aria-label="Agregar">
          <button type="button" data-pick-tab="emoji" aria-label="Emojis" aria-pressed="false">😊</button>
          <button type="button" data-pick-tab="sticker" aria-pressed="false">Sticker</button>
          <button type="button" data-pick-tab="gif" aria-pressed="false">GIF</button>
        </div>
        <span class="cm-err" data-cm-err hidden></span>
        <button type="submit" class="cm-send">Publicar</button>
      </div>
    </div>
  </form>

  <p class="cm-repnote" data-cm-repnote hidden></p>
  <details class="cm-rep" data-cm-rep>
    <summary>Tu nivel: <b data-rep-level>Nuevo</b> · <span data-rep-pts>0</span> puntos de reputación · <u>qué significan las insignias</u></summary>
    <div class="cm-rep-body">
      <p class="cm-rep-next" data-rep-next></p>
      <ul class="cm-rep-needs" data-rep-needs></ul>
      <div class="cm-guide">
        <p class="cm-guide-h">¿Qué significan las insignias?</p>
        <p class="cm-guide-sub">Niveles: se muestra uno junto a tu nombre, el más alto que tengas.</p>
        <ul>
          {LEVELS.slice(1).map((l) => (
            <li><span class={`cm-badge cm-b-${l.id}`}><Fragment set:html={BADGE[l.id]} /> {l.name}</span><span><b>{LEVEL_INFO[l.id].means}</b> {LEVEL_INFO[l.id].how}</span></li>
          ))}
        </ul>
        <p class="cm-guide-sub">Insignias especiales: se coleccionan y aparecen en tu perfil.</p>
        <ul data-specials>
          {SPECIALS.map((x) => (
            <li data-special={x.id}><span class={`cm-badge cm-b-${x.id}`}><Fragment set:html={BADGE[x.id]} /> {x.name}</span><span><b>{x.means}</b> {x.how}</span><i class="cm-got" aria-label="Ganada">✓</i></li>
          ))}
        </ul>
      </div>
      <ul class="cm-rep-rules">
        <li>+{RULES.comment} por comentario de {RULES.minChars} caracteres o más (+{RULES.reply} si es respuesta); cuentan hasta {RULES.perDay} al día.</li>
        <li>+{RULES.like} por cada Me gusta de otro lector · +{RULES.featured} si la redacción destaca tu comentario.</li>
        <li>{RULES.report} si un comentario tuyo es reportado y ocultado. Los comentarios con insultos, amenazas, odio, datos personales o spam se ocultan solos; los dudosos los revisa la redacción. Top comentarista y Diamante se pierden con un reporte.</li>
        <li>Si borras un comentario, se restan sus puntos. Stickers y respuestas cortas no suman.</li>
      </ul>
      <p class="cm-rep-demo">Vista previa: tu reputación se guarda en este dispositivo. Los Me gusta de otros y los destacados llegarán con las cuentas.</p>
    </div>
  </details>

  <ul class="cm-list" data-cm-list>
    {SAMPLES.map((c) => (
      <li class="cm-item" data-id={c.id} data-likes={c.likes}>
        <span class="cm-av" aria-hidden="true">{c.name[0].toUpperCase()}</span>
        <div class="cm-body">
          <p><b>{c.name}</b> <span class={`cm-badge cm-b-${c.level}`} title={levelName(c.level)}><Fragment set:html={BADGE[c.level]} /> {levelName(c.level)}</span> <span class="sp-demo">EJEMPLO</span> <span class="cm-text">{c.text}</span></p>
          {'media' in c && c.media && <img class="cm-media" src={url(`stickers/${c.media}.svg`)} alt="Sticker" loading="lazy" />}
          <div class="cm-meta"><span>{c.ago}</span><span data-likes-label>{c.likes} Me gusta</span><button type="button" data-reply>Responder</button><button type="button" data-report>Reportar</button></div>
        </div>
        <button type="button" class="cm-like" data-like aria-pressed="false" aria-label="Me gusta">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1 8.3 3.2 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.8 0 6 3.8 4.5 7.3C19.5 16.4 12 21 12 21z" /></svg>
          <span class="cm-like-n" data-like-n>{c.likes}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<script>
  import { addComment, removeComment, getRep, levelOf, needs, specialsOf, RULES, SPECIALS } from '../lib/reputation';
  import { notify } from '../lib/notifications';
  import { accountsOn, loggedIn, askLogin, api, myId } from '../lib/account';
  import { assess, judgeReport, getReports, saveReports, upsertReport, isHidden, myReports, saveMyReports, isWeakReporter, REPORT_REASONS, type Report } from '../lib/moderation';
  type Mine = { id: string; name: string; text: string; at: number; replyTo?: string; media?: { kind: string; src: string } };
  const store = {
    get: <T,>(k: string, d: T): T => { try { return JSON.parse(localStorage.getItem(k) || '') ?? d; } catch { return d; } },
    set: (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* storage blocked */ } },
  };
  const profile = store.get<{ name?: string; photo?: string }>('nx-profile', {});
  const myName = profile.name || 'Tú';
  // Comment text with @mentions highlighted (built from text nodes, never HTML)
  const fillText = (el: Element, text: string) => {
    el.replaceChildren(...text.split(/(@[\p{L}\p{N}._]+)/u).map((part) => {
      if (!part.startsWith('@')) return document.createTextNode(part);
      const at = document.createElement('span'); at.className = 'cm-at'; at.textContent = part; return at;
    }));
  };
  const ago = (t: number) => { const m = Math.round((Date.now() - t) / 60000); return m < 1 ? 'ahora' : m < 60 ? `hace ${m} min` : m < 1440 ? `hace ${Math.round(m / 60)} h` : `hace ${Math.round(m / 1440)} d`; };

  // Sticker/emoji/GIF picker and the growing text box (shared by preview and real comments)
  function setupPicker(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-cm-form]')!;
    const ta = form.querySelector('textarea')!;
    const err = root.querySelector<HTMLElement>('[data-cm-err]')!;
    const picker = root.querySelector<HTMLElement>('[data-picker]')!;
    const prev = root.querySelector<HTMLElement>('[data-media-prev]')!;
    let media: Mine['media'];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-pick-tab]')];
    tabs.forEach((b) => b.addEventListener('click', () => {
      const open = b.getAttribute('aria-pressed') !== 'true';
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(open && x === b)));
      picker.hidden = !open;
      picker.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== b.dataset.pickTab));
    }));
    const close = () => { picker.hidden = true; tabs.forEach((x) => x.setAttribute('aria-pressed', 'false')); };
    root.querySelectorAll<HTMLButtonElement>('[data-stk]').forEach((b) => b.addEventListener('click', () => { ta.value += b.dataset.stk; ta.focus(); close(); }));
    const setMedia = (m: Mine['media']) => { media = m; prev.hidden = !m; if (m) prev.querySelector('img')!.src = m.src; dispatchEvent(new Event('nx-media')); };
    picker.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-media]');
      if (b) { setMedia({ kind: b.dataset.media!, src: b.dataset.src! }); close(); err.hidden = true; }
    });
    prev.querySelector('[data-media-rm]')!.addEventListener('click', () => setMedia(undefined));
    // GIPHY search (only when a key is set in SITE.giphyKey); G-rated results only
    const gifPane = picker.querySelector<HTMLElement>('[data-giphy]');
    const gifQ = picker.querySelector<HTMLInputElement>('[data-gif-q]');
    if (gifPane?.dataset.giphy && gifQ) {
      const grid = gifPane.querySelector<HTMLElement>('[data-gif-grid]')!; const own = grid.innerHTML; let t = 0;
      gifQ.addEventListener('input', () => {
        clearTimeout(t);
        t = window.setTimeout(async () => {
          const q = gifQ.value.trim(); if (!q) { grid.innerHTML = own; return; }
          try {
            const d = await (await fetch(`https://api.giphy.com/v1/gifs/search?api_key=${gifPane.dataset.giphy}&q=${encodeURIComponent(q)}&limit=18&rating=g&lang=es`)).json();
            grid.innerHTML = d.data.map((g: any) => `<button type="button" data-media="gif" data-src="${g.images.fixed_width.url}" aria-label="${(g.title || 'GIF').replace(/"/g, '')}"><img src="${g.images.fixed_width_small.url}" alt="" loading="lazy" /></button>`).join('') || '<p class="cm-pk-note">Sin resultados.</p>';
          } catch { grid.innerHTML = own; }
        }, 400);
      });
    }
    ta.addEventListener('input', () => { err.hidden = true; ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight}px`; });
    return { media: () => media, setMedia, close };
  }

  document.querySelectorAll<HTMLElement>('[data-comments]').forEach((root) => {
    if (accountsOn()) { live(root); return; } // real comments (Supabase): see live() below
    const key = `nx-comments-${root.dataset.comments}`;
    const likesKey = `nx-likes-${root.dataset.comments}`;
    const list = root.querySelector<HTMLUListElement>('[data-cm-list]')!;
    const form = root.querySelector<HTMLFormElement>('[data-cm-form]')!;
    const ta = form.querySelector('textarea')!;
    const err = root.querySelector<HTMLElement>('[data-cm-err]')!;
    const count = root.querySelector<HTMLElement>('[data-cm-count]')!;
    // The reader's own avatar: their profile photo if they added one (/perfil), otherwise their initial
    const myAvatar = (el: HTMLElement) => {
      el.textContent = profile.photo ? '' : myName[0].toUpperCase();
      el.style.backgroundImage = profile.photo ? `url("${profile.photo}")` : '';
      el.classList.toggle('has-photo', !!profile.photo);
    };
    myAvatar(root.querySelector<HTMLElement>('[data-cm-me]')!);
    let replyTo: string | undefined;
    let warned = ''; // text that already got the "doubtful" warning once

    const liked = new Set(store.get<string[]>(likesKey, []));
    const wireLike = (li: HTMLElement) => {
      const btn = li.querySelector<HTMLButtonElement>('[data-like]')!;
      const label = li.querySelector<HTMLElement>('[data-likes-label]')!;
      const base = Number(li.dataset.likes || 0);
      const paint = () => {
        const on = liked.has(li.dataset.id!);
        btn.setAttribute('aria-pressed', String(on));
        const n = base + (on ? 1 : 0);
        label.textContent = n ? `${n} Me gusta` : '';
        const cnt = btn.querySelector<HTMLElement>('[data-like-n]'); if (cnt) cnt.textContent = n ? String(n) : '';
      };
      btn.addEventListener('click', () => {
        liked.has(li.dataset.id!) ? liked.delete(li.dataset.id!) : liked.add(li.dataset.id!); store.set(likesKey, [...liked]); paint();
        if (liked.has(li.dataset.id!)) { btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop'); }
      });
      li.querySelector('[data-reply]')?.addEventListener('click', () => {
        replyTo = li.dataset.id;
        const who = li.querySelector('b')?.textContent || '';
        ta.value = `@${who} `; ta.focus();
      });
      paint();
    };

    const render = () => {
      list.querySelectorAll('.cm-item.mine').forEach((x) => x.remove());
      const mine = store.get<Mine[]>(key, []);
      mine.forEach((c) => {
        const li = document.createElement('li');
        li.className = `cm-item mine${c.replyTo ? ' reply' : ''}`;
        li.dataset.id = c.id; li.dataset.likes = '0';
        li.innerHTML = `<span class="cm-av me" aria-hidden="true"></span><div class="cm-body"><p><b></b> <span class="cm-text"></span></p><div class="cm-meta"><span></span><span data-likes-label></span><button type="button" data-reply>Responder</button><button type="button" data-del>Borrar</button></div></div><button type="button" class="cm-like" data-like aria-pressed="false" aria-label="Me gusta"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1 8.3 3.2 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.8 0 6 3.8 4.5 7.3C19.5 16.4 12 21 12 21z" /></svg><span class="cm-like-n" data-like-n></span></button>`;
        if (c.media) { const im = document.createElement('img'); im.className = 'cm-media'; im.src = c.media.src; im.alt = c.media.kind === 'gif' ? 'GIF' : 'Sticker'; im.loading = 'lazy'; li.querySelector('.cm-body p')!.after(im); }
        myAvatar(li.querySelector<HTMLElement>('.cm-av')!);
        li.querySelector('b')!.textContent = c.name;
        const lv = levelOf(getRep());
        if (lv.index > 0) { const bd = document.createElement('span'); bd.className = `cm-badge cm-b-${lv.id}`; bd.innerHTML = `${JSON.parse(root.dataset.badges || '{}')[lv.id] ?? ''} `; bd.append(lv.name); li.querySelector('b')!.after(' ', bd); }
        fillText(li.querySelector('.cm-text')!, c.text);
        li.querySelector('.cm-meta span')!.textContent = ago(c.at);
        li.querySelector('[data-del]')!.addEventListener('click', () => { store.set(key, store.get<Mine[]>(key, []).filter((x) => x.id !== c.id)); removeComment(c.id); saveReports(getReports().filter((x) => x.id !== `${sid}:${c.id}`)); render(); });
        const parent = c.replyTo ? list.querySelector(`[data-id="${c.replyTo}"]`) : null;
        if (parent) parent.after(li); else list.prepend(li);
        wireLike(li);
      });
      count.textContent = `(${list.querySelectorAll('.cm-item').length})`;
      applyMod();
    };

    // Moderation: hide comments that were hidden automatically, removed by the newsroom, or reported by 3+ readers
    const sid = root.dataset.comments!;
    const applyMod = () => {
      const reps = getReports().filter((r) => r.storyId === sid);
      const done = myReports().ids;
      list.querySelectorAll<HTMLElement>('.cm-item').forEach((li) => {
        const r = reps.find((x) => x.commentId === li.dataset.id);
        const hid = !!r && isHidden(r);
        li.classList.toggle('cm-hidden', hid);
        li.querySelector('.cm-hid-note')?.remove();
        if (hid) {
          const n = document.createElement('p'); n.className = 'cm-hid-note';
          n.textContent = r!.status === 'review' ? 'Comentario oculto mientras la redacción lo revisa.' : r!.mine ? `Tu comentario fue ocultado por incumplir las reglas (${RULES.report} de reputación).` : 'Comentario oculto por incumplir las reglas de la comunidad.';
          li.querySelector('.cm-body')!.prepend(n);
        }
        const rb = li.querySelector<HTMLButtonElement>('[data-report]');
        if (rb && done.includes(`${sid}:${li.dataset.id}`)) { rb.textContent = 'Reportado'; rb.disabled = true; }
      });
    };
    const textOf = (li: HTMLElement) => li.querySelector('.cm-text')?.textContent?.trim() ?? '';
    // Report: pick a reason → the automatic check decides (hide now / keep / send to the newsroom's queue)
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-report]');
      if (!b || b.disabled) return;
      const li = b.closest<HTMLElement>('.cm-item')!;
      const open = li.querySelector('.cm-rp'); if (open) { open.remove(); return; }
      const f = document.createElement('form'); f.className = 'cm-rp';
      f.innerHTML = `<fieldset><legend>¿Por qué reportas este comentario?</legend>${REPORT_REASONS.map((r, i) => `<label><input type="radio" name="rp-${li.dataset.id}" value="${r.id}"${i ? '' : ' required'} /> ${r.name}</label>`).join('')}</fieldset><div class="cm-rp-acts"><button type="submit" class="cm-rp-send">Enviar reporte</button><button type="button" data-rp-cancel>Cancelar</button></div><p class="cm-rp-note">Lo revisa nuestro sistema al instante. Los reportes falsos le restan peso a tus próximos reportes.</p>`;
      li.querySelector('.cm-body')!.append(f);
      f.querySelector('[data-rp-cancel]')!.addEventListener('click', () => f.remove());
      f.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const reason = (f.querySelector('input:checked') as HTMLInputElement | null)?.value; if (!reason) return;
        const cid = li.dataset.id!; const rid = `${sid}:${cid}`;
        const prev = getReports().find((x) => x.id === rid);
        const reasons = [...new Set([...(prev?.reasons ?? []), reason])];
        const cnt = (prev?.count ?? 0) + 1;
        const my = myReports();
        const { action, a } = judgeReport(textOf(li), reasons, cnt, isWeakReporter(my));
        const status: Report['status'] = action === 'hide' ? 'auto' : action === 'review' || prev?.status === 'review' ? 'review' : 'kept';
        upsertReport({ id: rid, at: Date.now(), storyId: sid, storyUrl: `${location.pathname}#comentarios`, title: document.querySelector('h1')?.textContent?.trim() || document.title,
          commentId: cid, author: li.querySelector('b')?.textContent || '', text: textOf(li), media: li.querySelector<HTMLImageElement>('.cm-media')?.getAttribute('src') || undefined,
          mine: li.classList.contains('mine'), source: 'report', reasons, count: cnt, score: a.score, flags: a.reasons, status });
        my.ids = [...my.ids, rid].slice(-200); if (status === 'kept') my.wrong++; saveMyReports(my);
        const msg = document.createElement('p'); msg.className = `cm-rp-done ${status}`; msg.setAttribute('role', 'status');
        msg.textContent = status === 'auto' ? 'Gracias. Lo ocultamos de inmediato: incumple las reglas.'
          : status === 'review' ? 'Gracias. La redacción lo revisará pronto.'
          : 'Gracias. Lo revisamos y no parece incumplir las reglas, así que se queda publicado.';
        f.replaceWith(msg); setTimeout(() => msg.remove(), 6000);
        applyMod();
      });
    });

    // "Tu nivel" panel: level, points and what's missing for the next badge
    const paintRep = () => {
      const r = getRep(); const lv = levelOf(r);
      root.querySelector('[data-rep-level]')!.textContent = lv.name;
      root.querySelector('[data-rep-pts]')!.textContent = r.points.toLocaleString('es-PR');
      root.querySelector('[data-rep-next]')!.textContent = lv.next ? `Para llegar a ${lv.next.name} necesitas:` : '¡Eres Diamante! Mantén cero reportes para conservarlo.';
      root.querySelector('[data-rep-needs]')!.innerHTML = lv.next ? needs(r, lv.next).map((n) => `<li class="${n.have >= n.need ? 'ok' : ''}"><span>${n.have >= n.need ? '✓' : '○'} ${n.label}</span><b>${Math.min(n.have, n.need).toLocaleString('es-PR')}/${n.need.toLocaleString('es-PR')}</b></li>`).join('') : '';
      const got = specialsOf(r);
      root.querySelectorAll<HTMLElement>('[data-special]').forEach((li) => li.classList.toggle('won', !!got[li.dataset.special!]));
    };
    paintRep(); addEventListener('nx-rep', paintRep);

    list.querySelectorAll<HTMLElement>('.cm-item').forEach(wireLike);
    const pk = setupPicker(root);
    let media: Mine['media']; addEventListener('nx-media', () => (media = pk.media()));
    const setMedia = (m: Mine['media']) => { pk.setMedia(m); media = m; };
    const closePicker = pk.close;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = ta.value.trim();
      if (!text && !media) { err.textContent = 'Escribe algo o escoge un sticker o GIF.'; err.hidden = false; return; }
      // Automatic check before posting: clear violations are blocked; doubtful ones get one warning, then go to the queue
      const chk = assess(text);
      const why = chk.reasons.join(', ').toLowerCase();
      if (chk.verdict === 'block') { err.textContent = `No se puede publicar: ${why}. Revisa el texto.`; err.hidden = false; return; }
      if (chk.verdict === 'review' && warned !== text) { warned = text; err.textContent = `Ojo: ${why}. Edítalo, o pulsa Publicar otra vez y la redacción lo revisará.`; err.hidden = false; return; }
      const mine = store.get<Mine[]>(key, []);
      const id = `m${Date.now()}`;
      mine.push({ id, name: myName, text, at: Date.now(), replyTo, media });
      store.set(key, mine);
      const before = getRep(); const lvBefore = levelOf(before).index; const spBefore = specialsOf(before);
      const res = addComment(id, text, !!replyTo);
      if (chk.verdict === 'review') upsertReport({ id: `${sid}:${id}`, at: Date.now(), storyId: sid, storyUrl: `${location.pathname}#comentarios`, title: document.querySelector('h1')?.textContent?.trim() || document.title,
        commentId: id, author: myName, text, media: media?.src, mine: true, source: 'post', reasons: [], count: 0, score: chk.score, flags: chk.reasons, status: 'review' });
      warned = '';
      // Notifications: a new level or special badge (real), and an example like from another reader (preview)
      const after = getRep(); const lvAfter = levelOf(after); const spAfter = specialsOf(after);
      const here = `${location.pathname}#comentarios`;
      if (lvAfter.index > lvBefore) notify({ id: `lv-${lvAfter.id}`, kind: 'badge', text: `¡Subiste a ${lvAfter.name}! Ya aparece junto a tu nombre en los comentarios.`, url: here });
      SPECIALS.forEach((x) => { if (spAfter[x.id] && !spBefore[x.id]) notify({ id: `sp-${x.id}`, kind: 'badge', text: `Ganaste la insignia ${x.name}: ${x.means.toLowerCase()}`, url: here }); });
      const fan = [...list.querySelectorAll('.cm-item:not(.mine) b')].map((b) => b.textContent).filter(Boolean)[0] || 'lectora_bayamon';
      setTimeout(() => notify({ id: `like-${id}`, kind: 'like', who: fan!, text: 'le gustó tu comentario.', quote: text.slice(0, 80) || 'Sticker', url: here, demo: true }), 6000);
      const note = root.querySelector<HTMLElement>('[data-cm-repnote]')!;
      note.textContent = res.pts ? `⭐ ${res.why}` : res.why; note.className = `cm-repnote ${res.pts ? 'ok' : ''}`; note.hidden = false;
      if (chk.verdict === 'review') note.textContent += ' · La redacción revisará este comentario.';
      ta.value = ''; ta.style.height = 'auto'; replyTo = undefined; setMedia(undefined); closePicker();
      render();
    });
    render();
  });

  // ---------- Real comments (Supabase, supabase/comments.sql): everyone sees the same ones ----------
  type Row = { id: string; parent: string | null; body: string; media: Mine['media'] | null; status: 'visible' | 'review' | 'removed'; likes: number; created_at: string;
    user_id: string; author: { username: string; photo: string | null } | null };
  const COLORS = ['#2B1185', '#1F90DA', '#B0306A', '#0F8C8C', '#C8202F', '#5C3D99', '#2E7D32', '#E8590C'];
  const colorOf = (name: string) => COLORS[[...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7) % COLORS.length];
  const HEART = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1 8.3 3.2 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.8 0 6 3.8 4.5 7.3C19.5 16.4 12 21 12 21z" /></svg>';

  function live(root: HTMLElement) {
    const sid = root.dataset.comments!;
    const list = root.querySelector<HTMLUListElement>('[data-cm-list]')!;
    const form = root.querySelector<HTMLFormElement>('[data-cm-form]')!;
    const ta = form.querySelector('textarea')!;
    const err = root.querySelector<HTMLElement>('[data-cm-err]')!;
    const count = root.querySelector<HTMLElement>('[data-cm-count]')!;
    const meAv = root.querySelector<HTMLElement>('[data-cm-me]')!;
    // Real mode: no examples, no "preview" labels; the reputation panel comes back with accounts' points (phase 2)
    list.replaceChildren();
    root.querySelector('.cm-head .sp-demo')?.remove();
    root.querySelector<HTMLElement>('[data-cm-rep]')!.hidden = true;
    const note = root.querySelector<HTMLElement>('.cm-note')!;
    const pk = setupPicker(root);
    let rows: Row[] = [], liked = new Set<string>(), reported = new Set<string>(), parentId: string | null = null, warned = '';

    const avatar = (el: HTMLElement, name: string, photo?: string | null) => {
      el.textContent = photo ? '' : (name[0] || '?').toUpperCase();
      el.style.backgroundImage = photo ? `url("${photo}")` : ''; el.style.background = photo ? '' : colorOf(name);
      if (photo) el.style.backgroundImage = `url("${photo}")`;
      el.classList.toggle('has-photo', !!photo);
    };
    const paintMe = () => {
      let p: { name?: string; photo?: string } = {}; try { p = JSON.parse(localStorage.getItem('nx-profile') || '{}'); } catch { /* storage blocked */ }
      if (loggedIn() && p.name) avatar(meAv, p.name, p.photo); else { meAv.textContent = '?'; meAv.style.cssText = ''; }
      ta.placeholder = loggedIn() ? 'Añade un comentario…' : 'Entra a tu cuenta para comentar…';
      note.innerHTML = loggedIn() ? `Comentas como <b></b>. Sé respetuoso: los comentarios con insultos, amenazas o datos personales se ocultan.` : 'Lee los comentarios de todos. Para comentar, dar Me gusta o reportar, <button type="button" class="cm-login">entra o crea tu cuenta</button>.';
      note.querySelector('b') && (note.querySelector('b')!.textContent = `@${p.name ?? ''}`);
      note.querySelector('.cm-login')?.addEventListener('click', () => askLogin('Entra para comentar.'));
    };
    const need = (why: string) => { if (loggedIn()) return true; askLogin(why); return false; };

    async function load() {
      const r = await api(`comments?story=eq.${encodeURIComponent(sid)}&select=id,parent,body,media,status,likes,created_at,user_id,author:profiles(username,photo)&order=created_at.asc&limit=400`, {}, false);
      rows = r?.ok ? await r.json() : [];
      // Logged in: also my own comments under review (the public read above only returns visible ones)
      if (loggedIn()) {
        const mine = await api(`comments?story=eq.${encodeURIComponent(sid)}&user_id=eq.${myId()}&status=neq.visible&select=id,parent,body,media,status,likes,created_at,user_id,author:profiles(username,photo)`);
        if (mine?.ok) rows = [...rows, ...(await mine.json())].sort((a, b) => Date.parse(a.created_at) - Date.parse(b.created_at));
        const ids = rows.map((x) => x.id);
        if (ids.length) {
          const [lk, rp] = await Promise.all([
            api(`comment_likes?user_id=eq.${myId()}&comment=in.(${ids.join(',')})&select=comment`),
            api(`comment_reports?user_id=eq.${myId()}&comment=in.(${ids.join(',')})&select=comment`),
          ]);
          liked = new Set(lk?.ok ? (await lk.json()).map((x: any) => x.comment) : []);
          reported = new Set(rp?.ok ? (await rp.json()).map((x: any) => x.comment) : []);
        }
      } else { liked = new Set(); reported = new Set(); }
      render();
    }

    function item(c: Row): HTMLLIElement {
      const name = c.author?.username ?? 'lector';
      const mine = c.user_id === myId();
      const li = document.createElement('li');
      li.className = `cm-item${c.parent ? ' reply' : ''}${mine ? ' mine' : ''}`; li.dataset.id = c.id;
      li.innerHTML = `<span class="cm-av" aria-hidden="true"></span><div class="cm-body"><p><b></b> <span class="cm-text"></span></p><div class="cm-meta"><span></span><span data-likes-label></span><button type="button" data-reply>Responder</button>${mine ? '<button type="button" data-del>Borrar</button>' : `<button type="button" data-report${reported.has(c.id) ? ' disabled' : ''}>${reported.has(c.id) ? 'Reportado' : 'Reportar'}</button>`}</div></div><button type="button" class="cm-like" data-like aria-pressed="${liked.has(c.id)}" aria-label="Me gusta">${HEART}<span class="cm-like-n" data-like-n></span></button>`;
      avatar(li.querySelector<HTMLElement>('.cm-av')!, name, c.author?.photo);
      li.querySelector('b')!.textContent = name;
      fillText(li.querySelector('.cm-text')!, c.body);
      if (c.media) { const im = document.createElement('img'); im.className = 'cm-media'; im.src = c.media.src; im.alt = c.media.kind === 'gif' ? 'GIF' : 'Sticker'; im.loading = 'lazy'; li.querySelector('.cm-body p')!.after(im); }
      li.querySelector('.cm-meta span')!.textContent = ago(Date.parse(c.created_at));
      const n = c.likes; li.querySelector('[data-likes-label]')!.textContent = n ? `${n} Me gusta` : ''; li.querySelector('[data-like-n]')!.textContent = n ? String(n) : '';
      if (c.status !== 'visible') {
        const hn = document.createElement('p'); hn.className = 'cm-hid-note';
        hn.textContent = c.status === 'review' ? 'Solo tú ves este comentario mientras la redacción lo revisa.' : 'La redacción quitó este comentario por incumplir las reglas. Solo tú lo ves.';
        li.querySelector('.cm-body')!.prepend(hn); li.classList.add('cm-hidden');
      }
      return li;
    }
    function render() {
      const top = rows.filter((c) => !c.parent).reverse(); // newest first; replies under their comment, oldest first
      list.replaceChildren(...top.flatMap((c) => [item(c), ...rows.filter((x) => x.parent === c.id).map(item)]));
      const n = rows.filter((c) => c.status === 'visible').length;
      count.textContent = n ? `(${n})` : '';
      if (!rows.length) { const e = document.createElement('li'); e.className = 'cm-empty'; e.textContent = 'Sé la primera persona en comentar.'; list.append(e); }
    }

    list.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement; const li = t.closest<HTMLElement>('.cm-item'); if (!li) return;
      const c = rows.find((x) => x.id === li.dataset.id)!;
      if (t.closest('[data-like]')) {
        if (!need('Entra para dar Me gusta.')) return;
        const on = !liked.has(c.id);
        on ? liked.add(c.id) : liked.delete(c.id); c.likes = Math.max(0, c.likes + (on ? 1 : -1)); // right away; the server keeps the real count
        const fresh = item(c); li.replaceWith(fresh);
        if (on) { const b = fresh.querySelector('[data-like]')!; b.classList.add('pop'); }
        const r = on ? await api('comment_likes', { method: 'POST', body: JSON.stringify({ comment: c.id }) })
          : await api(`comment_likes?comment=eq.${c.id}&user_id=eq.${myId()}`, { method: 'DELETE' });
        if (!r?.ok && r?.status !== 409) void load();
      }
      if (t.closest('[data-reply]')) {
        if (!need('Entra para responder.')) return;
        parentId = c.parent ?? c.id; // one level of replies, like Instagram
        ta.value = `@${c.author?.username ?? ''} `; ta.focus();
      }
      if (t.closest('[data-del]')) {
        const { ask } = await import('../lib/dialogs');
        if (!(await ask('¿Borrar tu comentario?', { ok: 'Borrar', danger: true }))) return;
        const r = await api(`comments?id=eq.${c.id}`, { method: 'DELETE' });
        if (r?.ok) { rows = rows.filter((x) => x.id !== c.id && x.parent !== c.id); render(); }
      }
      const rb = t.closest<HTMLButtonElement>('[data-report]');
      if (rb && !rb.disabled) {
        if (!need('Entra para reportar un comentario.')) return;
        const open = li.querySelector('.cm-rp'); if (open) { open.remove(); return; }
        const f = document.createElement('form'); f.className = 'cm-rp';
        f.innerHTML = `<fieldset><legend>¿Por qué reportas este comentario?</legend>${REPORT_REASONS.map((r, i) => `<label><input type="radio" name="rp-${c.id}" value="${r.id}"${i ? '' : ' required'} /> ${r.name}</label>`).join('')}</fieldset><div class="cm-rp-acts"><button type="submit" class="cm-rp-send">Enviar reporte</button><button type="button" data-rp-cancel>Cancelar</button></div><p class="cm-rp-note">Si varios lectores lo reportan, se oculta hasta que la redacción lo revise.</p>`;
        li.querySelector('.cm-body')!.append(f);
        f.querySelector('[data-rp-cancel]')!.addEventListener('click', () => f.remove());
        f.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const reason = (f.querySelector('input:checked') as HTMLInputElement | null)?.value; if (!reason) return;
          const r = await api('comment_reports', { method: 'POST', body: JSON.stringify({ comment: c.id, reason }) });
          const msg = document.createElement('p'); msg.className = 'cm-rp-done review'; msg.setAttribute('role', 'status');
          msg.textContent = r?.ok || r?.status === 409 ? 'Gracias. La redacción lo verá; si más lectores lo reportan, se oculta enseguida.' : 'No se pudo enviar. Intenta otra vez.';
          f.replaceWith(msg); setTimeout(() => msg.remove(), 6000);
          if (r?.ok || r?.status === 409) { reported.add(c.id); const b = li.querySelector<HTMLButtonElement>('[data-report]'); if (b) { b.textContent = 'Reportado'; b.disabled = true; } }
        });
      }
    });

    ta.addEventListener('focus', () => { if (!loggedIn()) { ta.blur(); askLogin('Entra para comentar.'); } });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!need('Entra para comentar.')) return;
      const text = ta.value.trim(); const media = pk.media();
      if (!text && !media) { err.textContent = 'Escribe algo o escoge un sticker o GIF.'; err.hidden = false; return; }
      // Automatic check before posting: clear violations are blocked; doubtful ones get one warning, then go to review
      const chk = assess(text); const whyTxt = chk.reasons.join(', ').toLowerCase();
      if (chk.verdict === 'block') { err.textContent = `No se puede publicar: ${whyTxt}. Revisa el texto.`; err.hidden = false; return; }
      if (chk.verdict === 'review' && warned !== text) { warned = text; err.textContent = `Ojo: ${whyTxt}. Edítalo, o pulsa Publicar otra vez y la redacción lo revisará.`; err.hidden = false; return; }
      if (parentId && !text.startsWith('@')) parentId = null; // the reader erased the @name: it's a new comment
      const send = form.querySelector<HTMLButtonElement>('.cm-send')!; send.disabled = true;
      const r = await api('comments', { method: 'POST', body: JSON.stringify({ story: sid, url: `${location.pathname}#comentarios`, parent: parentId, body: text, media: media ?? null,
        status: chk.verdict === 'review' ? 'review' : 'visible', flags: chk.reasons }) });
      send.disabled = false;
      if (!r?.ok) { err.textContent = r?.status === 403 ? 'Tu cuenta no puede comentar ahora mismo.' : 'No se pudo publicar. Intenta otra vez.'; err.hidden = false; return; }
      warned = ''; ta.value = ''; ta.style.height = 'auto'; parentId = null; pk.setMedia(undefined); pk.close();
      if (chk.verdict === 'review') { err.textContent = 'Publicado. La redacción lo revisará antes de que otros lo vean.'; err.hidden = false; }
      await load();
    });
    addEventListener('nx-account', () => { paintMe(); void load(); });
    addEventListener('nx-profile-change', paintMe);
    paintMe(); void load();
  }
</script>
