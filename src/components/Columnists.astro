---
// "Nuestros columnistas" on the Opinión page. Columnists are listed in src/data/columnistas.json:
//   { "name": "Nombre Apellido", "role": "Columnista", "bio": "Una oración.", "photo": "images/columnistas/nombre.jpg" }
// "demo": true marks a sample profile (not a real person); it shows an EJEMPLO tag. Delete those entries
// when real columnists join.
// A column (section: opinion) whose `author` matches a columnist's name appears under that columnist.
import data from '../data/columnistas.json';
import { url, SITE, type Story } from '../lib/site';
interface Props { stories: Story[] }
const { stories } = Astro.props;
type Columnist = { name: string; role?: string; bio?: string; photo?: string; demo?: boolean };
const list = data as Columnist[];
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const latest = (n: string) => stories.find((s) => s.data.section === 'opinion' && s.data.author === n);
---
<section class="col-box" aria-labelledby="col-h">
  <h2 id="col-h" class="col-h">Nuestros columnistas</h2>
  <div class="col-grid">
    {list.map((c) => {
      const last = latest(c.name);
      return (
        <article class="col-card">
          {c.photo ? <img class="col-pic" src={url(c.photo)} alt="" /> : <span class="col-pic col-ini" aria-hidden="true">{initials(c.name)}</span>}
          <div>
            <h3>{c.name}{c.demo && <span class="sp-demo">EJEMPLO</span>}</h3>
            {c.role && <span class="col-role">{c.role}</span>}
            {c.bio && <p>{c.bio}</p>}
            {last ? <a class="col-last" href={url(`noticia/${last.id}`)}>{last.data.title}</a>
              : <span class="col-soon">{c.demo ? 'Perfil de ejemplo: este espacio será para un columnista real.' : 'Próximamente su primera columna.'}</span>}
          </div>
        </article>
      );
    })}
    <a class="col-card col-foro" href={url('foro')}>
      <span class="col-pic col-ini" aria-hidden="true">💬</span>
      <div>
        <h3>Foro Xtra</h3>
        <p>¿Tienes una opinión? Abre un tema, responde a otros lectores y vota por las mejores ideas.</p>
        <span class="col-last">Entrar al foro ›</span>
      </div>
    </a>
    <article class="col-card col-join">
      <span class="col-pic col-ini" aria-hidden="true">+</span>
      <div>
        <h3>Escribe para Opinión</h3>
        <p>¿Tienes algo que decir sobre Puerto Rico? Envíanos tu columna de hasta 700 palabras, con tu nombre completo y una línea sobre ti.</p>
        {SITE.email ? <a class="col-last" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Columna para Opinión')}`}>Enviar columna</a> : <span class="col-soon">Muy pronto publicaremos el correo para enviar columnas.</span>}
      </div>
    </article>
  </div>
</section>
