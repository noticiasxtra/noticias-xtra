# Keys for "Redactar con IA" (supabase/functions/redactar-ia). Never commit real keys.
# They live in Supabase → Edge Functions → Secrets (the function reads them there), not in the website.
# ANTHROPIC_API_KEY is also a GitHub Actions secret for the automatic news script (scripts/fetch-news.mjs).

# Required: Claude API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Optional: model for the AI steps (default claude-opus-5-5)
ANTHROPIC_MODEL=
# Optional photo sources (free). Without them the photo search uses the site's library and Wikimedia Commons only.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
